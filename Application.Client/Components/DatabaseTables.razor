    [data-theme="dark"] .dbt-scope .bg-gray-100 { background: #1e222b !important; }
    [data-theme="dark"] .dbt-scope .text-gray-900 { color: #f3f4f6 !important; }
    [data-theme="dark"] .dbt-scope .text-gray-700 { color: #e6e9ef !important; }
    [data-theme="dark"] .dbt-scope .text-gray-600 { color: #c5cad4 !important; }
    [data-theme="dark"] .dbt-scope .text-gray-500 { color: #9aa1ac !important; }
    [data-theme="dark"] .dbt-scope .text-gray-400 { color: #6b7280 !important; }
