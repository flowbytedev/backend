    [data-theme="dark"] .dbt-scope select { background: #12141a !important; color: #f3f4f6 !important; border-color: #2b303b !important; }
    [data-theme="dark"] .dbt-scope .hover\:bg-gray-50:hover { background: #20242c !important; }
    [data-theme="dark"] .dbt-scope .bg-green-100 { background: rgba(34,197,94,0.15) !important; }
    [data-theme="dark"] .dbt-scope .text-green-700,
    [data-theme="dark"] .dbt-scope .text-green-800 { color: #4ade80 !important; }
    [data-theme="dark"] .dbt-scope .bg-green-50 { background: rgba(34,197,94,0.12) !important; }
    [data-theme="dark"] .dbt-scope .border-green-200 { border-color: rgba(34,197,94,0.3) !important; }
    [data-theme="dark"] .dbt-scope .bg-red-50 { background: rgba(239,68,68,0.12) !important; }
    [data-theme="dark"] .dbt-scope .border-red-200 { border-color: rgba(239,68,68,0.3) !important; }
    [data-theme="dark"] .dbt-scope .text-red-700,
    [data-theme="dark"] .dbt-scope .text-red-600 { color: #f87171 !important; }
    [data-theme="dark"] .dbt-scope .bg-amber-50 { background: rgba(245,158,11,0.12) !important; }
    [data-theme="dark"] .dbt-scope .border-amber-200 { border-color: rgba(245,158,11,0.3) !important; }
    [data-theme="dark"] .dbt-scope .text-amber-800 { color: #fcd34d !important; }
    [data-theme="dark"] .dbt-scope .bg-indigo-100 { background: rgba(99,102,241,0.18) !important; }
    [data-theme="dark"] .dbt-scope .text-indigo-700 { color: #c7d2fe !important; }
    [data-theme="dark"] .dbt-scope .text-indigo-600 { color: #a5b4fc !important; }
    [data-theme="dark"] .dbt-scope .hover\:text-indigo-900:hover { color: #c7d2fe !important; }
