    /// <summary>
    /// One column of a generic row grid. <paramref name="Options"/> makes it a dropdown;
    /// <paramref name="FromColumns"/> makes it a dropdown of the incoming columns.
    /// </summary>
    private sealed record GridColumn(
        string Field,
        string Label,
        string? Placeholder = null,
        IReadOnlyList<string>? Options = null,
        bool FromColumns = false,
        bool Optional = false);

    /// <summary>
    /// A grid of object rows, driven by a spec.
    /// <para>
    /// Generic rather than one hand-written editor per step. The existing map/aggregate/join editors are
    /// each ~60 lines of RenderTreeBuilder, and three more of those for sort, window and text cleanup would
    /// be three more places for an off-by-one in the sequence numbers to hide.
    /// </para>
    /// </summary>
    private RenderFragment RowGridEditor(
        string key, string rowClass, string addLabel,
        IReadOnlyList<GridColumn> spec, JsonObject template) => builder =>
    {
        var rows = Config()[key] as JsonArray ?? new JsonArray();
        var known = _upstreamColumns.Select(c => c.Name).ToList();
        var seq = 0;

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", $"pl-row-head {rowClass}");
        foreach (var column in spec)
        {
            builder.OpenElement(seq++, "span");
            builder.AddContent(seq++, column.Label);
            builder.CloseElement();
        }
        builder.OpenElement(seq++, "span");
        builder.CloseElement();
        builder.CloseElement();

        for (var i = 0; i < rows.Count; i++)
        {
            var index = i;
            var row = rows[index] as JsonObject ?? new JsonObject();

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", rowClass);
            builder.SetKey(index);

            foreach (var column in spec)
            {
                var field = column.Field;
                var current = row[field]?.ToString();

                if (column.Options is not null || column.FromColumns)
                {
                    builder.OpenElement(seq++, "select");
                    builder.AddAttribute(seq++, "class", "select");
                    builder.AddAttribute(seq++, "onchange",
                        EventCallback.Factory.Create<ChangeEventArgs>(this,
                            e => SetArrayField(key, index, field, e.Value?.ToString())));

                    // An optional column needs an explicit empty choice, or there is no way back to
                    // "not set" once something has been picked.
                    if (column.Optional || column.FromColumns)
                    {
                        builder.OpenElement(seq++, "option");
                        builder.AddAttribute(seq++, "value", string.Empty);
                        builder.AddAttribute(seq++, "selected", string.IsNullOrEmpty(current));
                        builder.AddContent(seq++, column.FromColumns ? "Choose…" : "—");
                        builder.CloseElement();
                    }

                    foreach (var option in column.Options ?? known)
                    {
                        builder.OpenElement(seq++, "option");
                        builder.AddAttribute(seq++, "value", option);
                        builder.AddAttribute(seq++, "selected", current == option);
                        builder.AddContent(seq++, option);
                        builder.CloseElement();
                    }

                    builder.CloseElement();
                }
                else
                {
                    builder.OpenElement(seq++, "input");
                    builder.AddAttribute(seq++, "class", "input input-mono");
                    if (column.Placeholder is not null)
                        builder.AddAttribute(seq++, "placeholder", column.Placeholder);
                    builder.AddAttribute(seq++, "value", current);
                    builder.AddAttribute(seq++, "onchange",
                        EventCallback.Factory.Create<ChangeEventArgs>(this,
                            e => SetArrayField(key, index, field, e.Value?.ToString())));
                    builder.CloseElement();
                }
            }

            builder.AddContent(seq++, DeleteButton(() => RemoveArrayRow(key, index)));
            builder.CloseElement();
        }

        builder.AddContent(seq++, AddRowButton(addLabel, () => AddArrayRow(key, template.DeepClone().AsObject())));
    };

