    // ---------------- structured-editor mutations ----------------

    private static readonly string[] CastTypes =
    [
        "VARCHAR", "INTEGER", "BIGINT", "DOUBLE", "DECIMAL", "BOOLEAN", "DATE", "TIMESTAMP", "TIME"
    ];

    private JsonObject Obj(string key)
    {
        if (Config()[key] is JsonObject existing) return existing;
        var created = new JsonObject();
        Config()[key] = created;
        return created;
    }

    private JsonArray Arr(string key)
    {
        if (Config()[key] is JsonArray existing) return existing;
        var created = new JsonArray();
        Config()[key] = created;
        return created;
    }

    private async Task AddMapRow(string key)
    {
        var map = Obj(key);
        var name = "column";
        for (var n = 1; map.ContainsKey(name); n++) name = $"column{n + 1}";
        map[name] = new JsonObject { ["source"] = string.Empty };
        await Notify($"{Node!.Id}:{key}:add");
    }

    /// <summary>
    /// Maps every incoming column straight through, keeping whatever the author already customised. Only
    /// unmapped columns are added, so clicking this twice is harmless.
    /// </summary>
    private async Task MapAll(string key)
    {
        var map = Obj(key);
        var alreadyMapped = map
            .Select(kv => (kv.Value as JsonObject)?["source"]?.ToString())
            .Where(s => s is not null)
            .ToHashSet(StringComparer.OrdinalIgnoreCase)!;

        foreach (var column in _upstreamColumns)
        {
            if (alreadyMapped.Contains(column.Name) || map.ContainsKey(column.Name)) continue;
            map[column.Name] = new JsonObject { ["source"] = column.Name };
        }

        await Notify($"{Node!.Id}:{key}:mapall");
    }

    private async Task SetMapField(string key, string row, string field, string? value)
    {
        var map = Obj(key);
        if (map[row] is not JsonObject spec) map[row] = spec = new JsonObject();

        if (string.IsNullOrEmpty(value)) spec.Remove(field);
        else spec[field] = value;

        await Notify($"{Node!.Id}:{key}:{row}:{field}");
    }

    private async Task RenameMapRow(string key, string from, string? to) =>
        await RenameObjectKey(key, from, to);

    private async Task RemoveMapRow(string key, string row) => await RemoveObjectKey(key, row);

    private async Task ToggleColumn(string key, string column)
    {
        var current = StringList(key);
        if (current.RemoveAll(c => string.Equals(c, column, StringComparison.OrdinalIgnoreCase)) == 0)
            current.Add(column);

        await SetStringList(key, current);
    }

    private async Task SetStringList(string key, IEnumerable<string> values)
    {
        var array = new JsonArray();
        foreach (var value in values) array.Add(value);
        Config()[key] = array;
        await Notify($"{Node!.Id}:{key}:list");
    }

    private async Task AddObjectKey(string key, string name)
    {
        var map = Obj(key);
        var candidate = name;
        for (var n = 1; map.ContainsKey(candidate); n++) candidate = $"{name}{n + 1}";
        map[candidate] = string.Empty;
        await Notify($"{Node!.Id}:{key}:add");
    }

    /// <summary>
    /// Renames a key while preserving insertion order. Rebuilding the object is deliberate: assigning a new
    /// key and removing the old one would move the row to the bottom of the grid mid-edit.
    /// </summary>
    private async Task RenameObjectKey(string key, string from, string? to)
    {
        if (string.IsNullOrWhiteSpace(to) || to == from) return;

        var map = Obj(key);
        if (!map.ContainsKey(from) || map.ContainsKey(to)) return;

        var rebuilt = new JsonObject();
        foreach (var entry in map.Select(kv => kv.Key).ToList())
        {
            var value = map[entry];
            map[entry] = null;                     // detach, so the node can be re-parented
            rebuilt[entry == from ? to! : entry] = value;
        }

        Config()[key] = rebuilt;
        await Notify($"{Node!.Id}:{key}:rename");
    }

    private async Task SetObjectValue(string key, string name, string? value)
    {
        Obj(key)[name] = value ?? string.Empty;
        await Notify($"{Node!.Id}:{key}:{name}");
    }

    private async Task RemoveObjectKey(string key, string name)
    {
        Obj(key).Remove(name);
        await Notify($"{Node!.Id}:{key}:remove");
    }

    private async Task AddArrayRow(string key, JsonObject row)
    {
        Arr(key).Add(row);
        await Notify($"{Node!.Id}:{key}:add");
    }

    /// <summary>
    /// Appends a plain string to a list field. Separate from <see cref="AddArrayRow"/> because a name list
    /// holds strings, not objects — loosening that method to take JsonNode would let an object row into a
    /// string list, which fails later and further away.
    /// </summary>
    private async Task AddStringArrayItem(string key, string value)
    {
        Arr(key).Add(JsonValue.Create(value));
        await Notify($"{Node!.Id}:{key}:add");
    }

    private async Task SetStringArrayItem(string key, int index, string? value)
    {
        var array = Arr(key);
        while (array.Count <= index) array.Add(JsonValue.Create(string.Empty));
        array[index] = JsonValue.Create(value ?? string.Empty);
        await Notify($"{Node!.Id}:{key}:{index}");
    }

    private async Task RemoveArrayRow(string key, int index)
    {
        var array = Arr(key);
        if (index >= 0 && index < array.Count) array.RemoveAt(index);
        await Notify($"{Node!.Id}:{key}:remove");
    }

    private async Task SetArrayField(string key, int index, string field, string? value)
    {
        var array = Arr(key);
        if (index < 0 || index >= array.Count) return;
        if (array[index] is not JsonObject row) array[index] = row = new JsonObject();

        row[field] = value ?? string.Empty;
        await Notify($"{Node!.Id}:{key}:{index}:{field}");
    }
}
