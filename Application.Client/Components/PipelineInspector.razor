@*
    The step settings panel.

    EVERY field is rendered from the catalogue's PipelineFieldSpec. There is no per-step-type form anywhere in
    this project, and there must not be: adding a step type is a catalogue entry plus an executor, with no
    Razor change at all. If you find yourself adding `if (Node.Type == ...)` markup here, add a field kind
    instead.

    The structured editors (column map, join keys, aggregates) are the exception that proves the rule — they
    are generic controls driven by a kind, not by a type.
*@
@using System.Text.Json.Nodes
@using Application.Shared.Models.Data.Pipelines
@using Application.Shared.Services.Data.Pipelines

<div class="pl-panel pl-panel--right">
    <div class="pl-panel-head">
        <span class="pl-panel-title">@(Node is null ? "Pipeline" : "Step")</span>
    </div>

    <div class="pl-panel-body">
        @if (Node is null)
        {
            @* Nothing selected: the pipeline's own settings. *@
            <div class="field">
                <label class="field-label">Name</label>
                <input class="input" value="@Name"
                       @oninput="e => OnNameChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)" />
            </div>

            <div class="field">
                <label class="field-label">Description</label>
                <textarea class="textarea" style="min-height:56px;" value="@Description"
                          @oninput="e => OnDescriptionChanged.InvokeAsync(e.Value?.ToString())"></textarea>
            </div>

            <details class="pl-group" open>
                <summary>Triggers</summary>
                <div class="pl-group-body">
                    <label class="switch-row">
                        <span class="switch @(IsEnabled ? "is-on" : "")"
                              @onclick="() => OnEnabledChanged.InvokeAsync(!IsEnabled)"></span>
                        <span class="switch-label">Enabled</span>
                    </label>

                    <label class="switch-row">
                        <span class="switch @(ApiEnabled ? "is-on" : "")"
                              @onclick="() => OnApiEnabledChanged.InvokeAsync(!ApiEnabled)"></span>
                        <span class="switch-label">Can be started over the API</span>
                    </label>

                    <div class="field">
                        <label class="field-label">Schedule</label>
                        <input class="input input-mono" placeholder="0 3 * * *" value="@Cron"
                               @oninput="e => OnCronChanged.InvokeAsync(e.Value?.ToString())" />
                        <div class="field-help">
                            Five fields. Leave empty to run it only by hand.
                        </div>
                    </div>

                    @if (RequiresManualRun)
                    {
                        @* The compiler refuses this combination at save time; saying so here means the author
                           finds out while editing rather than from a rejected save. *@
                        <div class="field-error">
                            A step reads a file you upload at run time, so this pipeline cannot be scheduled
                            or triggered by API. Point that step at a folder or blob storage instead.
                        </div>
                    }
                </div>
            </details>

            <details class="pl-group">
                <summary>Limits</summary>
                <div class="pl-group-body">
                    <div class="field">
                        <label class="field-label">Run timeout (seconds)</label>
                        <input class="input" type="number" value="@Settings.TimeoutSeconds"
                               @onchange="e => SetTimeout(e.Value?.ToString())" />
                    </div>

                    <label class="switch-row">
                        <span class="switch @(Settings.FailOnEmptySource ? "is-on" : "")"
                              @onclick="ToggleFailOnEmpty"></span>
                        <span class="switch-label">Fail if a source returns no rows</span>
                    </label>
                </div>
            </details>
        }
        else if (_spec is null)
        {
            <div class="pl-inspector-empty">
                This step has type <code>@Node.Type</code>, which this version of FlowByte does not know.
            </div>
        }
        else
        {
            <div class="field">
                <label class="field-label">Name</label>
                <input class="input" value="@Node.Label"
                       @oninput="e => SetLabel(e.Value?.ToString())" />
                <div class="field-help">
                    <span style="font-family:var(--font-mono);">@Node.Id</span> · @_spec.Label
                </div>
            </div>

            @foreach (var field in _spec.Fields)
            {
                if (!IsVisible(field)) continue;

                <div class="field" @key="field.Key">
                    <label class="field-label">
                        @field.Label
                        @if (field.Required)
                        {
                            <span style="color:var(--danger);"> *</span>
                        }
                    </label>

                    @switch (field.Kind)
                    {
                        case PipelineFieldKinds.Text:
                        case PipelineFieldKinds.FilePath:
                            <input class="input @(field.Kind == PipelineFieldKinds.FilePath ? "input-mono" : "")"
                                   placeholder="@field.Placeholder"
                                   value="@Str(field.Key)"
                                   @oninput="e => SetString(field.Key, e.Value?.ToString())" />
                            break;

                        case PipelineFieldKinds.TextArea:
                            <textarea class="textarea" placeholder="@field.Placeholder"
                                      value="@Str(field.Key)"
                                      @oninput="e => SetString(field.Key, e.Value?.ToString())"></textarea>
                            break;

                        case PipelineFieldKinds.Sql:
                            @* No Monaco here: the inspector is 320px wide and a code editor in it would be
                               worse than a mono textarea. The YAML tab is where real editing happens. *@
                            <textarea class="textarea textarea-mono" style="min-height:110px;"
                                      placeholder="@field.Placeholder"
                                      value="@Str(field.Key)"
                                      @oninput="e => SetString(field.Key, e.Value?.ToString())"></textarea>
                            break;

                        case PipelineFieldKinds.Number:
                            <input class="input" type="number" value="@Str(field.Key)"
                                   @onchange="e => SetNumber(field.Key, e.Value?.ToString())" />
                            break;

                        case PipelineFieldKinds.Checkbox:
                            <label class="switch-row">
                                <span class="switch @(Bool(field.Key) ? "is-on" : "")"
                                      @onclick="() => SetBool(field.Key, !Bool(field.Key))"></span>
                                <span class="switch-label">@field.Label</span>
                            </label>
                            break;

                        case PipelineFieldKinds.Select:
                            @* The shared select, with `selected` on each option: `value` is not a reflected
                               attribute on <select>, so without this the chosen value never sticks. *@
                            <select class="select" @onchange="e => SetString(field.Key, e.Value?.ToString())">
                                <option value="" selected="@(string.IsNullOrEmpty(Str(field.Key)))">
                                    Choose…
                                </option>
                                @foreach (var option in field.Options ?? [])
                                {
                                    <option value="@option.Value" selected="@(Str(field.Key) == option.Value)">
                                        @option.Label
                                    </option>
                                }
                            </select>
                            break;

                        case PipelineFieldKinds.DatasetPicker:
                            <select class="select" @onchange="e => SetString(field.Key, e.Value?.ToString())">
                                <option value="">Choose a dataset…</option>
                                @foreach (var option in Datasets)
                                {
                                    <option value="@option.Value" selected="@(Str(field.Key) == option.Value)">
                                        @option.Label
                                    </option>
                                }
                            </select>
                            @if (Datasets.Count == 0)
                            {
                                <div class="field-help">Nothing to choose from — create a dataset first.</div>
                            }
                            break;

                        case PipelineFieldKinds.ConnectionPicker:
                            <select class="select" @onchange="e => SetString(field.Key, e.Value?.ToString())">
                                <option value="">Choose a connection…</option>
                                @foreach (var option in Connections)
                                {
                                    <option value="@option.Value" selected="@(Str(field.Key) == option.Value)">
                                        @option.Label
                                    </option>
                                }
                            </select>
                            @if (Connections.Count == 0)
                            {
                                <div class="field-help">
                                    No database connections are configured for this company.
                                </div>
                            }
                            break;

                        case PipelineFieldKinds.ApiCredentialPicker:
                            <select class="select" @onchange="e => SetString(field.Key, e.Value?.ToString())">
                                <option value="">Choose a credential…</option>
                                @foreach (var option in ApiCredentials)
                                {
                                    <option value="@option.Value" selected="@(Str(field.Key) == option.Value)">
                                        @option.Label
                                    </option>
                                }
                            </select>
                            @if (ApiCredentials.Count == 0)
                            {
                                <div class="field-help">
                                    No API credentials are registered. Add one under Data &rsaquo; Connections.
                                </div>
                            }
                            break;

                        case PipelineFieldKinds.TablePicker:
                            @* Depends on the dataset field, so it clears when that changes. *@
                            @if (string.IsNullOrWhiteSpace(Str(field.DependsOn ?? "dataset")))
                            {
                                <div class="field-help">Choose a dataset first.</div>
                            }
                            else if (Tables.Count == 0)
                            {
                                <input class="input input-mono" placeholder="table name"
                                       value="@Str(field.Key)"
                                       @oninput="e => SetString(field.Key, e.Value?.ToString())" />
                                <div class="field-help">That dataset has no tables yet, or they are loading.</div>
                            }
                            else
                            {
                                <select class="select" @onchange="e => SetString(field.Key, e.Value?.ToString())">
                                    <option value="">Choose a table…</option>
                                    @foreach (var table in Tables)
                                    {
                                        <option value="@table" selected="@(Str(field.Key) == table)">@table</option>
                                    }
                                </select>
                            }
                            break;

                        case PipelineFieldKinds.ColumnList:
                            @ColumnListEditor(field.Key)
                            break;

                        case PipelineFieldKinds.ColumnMap:
                            @ColumnMapEditor(field.Key)
                            break;

                        case PipelineFieldKinds.ExpressionList:
                            @ExpressionEditor(field.Key)
                            break;

                        case PipelineFieldKinds.AggregateList:
                            @AggregateEditor(field.Key)
                            break;

                        case PipelineFieldKinds.JoinKeys:
                            @JoinKeyEditor(field.Key)
                            break;

                        case PipelineFieldKinds.KeyValue:
                            @KeyValueEditor(field.Key)
                            break;

                        case PipelineFieldKinds.SwitchList:
                            @SwitchEditor(field.Key)
                            break;

                        case PipelineFieldKinds.SortList:
                            @SortEditor(field.Key)
                            break;

                        case PipelineFieldKinds.WindowList:
                            @WindowEditor(field.Key)
                            break;

                        case PipelineFieldKinds.TextOpList:
                            @TextOpEditor(field.Key)
                            break;

                        case PipelineFieldKinds.ColumnNameList:
                            @NameListEditor(field.Key)
                            break;

                        case PipelineFieldKinds.Note:
                            @* Rendered from Help alone — a note has no value to bind. *@
                            break;

                        default:
                            <input class="input" value="@Str(field.Key)"
                                   @oninput="e => SetString(field.Key, e.Value?.ToString())" />
                            break;
                    }

                    @if (field.Help is { Length: > 0 })
                    {
                        @* A note's help IS the note, so it gets the callout treatment rather than the
                           small grey caption a normal field's help gets. *@
                        <div class="@(field.Kind == PipelineFieldKinds.Note ? "pl-note" : "field-help")">
                            @field.Help
                        </div>
                    }

                    @if (field.SupportsTokens && _tokenFields.Contains(field.Kind))
                    {
                        <div class="pl-token-hint">
                            @foreach (var token in PipelineTokens.RunKeys)
                            {
                                var t = token;
                                <span class="pl-token-chip" title="Click to insert"
                                      @onclick="() => AppendToken(field.Key, t)">@("{{ " + t + " }}")</span>
                            }
                        </div>
                    }
                </div>
            }

            <details class="pl-group">
                <summary>Advanced</summary>
                <div class="pl-group-body">
                    <div class="field">
                        <label class="field-label">If this step fails</label>
                        <select class="select" @onchange="OnErrorModeChanged">
                            <option value="" selected="@(Node.OnError is null)">Use the pipeline setting</option>
                            <option value="@PipelineErrorMode.Fail"
                                    selected="@(Node.OnError == PipelineErrorMode.Fail)">Stop the run</option>
                            <option value="@PipelineErrorMode.Continue"
                                    selected="@(Node.OnError == PipelineErrorMode.Continue)">
                                Carry on with other branches
                            </option>
                        </select>
                        <div class="field-help">
                            Steps that read this one are skipped either way — they would have no data.
                        </div>
                    </div>

                    <div class="field">
                        <label class="field-label">Step timeout (seconds)</label>
                        <input class="input" type="number" value="@Node.TimeoutSeconds"
                               @onchange="e => SetStepTimeout(e.Value?.ToString())" />
                    </div>

                    <div class="field">
                        <label class="field-label">Retry attempts</label>
                        <input class="input" type="number" min="1" max="10"
                               value="@(Node.Retry?.MaxAttempts ?? 1)"
                               @onchange="e => SetRetry(e.Value?.ToString())" />
                        <div class="field-help">
                            Only a transient failure is retried — a busy dataset or an unreachable source.
                        </div>
                    </div>
                </div>
            </details>

            @if (_upstreamColumns.Count > 0)
            {
                <details class="pl-group">
                    <summary>Incoming columns (@_upstreamColumns.Count)</summary>
                    <div class="pl-group-body">
                        <div class="pl-cols">
                            @foreach (var column in _upstreamColumns)
                            {
                                <span class="pl-col-chip sc-tip" data-tip="@column.Type">@column.Name</span>
                            }
                        </div>
                        <div class="field-help" style="margin-top:6px;">
                            From the last preview or run. Run a preview to refresh.
                        </div>
                    </div>
                </details>
            }
        }
    </div>
</div>

@code {
    [Parameter] public PipelineNodeDef? Node { get; set; }
    [Parameter, EditorRequired] public PipelineGraph Graph { get; set; } = new();

    /// <summary>Columns the upstream step produced, from the graph's schema cache.</summary>
    [Parameter] public List<PipelineColumn> UpstreamColumns { get; set; } = new();

    [Parameter] public List<PipelineFieldOption> Datasets { get; set; } = new();
    [Parameter] public List<PipelineFieldOption> Connections { get; set; } = new();
    [Parameter] public List<PipelineFieldOption> ApiCredentials { get; set; } = new();
    [Parameter] public List<string> Tables { get; set; } = new();

    // Pipeline-level settings, shown when nothing is selected.
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool IsEnabled { get; set; }
    [Parameter] public bool ApiEnabled { get; set; }
    [Parameter] public string? Cron { get; set; }
    [Parameter] public bool RequiresManualRun { get; set; }
    [Parameter] public PipelineSettings Settings { get; set; } = new();

    [Parameter] public EventCallback<string> OnNameChanged { get; set; }
    [Parameter] public EventCallback<string?> OnDescriptionChanged { get; set; }
    [Parameter] public EventCallback<bool> OnEnabledChanged { get; set; }
    [Parameter] public EventCallback<bool> OnApiEnabledChanged { get; set; }
    [Parameter] public EventCallback<string?> OnCronChanged { get; set; }
    [Parameter] public EventCallback OnSettingsChanged { get; set; }

    /// <summary>
    /// Raised after any step edit, with a coalesce key so a burst of typing in one field collapses into a
    /// single undo entry.
    /// </summary>
    [Parameter] public EventCallback<string> OnNodeEdited { get; set; }

    private PipelineNodeSpec? _spec;
    private List<PipelineColumn> _upstreamColumns = new();

    // Kinds where a {{ run.* }} token is meaningful. A number or a picker is not one of them.
    private static readonly HashSet<string> _tokenFields = new(StringComparer.Ordinal)
    {
        PipelineFieldKinds.Text, PipelineFieldKinds.TextArea,
        PipelineFieldKinds.Sql, PipelineFieldKinds.FilePath
    };

    protected override void OnParametersSet()
    {
        _spec = Node is null ? null : PipelineNodeCatalog.Get(Node.Type);
        _upstreamColumns = UpstreamColumns;
    }

    private JsonObject Config()
    {
        Node!.Config ??= new JsonObject();
        return Node.Config;
    }

    // ---------------- reads ----------------

    private string? Str(string key)
    {
        var value = Config()[key];
        return value is JsonValue v && v.TryGetValue<string>(out var s) ? s : value?.ToString();
    }

    private bool Bool(string key)
    {
        var value = Config()[key];
        return value is JsonValue v && v.TryGetValue<bool>(out var b) && b;
    }

    private List<string> StringList(string key)
    {
        var result = new List<string>();
        if (Config()[key] is not JsonArray array) return result;

        foreach (var item in array)
            if (item is JsonValue v && v.TryGetValue<string>(out var s))
                result.Add(s);

        return result;
    }

    private bool IsVisible(PipelineFieldSpec field)
    {
        if (string.IsNullOrWhiteSpace(field.VisibleWhen)) return true;

        var parts = field.VisibleWhen.Split('=', 2);
        if (parts.Length != 2) return true;

        var actual = Config()[parts[0]];
        var text = actual switch
        {
            null => null,
            JsonValue v when v.TryGetValue<string>(out var s) => s,
            JsonValue v when v.TryGetValue<bool>(out var b) => b ? "true" : "false",
            _ => actual.ToString()
        };

        // "key=a|b" means any-of; see the matching comment in PipelineCompiler.IsVisible. These two must
        // agree, or the compiler requires a field the form never showed.
        return parts[1]
            .Split('|', StringSplitOptions.RemoveEmptyEntries)
            .Any(allowed => string.Equals(text, allowed, StringComparison.OrdinalIgnoreCase));
    }

    // ---------------- writes ----------------

    private async Task Notify(string coalesceKey) => await OnNodeEdited.InvokeAsync(coalesceKey);

    private async Task SetLabel(string? value)
    {
        Node!.Label = string.IsNullOrWhiteSpace(value) ? null : value;
        await Notify($"{Node.Id}:label");
    }

    private async Task SetString(string key, string? value)
    {
        if (string.IsNullOrEmpty(value)) Config().Remove(key);
        else Config()[key] = value;
        await Notify($"{Node!.Id}:{key}");
    }

    private async Task SetNumber(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) Config().Remove(key);
        else if (int.TryParse(value, out var parsed)) Config()[key] = parsed;
        await Notify($"{Node!.Id}:{key}");
    }

    private async Task SetBool(string key, bool value)
    {
        Config()[key] = value;
        await Notify($"{Node!.Id}:{key}");
    }

    private async Task AppendToken(string key, string token)
    {
        Config()[key] = (Str(key) ?? string.Empty) + "{{ " + token + " }}";
        await Notify($"{Node!.Id}:{key}:token");
    }

    private async Task OnErrorModeChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        Node!.OnError = string.IsNullOrEmpty(value) ? null : value;
        await Notify($"{Node.Id}:onError");
    }

    private async Task SetStepTimeout(string? value)
    {
        Node!.TimeoutSeconds = int.TryParse(value, out var parsed) && parsed > 0 ? parsed : null;
        await Notify($"{Node.Id}:timeout");
    }

    private async Task SetRetry(string? value)
    {
        var attempts = int.TryParse(value, out var parsed) ? Math.Clamp(parsed, 1, 10) : 1;
        Node!.Retry = attempts <= 1 ? null : new PipelineRetryDef { MaxAttempts = attempts };
        await Notify($"{Node.Id}:retry");
    }

    private async Task SetTimeout(string? value)
    {
        if (int.TryParse(value, out var parsed) && parsed > 0) Settings.TimeoutSeconds = parsed;
        await OnSettingsChanged.InvokeAsync();
    }

    private async Task ToggleFailOnEmpty()
    {
        Settings.FailOnEmptySource = !Settings.FailOnEmptySource;
        await OnSettingsChanged.InvokeAsync();
    }

    // ---------------- structured editors ----------------

    /// <summary>
    /// THE mapping grid. One row per output column: where it comes from, and what to cast it to.
    /// <para>
    /// The source is a dropdown of the upstream step's real columns whenever they are known, because typing
    /// a column name from memory is how a pipeline ends up failing at 3am on a typo. When they are not known
    /// yet it degrades to a text box rather than blocking the author.
    /// </para>
    /// </summary>
    private RenderFragment ColumnMapEditor(string key) => builder =>
    {
        var map = Config()[key] as JsonObject ?? new JsonObject();
        var rows = map.Select(kv => kv.Key).ToList();
        var known = _upstreamColumns.Select(c => c.Name).ToList();
        var seq = 0;

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pl-row-head pl-map-row");
        builder.AddContent(seq++, Header("Output", "From", "Cast", string.Empty));
        builder.CloseElement();

        foreach (var name in rows)
        {
            var outName = name;
            var spec = map[outName] as JsonObject ?? new JsonObject();
            var source = spec["source"]?.ToString();
            var constant = spec["const"]?.ToString();
            var cast = spec["cast"]?.ToString();
            var missing = source is { Length: > 0 } && known.Count > 0 && !known.Contains(source);

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "pl-map-row");
            builder.SetKey(outName);

            // output name
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "class", "input input-mono");
            builder.AddAttribute(seq++, "value", outName);
            builder.AddAttribute(seq++, "onchange",
                EventCallback.Factory.Create<ChangeEventArgs>(this,
                    e => RenameMapRow(key, outName, e.Value?.ToString())));
            builder.CloseElement();

            // source: a select when the columns are known, a text box otherwise
            if (known.Count > 0 && constant is null)
            {
                builder.OpenElement(seq++, "select");
                builder.AddAttribute(seq++, "class", missing ? "select pl-col-chip is-missing" : "select");
                builder.AddAttribute(seq++, "onchange",
                    EventCallback.Factory.Create<ChangeEventArgs>(this,
                        e => SetMapField(key, outName, "source", e.Value?.ToString())));

                builder.OpenElement(seq++, "option");
                builder.AddAttribute(seq++, "value", string.Empty);
                builder.AddContent(seq++, "Choose…");
                builder.CloseElement();

                // A column the upstream step no longer produces still has to be selectable, or the grid
                // would silently drop the mapping the author needs to see and fix.
                if (missing)
                {
                    builder.OpenElement(seq++, "option");
                    builder.AddAttribute(seq++, "value", source!);
                    builder.AddAttribute(seq++, "selected", true);
                    builder.AddContent(seq++, source + " (missing)");
                    builder.CloseElement();
                }

                foreach (var column in known)
                {
                    builder.OpenElement(seq++, "option");
                    builder.AddAttribute(seq++, "value", column);
                    builder.AddAttribute(seq++, "selected", source == column);
                    builder.AddContent(seq++, column);
                    builder.CloseElement();
                }
                builder.CloseElement();
            }
            else
            {
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "class", "input input-mono");
                builder.AddAttribute(seq++, "placeholder", constant is null ? "source column" : "fixed value");
                builder.AddAttribute(seq++, "value", constant ?? source ?? string.Empty);
                builder.AddAttribute(seq++, "onchange",
                    EventCallback.Factory.Create<ChangeEventArgs>(this,
                        e => SetMapField(key, outName, constant is null ? "source" : "const",
                            e.Value?.ToString())));
                builder.CloseElement();
            }

            // cast
            builder.OpenElement(seq++, "select");
            builder.AddAttribute(seq++, "class", "select");
            builder.AddAttribute(seq++, "onchange",
                EventCallback.Factory.Create<ChangeEventArgs>(this,
                    e => SetMapField(key, outName, "cast", e.Value?.ToString())));
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", string.Empty);
            builder.AddAttribute(seq++, "selected", string.IsNullOrEmpty(cast));
            builder.AddContent(seq++, "as-is");
            builder.CloseElement();
            foreach (var type in CastTypes)
            {
                builder.OpenElement(seq++, "option");
                builder.AddAttribute(seq++, "value", type);
                builder.AddAttribute(seq++, "selected", cast == type);
                builder.AddContent(seq++, type);
                builder.CloseElement();
            }
            builder.CloseElement();

            builder.AddContent(seq++, DeleteButton(() => RemoveMapRow(key, outName)));
            builder.CloseElement();
        }

        builder.AddContent(seq++, AddRowButton("Add a column", () => AddMapRow(key)));

        // Bulk fill: one click to map every incoming column straight through. For a wide table this is the
        // difference between usable and unusable, and it is what most authors want before editing a few rows.
        if (known.Count > 0)
        {
            builder.AddContent(seq++, AddRowButton(
                $"Map all {known.Count} incoming columns", () => MapAll(key)));
        }
    };

    private RenderFragment ColumnListEditor(string key) => builder =>
    {
        var chosen = StringList(key);
        var known = _upstreamColumns.Select(c => c.Name).ToList();
        var seq = 0;

        if (known.Count == 0)
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "class", "input input-mono");
            builder.AddAttribute(seq++, "placeholder", "comma-separated column names");
            builder.AddAttribute(seq++, "value", string.Join(", ", chosen));
            builder.AddAttribute(seq++, "onchange",
                EventCallback.Factory.Create<ChangeEventArgs>(this,
                    e => SetStringList(key, (e.Value?.ToString() ?? string.Empty)
                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))));
            builder.CloseElement();
            return;
        }

        // Toggle chips: faster than a multi-select and it shows what is available at the same time.
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pl-cols");
        foreach (var column in known)
        {
            var name = column;
            var on = chosen.Contains(name, StringComparer.OrdinalIgnoreCase);
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", on ? "pl-col-chip is-on" : "pl-col-chip");
            builder.AddAttribute(seq++, "onclick",
                EventCallback.Factory.Create(this, () => ToggleColumn(key, name)));
            builder.AddContent(seq++, name);
            builder.CloseElement();
        }
        builder.CloseElement();

        // Any name kept from a previous schema, so a stale key stays visible and fixable.
        var stale = chosen.Where(c => !known.Contains(c, StringComparer.OrdinalIgnoreCase)).ToList();
        if (stale.Count > 0)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "pl-cols");
            builder.AddAttribute(seq++, "style", "margin-top:4px;");
            foreach (var column in stale)
            {
                var name = column;
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "pl-col-chip is-missing");
                builder.AddAttribute(seq++, "title", "Not in the incoming data any more");
                builder.AddAttribute(seq++, "onclick",
                    EventCallback.Factory.Create(this, () => ToggleColumn(key, name)));
                builder.AddContent(seq++, name + " ✕");
                builder.CloseElement();
            }
            builder.CloseElement();
        }
    };

