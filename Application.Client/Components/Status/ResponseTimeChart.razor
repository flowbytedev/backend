@using Application.Shared.Enums
@* Response time of recent checks as an area line. Pure SVG drawn from one scale; each check has an invisible
   hit column with a native tooltip, so hovering shows the time and value without any JS. *@

@if (points.Count < 2)
{
    <div class="st-card-empty">Not enough checks with a response time in this range yet.</div>
}
else
{
    <div class="st-spark-stats">
        <span>avg <b>@StatusUi.Ms(avg)</b></span>
        <span>p95 <b>@StatusUi.Ms(p95)</b></span>
        <span>min <b>@StatusUi.Ms(min)</b></span>
        <span>max <b>@StatusUi.Ms(max)</b></span>
        <span>@points.Count checks</span>
    </div>
    <div class="st-spark">
        <svg viewBox="0 0 @W @H" style="height:auto" role="img" aria-label="@($"Response time, {points.Count} checks, average {StatusUi.Ms(avg)}")">
            @foreach (var t in ticks)
            {
                <line class="st-spark-grid" x1="@F(PadL)" x2="@F(W - PadR)" y1="@F(Y(t))" y2="@F(Y(t))" />
                @((MarkupString)$"<text class=\"st-spark-axis\" x=\"{F(PadL - 6)}\" y=\"{F(Y(t) + 3.5)}\" text-anchor=\"end\">{TickLabel(t)}</text>")
            }
            @for (var i = 0; i < xLabels.Count; i++)
            {
                var anchor = i == 0 ? "start" : i == xLabels.Count - 1 ? "end" : "middle";
                @((MarkupString)$"<text class=\"st-spark-axis\" x=\"{F(xLabels[i].x)}\" y=\"{F(H - 4)}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(xLabels[i].label)}</text>")
            }
            <path class="st-spark-area" d="@areaPath" />
            <polyline class="st-spark-line" points="@linePoints" />
            <circle class="st-spark-end" r="4" cx="@F(X(points.Count - 1))" cy="@F(Y(points[^1].ms))" />
            @for (var i = 0; i < points.Count; i++)
            {
                var p = points[i];
                var half = (W - PadL - PadR) / (points.Count - 1) / 2;
                <rect class="st-spark-hit" x="@F(X(i) - half)" y="@F(PadT)" width="@F(half * 2)" height="@F(H - PadT - PadB)">
                    <title>@($"{StatusUi.Local(p.at):d MMM HH:mm} — {StatusUi.Ms(p.ms)}")</title>
                </rect>
                <circle class="st-spark-pt" r="4" cx="@F(X(i))" cy="@F(Y(p.ms))" />
            }
        </svg>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<AssetStatusHistory> History { get; set; } = new();

    private const double W = 640, H = 160, PadL = 46, PadR = 10, PadT = 10, PadB = 22;

    private List<(DateTime at, double ms)> points = new();
    private List<double> ticks = new();
    private List<(double x, string label)> xLabels = new();
    private double yMax = 1, avg, p95, min, max;
    private string linePoints = "", areaPath = "";

    protected override void OnParametersSet()
    {
        points = History
            .Where(h => h.ResponseTime.HasValue && h.CheckedAt.HasValue)
            .OrderBy(h => h.CheckedAt)
            .Select(h => (h.CheckedAt!.Value, h.ResponseTime!.Value))
            .ToList();
        if (points.Count < 2) return;

        var values = points.Select(p => p.ms).OrderBy(v => v).ToList();
        avg = values.Average();
        min = values[0];
        max = values[^1];
        p95 = values[(int)Math.Min(values.Count - 1, Math.Ceiling(values.Count * 0.95) - 1)];

        var step = NiceStep(max / 4);
        yMax = Math.Max(step, Math.Ceiling(max * 1.08 / step) * step);
        ticks = Enumerable.Range(0, (int)(yMax / step) + 1).Select(i => i * step).ToList();

        linePoints = string.Join(" ", points.Select((p, i) => $"{F(X(i))},{F(Y(p.ms))}"));
        areaPath = $"M{F(X(0))},{F(Y(0))} L{string.Join(" L", points.Select((p, i) => $"{F(X(i))},{F(Y(p.ms))}"))} L{F(X(points.Count - 1))},{F(Y(0))} Z";

        var first = StatusUi.Local(points[0].at);
        var last = StatusUi.Local(points[^1].at);
        var multiDay = first.Date != last.Date;
        string Fmt(DateTime d) => multiDay ? d.ToString("d MMM HH:mm") : d.ToString("HH:mm");
        xLabels = new() { (X(0), Fmt(first)) };
        if (points.Count > 4) xLabels.Add((X((points.Count - 1) / 2), Fmt(StatusUi.Local(points[(points.Count - 1) / 2].at))));
        xLabels.Add((X(points.Count - 1), Fmt(last)));
    }

    private double X(int i) => PadL + i / (double)(points.Count - 1) * (W - PadL - PadR);
    private double Y(double v) => PadT + (1 - v / yMax) * (H - PadT - PadB);

    private static double NiceStep(double raw)
    {
        if (raw <= 0) return 1;
        var mag = Math.Pow(10, Math.Floor(Math.Log10(raw)));
        var norm = raw / mag;
        return (norm <= 1 ? 1 : norm <= 2 ? 2 : norm <= 5 ? 5 : 10) * mag;
    }

    private static string TickLabel(double v) => v >= 1000 ? $"{v / 1000:0.#}s" : $"{v:0}";
    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
