@using Application.Shared.Models
@using Application.Shared.Enums
@using Application.Client.Services
@inject MonitoredAssetClientService EntityService
@inject StateContainer StateContainer

@* Dependencies & impact card on the entity page (status.css .st-dep-*, .st-deps). The tree is computed on
   demand because it can be expensive; set AutoLoad when the caller already knows it wants it. *@
<div class="card">
    <div class="card-head">
        <h3 class="card-title">Dependencies</h3>
        <span class="st-card-spacer"></span>
        <a class="st-link" href="@($"status/entities/{EntityId}/dependencies{QueryParam}")">Manage</a>
    </div>

    @if (isLoading)
    {
        <div class="st-load"><span class="spin"></span> Computing the dependency tree…</div>
    }
    else if (!loaded)
    {
        <div class="st-load">
            <button class="btn btn-secondary btn-sm" type="button" @onclick="LoadAsync">@StatusUi.Icon("branch", 13) Load dependencies and impact</button>
            <span>Loaded on demand because the full tree can take a moment.</span>
        </div>
    }
    else if (tree == null)
    {
        <div class="st-deps-empty">Couldn't load dependency information. <button class="st-link" type="button" @onclick="LoadAsync">Try again</button></div>
    }
    else
    {
        @if (StatusUi.IsUnhealthy(tree.CurrentStatus) && rootCauses.Any())
        {
            <div class="st-cause">
                @StatusUi.Icon("alert", 14)
                <div>
                    <b>Possible cause:</b> @StatusUi.Plural(rootCauses.Count, "upstream dependency is", "upstream dependencies are") unhealthy:
                    @string.Join(", ", rootCauses.Take(4).Select(n => n.EntityName))@(rootCauses.Count > 4 ? $" +{rootCauses.Count - 4} more" : "").
                </div>
            </div>
        }

        <div class="st-dep-dir">@StatusUi.Icon("up-right", 12) Depends on <span class="st-dep-dir-n">@(tree.Dependencies?.Count ?? 0) direct@(upstreamAll.Count > (tree.Dependencies?.Count ?? 0) ? $" · {upstreamAll.Count} in chain" : "")</span></div>
        @if (tree.Dependencies?.Any() == true)
        {
            <ul class="st-deps">
                @foreach (var n in tree.Dependencies.OrderByDescending(d => StatusUi.Rank(d.CurrentStatus)).ThenBy(d => d.EntityName))
                {
                    @NodeRow(n)
                }
            </ul>
        }
        else
        {
            <div class="st-deps-empty">This entity doesn't depend on anything yet.</div>
        }

        <div class="st-dep-dir">@StatusUi.Icon("down-right", 12) Impact if this fails <span class="st-dep-dir-n">@downstreamAll.Count@(criticalCount > 0 ? $" · {criticalCount} critical" : "")</span></div>
        @if (downstreamAll.Any())
        {
            <ul class="st-deps" style="max-height:320px;overflow-y:auto">
                @foreach (var n in downstreamAll.OrderByDescending(d => d.IsCritical).ThenBy(d => d.EntityName))
                {
                    @NodeRow(n)
                }
            </ul>
        }
        else
        {
            <div class="st-deps-empty">Nothing depends on this entity.</div>
        }
    }
</div>

@code {
    [Parameter] public string EntityId { get; set; } = string.Empty;
    [Parameter] public bool AutoLoad { get; set; }

    private AssetDependencyTree? tree;
    private bool isLoading;
    private bool loaded;
    private string? lastEntityId;

    // Flattened, de-duplicated transitive sets.
    private List<AssetDependencyTreeNode> upstreamAll = new();
    private List<AssetDependencyTreeNode> downstreamAll = new();
    private List<AssetDependencyTreeNode> rootCauses = new();
    private int criticalCount;

    private string QueryParam => StateContainer.Company is null ? "" : $"?c={StateContainer.Company.Id}";

    protected override async Task OnParametersSetAsync()
    {
        // Reset when the component is reused for a different entity.
        if (lastEntityId != EntityId)
        {
            lastEntityId = EntityId;
            loaded = false;
            isLoading = false;
            tree = null;
            upstreamAll = new();
            downstreamAll = new();
            rootCauses = new();
            criticalCount = 0;
            if (AutoLoad) await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(EntityId)) return;
        isLoading = true;
        tree = await EntityService.GetEntityDependencyTreeAsync(EntityId);

        upstreamAll = Flatten(tree?.Dependencies);
        downstreamAll = Flatten(tree?.Dependents);
        rootCauses = upstreamAll.Where(n => StatusUi.IsUnhealthy(n.CurrentStatus)).ToList();
        criticalCount = downstreamAll.Count(n => n.IsCritical);

        loaded = true;
        isLoading = false;
    }

    /// <summary>Flattens a recursive node list into a unique-by-entity set (keeps the shallowest occurrence).</summary>
    private static List<AssetDependencyTreeNode> Flatten(List<AssetDependencyTreeNode>? nodes)
    {
        var acc = new Dictionary<string, AssetDependencyTreeNode>();
        void Walk(List<AssetDependencyTreeNode>? ns)
        {
            if (ns == null) return;
            foreach (var n in ns)
            {
                if (!acc.ContainsKey(n.EntityId)) acc[n.EntityId] = n;
                Walk(n.Children);
            }
        }
        Walk(nodes);
        return acc.Values.ToList();
    }

    private RenderFragment NodeRow(AssetDependencyTreeNode n) => __builder =>
    {
        <li>
            <span class="st-dot @StatusUi.Cls(n.CurrentStatus)" title="@StatusUi.Label(n.CurrentStatus)"></span>
            <div class="st-deps-name">
                <a href="@($"status/entities/{n.EntityId}{QueryParam}")">@n.EntityName</a>
                <small>@StatusUi.TypeLabel(n.EntityType) · @StatusUi.Label(n.CurrentStatus).ToLowerInvariant()</small>
            </div>
            @if (n.IsCritical) { <span class="badge badge-danger dl-mini-badge">Critical</span> }
        </li>
    };
}
