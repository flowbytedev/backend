@page "/status/entities/{AssetId}/dependencies"
@using Application.Shared.Enums
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject NavigationManager Navigation
@inject MonitoredAssetClientService EntityService
@inject StateContainer StateContainer
@attribute [Authorize(Policy = PolicyNames.StatusRead)]

<PageTitle>Dependencies · @(entity?.Name ?? "Entity")</PageTitle>

@* Styles: Application/wwwroot/status.css (.st-tree, .st-node, .st-dep-*). *@
<div class="sc">
    <div class="page-wrap st-wrap">
        @if (isLoading)
        {
            <div class="card"><div class="st-loading"><span class="spin"></span> Loading dependencies…</div></div>
        }
        else if (entity is null)
        {
            <div class="card">
                <div class="empty">
                    <div class="empty-title">Entity not found</div>
                    <a class="btn btn-secondary btn-sm" href="@($"status/entities{queryParam}")">Back to entities</a>
                </div>
            </div>
        }
        else
        {
            var selfStatus = dependencyTree?.CurrentStatus ?? AssetStatus.Unknown;
            var upAll = Flatten(dependencyTree?.Dependencies);
            var downAll = Flatten(dependencyTree?.Dependents);
            var unhealthyUp = upAll.Where(n => StatusUi.IsUnhealthy(n.CurrentStatus)).ToList();

            <div class="st-head">
                <div class="st-head-left">
                    <a class="st-back" href="@EntityHref" title="Back to @entity.Name" aria-label="Back to @entity.Name">@StatusUi.Icon("arrow-left", 16)</a>
                    <div class="st-head-main">
                        <div class="st-crumbs">
                            <a href="@($"status/entities{queryParam}")">Entities</a>
                            @StatusUi.Icon("chev-right", 12)<a href="@EntityHref">@entity.Name</a>
                            @StatusUi.Icon("chev-right", 12)<span>Dependencies</span>
                        </div>
                        <div class="st-title-row">
                            <h1 class="page-title">Dependencies</h1>
                            <span class="st-status @StatusUi.Cls(selfStatus)"><span class="st-dot @(StatusUi.IsUnhealthy(selfStatus) ? "is-live" : "")"></span> @entity.Name is @StatusUi.Label(selfStatus).ToLowerInvariant()</span>
                        </div>
                        <p class="page-subtitle" style="margin-top:4px">What this entity needs to run, and what breaks when it doesn't.</p>
                    </div>
                </div>
                <div class="st-head-actions">
                    <button class="btn btn-secondary" type="button" @onclick="LoadDependencyTree" disabled="@isLoadingTree">@StatusUi.Icon("refresh", 14) Recompute impact</button>
                </div>
            </div>

            <div class="st-cols is-even">
                <div class="st-col">
                    <div class="card">
                        @if (isLoadingTree && dependencyTree is null)
                        {
                            <div class="st-load"><span class="spin"></span> Computing the dependency tree…</div>
                        }
                        else if (dependencyTree is null)
                        {
                            <div class="st-deps-empty">Couldn't load the dependency tree. <button class="st-link" type="button" @onclick="LoadDependencyTree">Try again</button></div>
                        }
                        else
                        {
                            <div class="st-dep-dir">@StatusUi.Icon("up-right", 12) Depends on <span class="st-dep-dir-n">@dependencyTree.Dependencies.Count direct@(upAll.Count > dependencyTree.Dependencies.Count ? $" · {upAll.Count} in chain" : "")</span></div>
                            @if (StatusUi.IsUnhealthy(selfStatus) && dependencyTree.Dependencies.Any())
                            {
                                @if (unhealthyUp.Any())
                                {
                                    <div class="st-cause">@StatusUi.Icon("alert", 14)<div><b>Possible cause:</b> @string.Join(", ", unhealthyUp.Take(4).Select(n => n.EntityName))@(unhealthyUp.Count > 4 ? $" +{unhealthyUp.Count - 4} more" : "") @(unhealthyUp.Count == 1 ? "is" : "are") unhealthy upstream.</div></div>
                                }
                                else
                                {
                                    <div class="st-cause is-ok">@StatusUi.Icon("info", 14)<div><b>No upstream cause found.</b> Everything this entity depends on is healthy, so the problem is likely on @entity.Name itself.</div></div>
                                }
                            }
                            @if (!dependencyTree.Dependencies.Any())
                            {
                                <div class="st-deps-empty">@entity.Name doesn't depend on anything yet.@(canWrite ? " Add what it needs to run with the form on the right." : "")</div>
                            }
                            else
                            {
                                <ul class="st-tree">
                                    @foreach (var n in dependencyTree.Dependencies.OrderBy(d => d.Order).ThenBy(d => d.EntityName))
                                    {
                                        @Node(n, true, 0)
                                    }
                                </ul>
                            }

                            <div class="st-self">
                                <span class="st-self-lbl">This entity</span>
                                <span class="st-tile-sm">@StatusUi.TypeSvg(entity.EntityType, 13)</span>
                                @entity.Name
                                <span class="st-status @StatusUi.Cls(selfStatus)"><span class="st-dot"></span> @StatusUi.Label(selfStatus)</span>
                            </div>

                            <div class="st-dep-dir">@StatusUi.Icon("down-right", 12) Impact if this fails <span class="st-dep-dir-n">@dependencyTree.Dependents.Count direct@(downAll.Count > dependencyTree.Dependents.Count ? $" · {downAll.Count} in chain" : "")@(downAll.Count(n => n.IsCritical) is var c && c > 0 ? $" · {c} critical" : "")</span></div>
                            @if (!dependencyTree.Dependents.Any())
                            {
                                <div class="st-deps-empty">Nothing depends on @entity.Name.</div>
                            }
                            else
                            {
                                <ul class="st-tree">
                                    @foreach (var n in dependencyTree.Dependents.OrderByDescending(d => d.IsCritical).ThenBy(d => d.EntityName))
                                    {
                                        @Node(n, false, 0)
                                    }
                                </ul>
                                <div class="dl-footer"><span class="dl-footer-text">Downstream links are read-only here. Edit them from the dependent entity.</span></div>
                            }
                        }
                    </div>
                </div>

                <div class="st-col">
                    @if (canWrite)
                    {
                        <div class="card">
                            <div class="card-head">
                                <h3 class="card-title">@(editingDependency is null ? "Add a dependency" : "Edit dependency")</h3>
                                <span class="st-card-sub">@entity.Name depends on…</span>
                            </div>
                            <div class="card-body">
                                <div class="field">
                                    <label class="field-label" for="d-type">Type</label>
                                    <select class="select" id="d-type" @bind="typeFilter" @bind:after="OnTypeChanged" disabled="@(editingDependency is not null)">
                                        <option value="">All types</option>
                                        @foreach (var t in Enum.GetValues<AssetType>())
                                        {
                                            <option value="@t">@StatusUi.TypeLabel(t)</option>
                                        }
                                    </select>
                                </div>
                                <div class="field">
                                    <label class="field-label" for="d-entity">Entity <b>*</b></label>
                                    <EntityPicker Id="d-entity" Entities="@PickerEntities" @bind-Value="dependencyForm.DependsOnEntityId"
                                                  Placeholder="Choose what it depends on" Disabled="@(editingDependency is not null)"
                                                  DisabledReason="@AlreadyLinked" />
                                    @if (showErrors && string.IsNullOrEmpty(dependencyForm.DependsOnEntityId)) { <span class="field-error">Choose an entity.</span> }
                                </div>
                                <div class="field">
                                    <label class="field-label" for="d-note">Why it is needed</label>
                                    <input class="input" id="d-note" maxlength="500" placeholder="e.g. source tables for the nightly load" @bind="dependencyForm.Description" />
                                </div>
                                <div class="st-form-grid">
                                    <div class="field">
                                        <label class="field-label" for="d-order">Check order</label>
                                        <input class="input input-mono" id="d-order" type="number" min="0" @bind="dependencyForm.Order" />
                                        <span class="field-help">Lower numbers are listed and checked first.</span>
                                    </div>
                                    <div class="field">
                                        <span class="field-label">Options</span>
                                        <button type="button" class="switch-row" style="background:none;border:0;padding:5px 0" role="switch" aria-checked="@(dependencyForm.IsCritical ? "true" : "false")" @onclick="() => dependencyForm.IsCritical = !dependencyForm.IsCritical">
                                            <span class="switch @(dependencyForm.IsCritical ? "is-on" : "")"></span><span class="switch-label">Critical</span>
                                        </button>
                                        <button type="button" class="switch-row" style="background:none;border:0;padding:5px 0" role="switch" aria-checked="@(dependencyForm.IsActive ? "true" : "false")" @onclick="() => dependencyForm.IsActive = !dependencyForm.IsActive">
                                            <span class="switch @(dependencyForm.IsActive ? "is-on" : "")"></span><span class="switch-label">Active</span>
                                        </button>
                                    </div>
                                </div>
                                <div class="st-callout is-info">@StatusUi.Icon("info", 14)<div>When @entity.Name is unhealthy, unhealthy <b>upstream</b> dependencies are listed as a possible cause on its page.</div></div>
                                @if (errorMessage is not null) { <div class="form-error" role="alert">@errorMessage</div> }
                            </div>
                            <div class="st-form-foot">
                                @if (editingDependency is not null)
                                {
                                    <button class="btn btn-ghost st-btn-danger-outline" style="margin-right:auto" type="button" @onclick="() => DeleteDependency(editingDependency)">Remove</button>
                                }
                                <button class="btn btn-ghost" type="button" @onclick="ResetForm">@(editingDependency is null ? "Clear" : "Cancel")</button>
                                <button class="btn btn-primary" type="button" disabled="@isSubmittingDependency" @onclick="HandleDependencySubmit">
                                    @(isSubmittingDependency ? "Saving…" : editingDependency is null ? "Add dependency" : "Save dependency")
                                </button>
                            </div>
                        </div>
                    }

                    @if (dependencyTree is not null)
                    {
                        <div class="card">
                            <div class="card-head"><h3 class="card-title">Impact summary</h3></div>
                            <div class="card-body">
                                <dl class="st-dl">
                                    <dt>Upstream</dt><dd>@StatusUi.Plural(dependencyTree.Dependencies.Count, "direct") · @StatusUi.Plural(upAll.Count, "entity", "entities") in the chain</dd>
                                    <dt>Downstream</dt><dd>@StatusUi.Plural(dependencyTree.Dependents.Count, "direct") · @StatusUi.Plural(downAll.Count, "entity", "entities") in the chain</dd>
                                    <dt>Critical affected</dt><dd>@downAll.Count(n => n.IsCritical)</dd>
                                    <dt>Types affected</dt><dd>@(downAll.Any() ? string.Join(", ", downAll.Select(n => StatusUi.TypePlural(n.EntityType)).Distinct()) : "—")</dd>
                                    <dt>Unhealthy now</dt><dd>@(upAll.Concat(downAll).Count(n => StatusUi.IsUnhealthy(n.CurrentStatus)))</dd>
                                </dl>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <StatusConfirm @ref="confirm" />
    <StatusToast @ref="toast" />
</div>

@code {
    [Parameter] public string AssetId { get; set; } = string.Empty;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private MonitoredAsset? entity;
    private List<MonitoredAsset> availableEntities = new();
    private AssetDependencyTree? dependencyTree;
    private bool isLoading = true;
    private bool isLoadingTree;
    private bool canWrite;

    private AssetDependency dependencyForm = new() { IsActive = true };
    private AssetDependency? editingDependency;
    private string typeFilter = "";
    private bool isSubmittingDependency;
    private bool showErrors;
    private string? errorMessage;

    private StatusConfirm confirm = default!;
    private StatusToast toast = default!;

    private string queryParam => StateContainer.Company is null ? "" : $"?c={StateContainer.Company.Id}";
    private string EntityHref => $"status/entities/{AssetId}{queryParam}";

    private List<MonitoredAsset> PickerEntities =>
        Enum.TryParse<AssetType>(typeFilter, out var t)
            ? availableEntities.Where(e => e.EntityType == t).ToList()
            : availableEntities;

    private string? AlreadyLinked(MonitoredAsset e) =>
        editingDependency is null && entity?.Dependencies?.Any(d => d.DependsOnEntityId == e.Id && !d.IsDeleted) == true
            ? "already a dependency"
            : null;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            var c = StateContainer.Company?.Id;
            canWrite = user.IsInRole($"{c}_INCIDENTS") || user.IsInRole($"{c}_ADMIN");
        }
        if (!string.IsNullOrEmpty(AssetId)) await LoadData();
        ResetForm();
    }

    private async Task LoadData()
    {
        var companyId = StateContainer.Company?.Id ?? "";
        try
        {
            var entityTask = EntityService.GetEntityAsync(AssetId);
            var allTask = EntityService.GetEntitiesWithLatestStatusAsync(companyId);
            var treeTask = LoadDependencyTree();
            await Task.WhenAll(entityTask, allTask, treeTask);
            entity = entityTask.Result;
            availableEntities = allTask.Result.Where(e => e.Id != AssetId).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDependencyTree()
    {
        if (string.IsNullOrEmpty(AssetId)) return;
        try
        {
            isLoadingTree = true;
            dependencyTree = await EntityService.GetEntityDependencyTreeAsync(AssetId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dependency tree: {ex.Message}");
        }
        finally
        {
            isLoadingTree = false;
        }
    }

    private void OnTypeChanged()
    {
        if (!PickerEntities.Any(e => e.Id == dependencyForm.DependsOnEntityId))
            dependencyForm.DependsOnEntityId = string.Empty;
    }

    private void ResetForm()
    {
        editingDependency = null;
        showErrors = false;
        errorMessage = null;
        typeFilter = "";
        var nextOrder = (entity?.Dependencies?.Where(d => !d.IsDeleted).Select(d => d.Order).DefaultIfEmpty(0).Max() ?? 0) + 1;
        dependencyForm = new AssetDependency
        {
            EntityId = AssetId,
            IsActive = true,
            IsCritical = false,
            Order = nextOrder,
            CompanyId = entity?.CompanyId
        };
    }

    private AssetDependency? FindDirectDependency(AssetDependencyTreeNode node) =>
        entity?.Dependencies?.FirstOrDefault(d => d.DependsOnEntityId == node.EntityId && !d.IsDeleted);

    private void EditDependency(AssetDependency dependency)
    {
        editingDependency = dependency;
        showErrors = false;
        errorMessage = null;
        typeFilter = "";
        dependencyForm = new AssetDependency
        {
            Id = dependency.Id,
            EntityId = dependency.EntityId,
            DependsOnEntityId = dependency.DependsOnEntityId,
            Description = dependency.Description,
            DependencyType = dependency.DependencyType,
            Order = dependency.Order,
            IsActive = dependency.IsActive,
            IsCritical = dependency.IsCritical,
            CompanyId = dependency.CompanyId
        };
    }

    private async Task HandleDependencySubmit()
    {
        if (isSubmittingDependency) return;
        showErrors = true;
        errorMessage = null;
        if (string.IsNullOrEmpty(dependencyForm.DependsOnEntityId)) return;

        isSubmittingDependency = true;
        dependencyForm.CompanyId = entity?.CompanyId;
        dependencyForm.DependencyType ??= availableEntities.FirstOrDefault(e => e.Id == dependencyForm.DependsOnEntityId)?.EntityType;
        var targetName = availableEntities.FirstOrDefault(e => e.Id == dependencyForm.DependsOnEntityId)?.Name ?? "entity";
        try
        {
            if (editingDependency != null)
            {
                if (!await EntityService.UpdateDependencyAsync(dependencyForm)) { errorMessage = "The dependency could not be saved. Try again."; return; }
                toast.Show($"Saved dependency on {targetName}");
            }
            else
            {
                if (dependencyForm.Id is null or "") dependencyForm.Id = Guid.NewGuid().ToString();
                if (await EntityService.AddDependencyAsync(AssetId, dependencyForm) is null) { errorMessage = "The dependency could not be added. It may already exist."; return; }
                toast.Show($"Added dependency on {targetName}");
            }
            entity = await EntityService.GetEntityAsync(AssetId);
            ResetForm();
            await LoadDependencyTree();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving dependency: {ex.Message}");
            errorMessage = $"The dependency could not be saved: {ex.Message}";
        }
        finally
        {
            isSubmittingDependency = false;
        }
    }

    private async Task DeleteDependency(AssetDependency dependency)
    {
        var name = availableEntities.FirstOrDefault(e => e.Id == dependency.DependsOnEntityId)?.Name ?? dependency.DependsOnEntity?.Name ?? "this entity";
        if (!await confirm.Ask($"Remove the dependency on {name}?", $"{entity?.Name} will no longer list {name} as something it needs.", "Remove")) return;
        try
        {
            if (await EntityService.RemoveDependencyAsync(dependency.Id))
            {
                toast.Show($"Removed dependency on {name}");
                entity = await EntityService.GetEntityAsync(AssetId);
                ResetForm();
                await LoadDependencyTree();
            }
            else toast.Show("Could not remove the dependency. Try again.", error: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting dependency: {ex.Message}");
            toast.Show("Could not remove the dependency. Try again.", error: true);
        }
    }

    private static List<AssetDependencyTreeNode> Flatten(List<AssetDependencyTreeNode>? nodes)
    {
        var acc = new Dictionary<string, AssetDependencyTreeNode>();
        void Walk(List<AssetDependencyTreeNode>? ns)
        {
            if (ns == null) return;
            foreach (var n in ns)
            {
                if (!acc.ContainsKey(n.EntityId)) acc[n.EntityId] = n;
                Walk(n.Children);
            }
        }
        Walk(nodes);
        return acc.Values.ToList();
    }

    private RenderFragment Node(AssetDependencyTreeNode node, bool isUpstream, int depth) => __builder =>
    {
        var direct = isUpstream && depth == 0 ? FindDirectDependency(node) : null;
        <li>
            <div class="st-node">
                @if (depth == 0)
                {
                    <span class="st-node-ord" title="Check order">@(isUpstream && node.Order > 0 ? node.Order.ToString() : "")</span>
                }
                else
                {
                    <span class="st-node-depth" title="Level @(depth + 1)">L@(depth + 1)</span>
                }
                <span class="st-dot @StatusUi.Cls(node.CurrentStatus)" title="@StatusUi.Label(node.CurrentStatus)"></span>
                <span class="st-tile-sm">@StatusUi.TypeSvg(node.EntityType, 13)</span>
                <span class="st-node-name">
                    <a href="@($"status/entities/{node.EntityId}{queryParam}")">@node.EntityName</a>
                    <small>@StatusUi.TypeLabel(node.EntityType)@(string.IsNullOrWhiteSpace(node.Description) ? "" : $" · {node.Description}")</small>
                </span>
                @if (!node.IsActive) { <span class="badge badge-neutral dl-mini-badge">Inactive</span> }
                @if (node.IsCritical) { <span class="badge badge-danger dl-mini-badge">Critical</span> }
                @if (direct is not null && canWrite)
                {
                    <button class="dl-act" style="opacity:1" type="button" title="Edit" aria-label="Edit dependency on @node.EntityName" @onclick="() => EditDependency(direct)">@StatusUi.Icon("edit", 13)</button>
                    <button class="dl-act dl-act-danger" style="opacity:1" type="button" title="Remove" aria-label="Remove dependency on @node.EntityName" @onclick="() => DeleteDependency(direct)">@StatusUi.Icon("x", 13)</button>
                }
            </div>
            @if (node.Children?.Any() == true)
            {
                <ul>
                    @foreach (var child in node.Children)
                    {
                        @Node(child, isUpstream, depth + 1)
                    }
                </ul>
            }
        </li>
    };
}
