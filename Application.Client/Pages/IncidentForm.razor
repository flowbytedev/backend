@page "/status/incidents/create"
@page "/status/incidents/{IncidentId}/edit"
@using Application.Shared.Enums
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject NavigationManager Navigation
@inject IncidentClientService IncidentService
@inject MonitoredAssetClientService EntityService
@inject StateContainer StateContainer
@attribute [Authorize(Policy = PolicyNames.StatusWrite)]

<PageTitle>@(IsEditMode ? $"Edit {incident.Title}" : "Report incident") · Status</PageTitle>

@* Styles: Application/wwwroot/status.css (.st-form*, .st-sev). Validation comes from the Incident model's
   data annotations. `?entity={id}` preselects the affected entity (used by the entity page). *@
<div class="sc">
    <div class="page-wrap st-wrap st-wrap-narrow">
        <div class="st-head">
            <div class="st-head-left">
                <a class="st-back" href="@BackHref" title="Back" aria-label="Back">@StatusUi.Icon("arrow-left", 16)</a>
                <div class="st-head-main">
                    <div class="st-crumbs">
                        <a href="@($"status/incidents{queryParam}")">Incidents</a>
                        @if (IsEditMode)
                        {
                            @StatusUi.Icon("chev-right", 12)<a href="@BackHref">@(string.IsNullOrWhiteSpace(incident.Title) ? "Incident" : incident.Title)</a>
                        }
                        @StatusUi.Icon("chev-right", 12)<span>@(IsEditMode ? "Edit" : "New")</span>
                    </div>
                    <h1 class="page-title">@(IsEditMode ? "Edit incident" : "Report an incident")</h1>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="card"><div class="st-loading"><span class="spin"></span> Loading…</div></div>
        }
        else
        {
            <EditForm Model="incident" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="() => submitted = true" class="st-form">
                <DataAnnotationsValidator />
                <div class="card">
                    <div class="card-body">
                        <div class="field">
                            <label class="field-label" for="i-entity">Affected entity <b>*</b></label>
                            <EntityPicker Id="i-entity" Entities="@entities" Value="@incident.EntityId" ValueChanged="OnEntityChanged"
                                          UnhealthyFirst="true" Placeholder="Choose the entity that is affected" />
                            @if (submitted && string.IsNullOrEmpty(incident.EntityId))
                            {
                                <span class="field-error">Choose the affected entity.</span>
                            }
                            else
                            {
                                <span class="field-help">Entities that are not online are listed first.</span>
                            }
                        </div>

                        <div class="field">
                            <label class="field-label" for="i-title">Title <b>*</b></label>
                            <InputText class="input" id="i-title" maxlength="200" @bind-Value="incident.Title" placeholder="What is broken, in one line" />
                            <ValidationMessage For="() => incident.Title" />
                        </div>

                        <div class="field">
                            <span class="field-label">Severity <b>*</b></span>
                            <div class="st-sev" role="radiogroup" aria-label="Severity">
                                @foreach (var (sev, hint) in SeverityOptions)
                                {
                                    var s = sev;
                                    <button type="button" class="st-sev-opt @StatusUi.Cls(s) @(incident.Severity == s ? "is-on" : "")" role="radio"
                                            aria-checked="@(incident.Severity == s ? "true" : "false")" @onclick="() => incident.Severity = s">
                                        <span class="st-sev-name"><i></i>@s</span>
                                        <small>@hint</small>
                                    </button>
                                }
                            </div>
                        </div>

                        @if (IsEditMode)
                        {
                            <div class="field">
                                <label class="field-label" for="i-status">Status</label>
                                <InputSelect class="select" id="i-status" @bind-Value="incident.Status">
                                    @foreach (var s in StatusUi.Flow)
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </InputSelect>
                                <span class="field-help">Changing the status here does not post a timeline update. Use the incident page to post one.</span>
                            </div>
                        }

                        <div class="field">
                            <label class="field-label" for="i-desc">What is happening <b>*</b></label>
                            <InputTextArea class="textarea" id="i-desc" rows="4" maxlength="4000" @bind-Value="incident.Description"
                                           placeholder="Symptoms, error messages, when it started" />
                            <ValidationMessage For="() => incident.Description" />
                        </div>

                        <div class="field">
                            <label class="field-label" for="i-impact">Impact</label>
                            <InputTextArea class="textarea" id="i-impact" rows="2" maxlength="1000" @bind-Value="incident.ImpactDescription"
                                           placeholder="Who or what is affected, and how badly" />
                        </div>

                        @if (IsEditMode && incident.Status == IncidentStatus.Resolved)
                        {
                            <div class="field">
                                <label class="field-label" for="i-resolution">Resolution</label>
                                <InputTextArea class="textarea" id="i-resolution" rows="3" maxlength="2000" @bind-Value="incident.ResolutionDetails"
                                               placeholder="Root cause and the fix" />
                            </div>
                        }

                        <div class="st-form-grid">
                            <div class="field">
                                <label class="field-label" for="i-start">Started at</label>
                                <input class="input input-mono" id="i-start" type="datetime-local" @bind="startedLocal" @bind:format="yyyy-MM-ddTHH:mm" />
                                <span class="field-help">@(IsEditMode ? "Local time." : "Defaults to now. Local time.")</span>
                            </div>
                            <div class="field">
                                <label class="field-label" for="i-assign">Assign to</label>
                                <InputText class="input" id="i-assign" maxlength="200" @bind-Value="incident.AssignedTo" placeholder="Name or email" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="i-rep">Reported by</label>
                                <InputText class="input" id="i-rep" maxlength="200" @bind-Value="incident.ReportedBy" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="i-ext">External reference</label>
                                <InputText class="input input-mono" id="i-ext" maxlength="100" @bind-Value="incident.ExternalIncidentId" placeholder="OPS-1234" />
                                <span class="field-help">Jira, ServiceNow or vendor ticket.</span>
                            </div>
                        </div>

                        @if (errorMessage is not null)
                        {
                            <div class="form-error" role="alert">@errorMessage</div>
                        }
                    </div>
                    <div class="st-form-foot">
                        <span class="st-form-hint">@(IsEditMode ? "" : "It appears on the incidents list and on the entity's page.")</span>
                        <a class="btn btn-ghost" href="@BackHref">Cancel</a>
                        <button class="btn btn-primary" type="submit" disabled="@isSubmitting" @onclick="() => submitted = true">
                            @if (isSubmitting) { <span class="spin"></span> }
                            @(isSubmitting ? (IsEditMode ? "Saving…" : "Reporting…") : (IsEditMode ? "Save changes" : "Report incident"))
                        </button>
                    </div>
                </div>

                <div class="st-col">
                    @if (SelectedEntity is not null)
                    {
                        var e = SelectedEntity;
                        var st = StatusUi.Current(e);
                        var open = entityIncidents.Where(i => i.Status != IncidentStatus.Resolved && i.Id != incident.Id).ToList();
                        var last = entityIncidents.Where(i => i.Id != incident.Id).OrderByDescending(i => i.StartedAt).FirstOrDefault();
                        <div class="card">
                            <div class="card-head">
                                <span class="st-tile-sm">@StatusUi.TypeSvg(e.EntityType, 13)</span>
                                <h3 class="card-title" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@e.Name</h3>
                            </div>
                            <div class="card-body">
                                <div class="st-status is-lg @StatusUi.Cls(st)" style="margin-bottom:12px"><span class="st-dot @(StatusUi.IsUnhealthy(st) ? "is-live" : "")"></span> @StatusUi.Label(st)
                                    @if (StatusUi.Latest(e)?.CheckedAt is DateTime at) { <span class="st-muted" style="font-weight:400;font-size:12px">· checked @StatusUi.When(at)</span> }
                                </div>
                                <dl class="st-dl">
                                    <dt>Type</dt><dd>@StatusUi.TypeLabel(e.EntityType)@(string.IsNullOrWhiteSpace(e.Group) || e.Group == "Default" ? "" : $" · {e.Group}")</dd>
                                    @if (!string.IsNullOrWhiteSpace(e.Owner)) { <dt>Owner</dt><dd>@e.Owner</dd> }
                                    @if (e.IsCritical) { <dt>Critical</dt><dd>Yes</dd> }
                                    <dt>Open incidents</dt>
                                    <dd>
                                        @if (!open.Any()) { <span class="st-muted">None</span> }
                                        else
                                        {
                                            @foreach (var o in open.Take(3))
                                            {
                                                <div><a href="@($"status/incidents/{o.Id}{queryParam}")">@o.Title</a></div>
                                            }
                                        }
                                    </dd>
                                    <dt>Last incident</dt>
                                    <dd>@if (last is null) { <span class="st-muted">None</span> } else { <a href="@($"status/incidents/{last.Id}{queryParam}")">@last.Title</a><span class="st-muted"> · @StatusUi.When(last.StartedAt)</span> }</dd>
                                </dl>
                                @if (open.Any() && !IsEditMode)
                                {
                                    <div class="st-callout is-warning st-callout-gap">@StatusUi.Icon("alert", 14)<div>This entity already has @StatusUi.Plural(open.Count, "open incident"). Post an update there if it's the same problem.</div></div>
                                }
                            </div>
                        </div>
                    }
                    <div class="st-callout is-info">
                        @StatusUi.Icon("info", 14)
                        <div><b>Choosing a severity.</b> Critical: sales, stores or customer data at risk. High: a store or team is blocked. Medium: degraded with a workaround. Low: minor, no one is blocked.</div>
                    </div>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public string? IncidentId { get; set; }
    [SupplyParameterFromQuery(Name = "entity")] public string? PrefillEntityId { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Incident incident = new();
    private List<MonitoredAsset> entities = new();
    private List<Incident> entityIncidents = new();
    private DateTime? startedLocal;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool submitted;
    private string? errorMessage;

    private static readonly (IncidentSeverity, string)[] SeverityOptions =
    {
        (IncidentSeverity.Low, "Minor, no one is blocked"),
        (IncidentSeverity.Medium, "Degraded, workaround exists"),
        (IncidentSeverity.High, "A store or team is blocked"),
        (IncidentSeverity.Critical, "Sales or data at risk"),
    };

    private string queryParam => StateContainer.Company is null ? "" : $"?c={StateContainer.Company.Id}";
    private bool IsEditMode => !string.IsNullOrEmpty(IncidentId);
    private string BackHref => IsEditMode ? $"status/incidents/{IncidentId}{queryParam}" : $"status/incidents{queryParam}";
    private MonitoredAsset? SelectedEntity => entities.FirstOrDefault(e => e.Id == incident.EntityId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var companyId = StateContainer.Company?.Id ?? "";
            entities = (await EntityService.GetEntitiesWithLatestStatusAsync(companyId)).Where(e => e.IsActive || IsEditMode).ToList();

            if (IsEditMode)
            {
                var loaded = await IncidentService.GetIncidentAsync(IncidentId!);
                if (loaded != null) incident = loaded;
                else errorMessage = "Incident not found.";
            }
            else
            {
                incident.Severity = IncidentSeverity.Medium;
                incident.Status = IncidentStatus.Open;
                incident.StartedAt = DateTime.UtcNow;
                if (AuthState is not null) incident.ReportedBy = (await AuthState).User.Identity?.Name;
                if (!string.IsNullOrEmpty(PrefillEntityId) && entities.Any(e => e.Id == PrefillEntityId))
                    incident.EntityId = PrefillEntityId;
            }

            startedLocal = incident.StartedAt.HasValue ? StatusUi.Local(incident.StartedAt.Value) : null;
            await LoadEntityIncidents();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load the form: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnEntityChanged(string id)
    {
        incident.EntityId = id;
        await LoadEntityIncidents();
    }

    private async Task LoadEntityIncidents()
    {
        entityIncidents = string.IsNullOrEmpty(incident.EntityId)
            ? new()
            : await IncidentService.GetIncidentsByEntityAsync(incident.EntityId);
    }

    private async Task HandleValidSubmit()
    {
        if (isSubmitting) return;
        submitted = true;
        errorMessage = null;
        if (string.IsNullOrEmpty(incident.EntityId)) return;

        isSubmitting = true;
        try
        {
            incident.StartedAt = startedLocal.HasValue
                ? DateTime.SpecifyKind(startedLocal.Value, DateTimeKind.Local).ToUniversalTime()
                : incident.StartedAt ?? DateTime.UtcNow;
            if (incident.Status == IncidentStatus.Resolved) incident.ResolvedAt ??= DateTime.UtcNow;
            else incident.ResolvedAt = null;

            if (IsEditMode)
            {
                if (await IncidentService.UpdateIncidentAsync(incident))
                    Navigation.NavigateTo($"/status/incidents/{incident.Id}{queryParam}");
                else
                    errorMessage = "The incident could not be saved. Check the fields and try again.";
            }
            else
            {
                var created = await IncidentService.CreateIncidentAsync(StateContainer.Company?.Id ?? "", incident);
                if (created != null)
                    Navigation.NavigateTo($"/status/incidents/{created.Id}{queryParam}");
                else
                    errorMessage = "The incident could not be reported. Check the fields and try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"The incident could not be saved: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
