@page "/status/entities/create"
@page "/status/entities/{AssetId}/edit"
@using Application.Shared.Enums
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject NavigationManager Navigation
@inject MonitoredAssetClientService EntityService
@inject StateContainer StateContainer
@attribute [Authorize(Policy = PolicyNames.StatusWrite)]

<PageTitle>@(IsEditMode ? $"Edit {entity?.Name}" : "New entity") · Status</PageTitle>

@* Styles: Application/wwwroot/status.css (.st-form*). Dependencies are edited on their own page
   (/status/entities/{id}/dependencies) so the impact tree stays in view; this form only links there. *@
<div class="sc">
    <div class="page-wrap st-wrap st-wrap-narrow">
        <div class="st-head">
            <div class="st-head-left">
                <a class="st-back" href="@BackHref" title="Back" aria-label="Back">@StatusUi.Icon("arrow-left", 16)</a>
                <div class="st-head-main">
                    <div class="st-crumbs">
                        <a href="@($"status/entities{queryParam}")">Entities</a>
                        @if (IsEditMode && entity is not null)
                        {
                            @StatusUi.Icon("chev-right", 12)<a href="@BackHref">@entity.Name</a>
                        }
                        @StatusUi.Icon("chev-right", 12)<span>@(IsEditMode ? "Edit" : "New")</span>
                    </div>
                    <div class="st-title-row">
                        <h1 class="page-title">@(IsEditMode ? "Edit entity" : "New entity")</h1>
                        <span class="badge badge-neutral">@StatusUi.TypeLabel(formModel.EntityType)</span>
                    </div>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="card"><div class="st-loading"><span class="spin"></span> Loading…</div></div>
        }
        else if (IsEditMode && entity is null)
        {
            <div class="card">
                <div class="empty">
                    <div class="empty-title">Entity not found</div>
                    <a class="btn btn-secondary btn-sm" href="@($"status/entities{queryParam}")">Back to entities</a>
                </div>
            </div>
        }
        else
        {
            <form class="st-form" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true" novalidate>
                <div class="card">
                    <div class="card-body">
                        <div class="st-section-title">Identity</div>
                        <div class="st-form-grid">
                            <div class="field">
                                <label class="field-label" for="f-name">Name <b>*</b></label>
                                <input class="input @(showErrors && string.IsNullOrWhiteSpace(formModel.Name) ? "invalid" : "")" id="f-name" maxlength="200" @bind="formModel.Name" @bind:event="oninput" />
                                @if (showErrors && string.IsNullOrWhiteSpace(formModel.Name)) { <span class="field-error">Give the entity a name.</span> }
                            </div>
                            <div class="field">
                                <label class="field-label" for="f-type">Type <b>*</b></label>
                                <select class="select" id="f-type" @bind="formModel.EntityType">
                                    @foreach (var t in Enum.GetValues<AssetType>())
                                    {
                                        <option value="@t">@StatusUi.TypeLabel(t)</option>
                                    }
                                </select>
                            </div>
                            <div class="field is-span">
                                <label class="field-label" for="f-desc">Description</label>
                                <textarea class="textarea" id="f-desc" rows="2" maxlength="1000" @bind="formModel.Description"></textarea>
                                <span class="field-help">Shown under the name on lists and the status board.</span>
                            </div>
                            <div class="field">
                                <label class="field-label" for="f-group">Group</label>
                                <input class="input" id="f-group" list="st-groups" maxlength="200" @bind="formModel.Group" />
                                <datalist id="st-groups">
                                    @foreach (var g in groups) { <option value="@g"></option> }
                                </datalist>
                                <span class="field-help">Pick an existing group or type a new one.</span>
                            </div>
                            <div class="field">
                                <label class="field-label" for="f-owner">Owner</label>
                                <input class="input" id="f-owner" maxlength="200" @bind="formModel.Owner" placeholder="Team or person" />
                            </div>
                        </div>

                        <div class="st-section-title">Where it runs</div>
                        <div class="st-form-grid">
                            <div class="field is-span">
                                <label class="field-label" for="f-url">URL or host</label>
                                <input class="input input-mono" id="f-url" maxlength="500" @bind="formModel.Url" placeholder="https://… or host:port" />
                                <span class="field-help">Used by the ping job for health checks. Power BI dataset URLs also enable the refresh panel.</span>
                            </div>
                            <div class="field">
                                <label class="field-label" for="f-version">Version</label>
                                <input class="input" id="f-version" maxlength="100" @bind="formModel.Version" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="f-loc">Location</label>
                                <input class="input" id="f-loc" maxlength="500" @bind="formModel.Location" placeholder="Data centre, region or rack" />
                            </div>
                        </div>

                        <div class="st-section-title">Metadata</div>
                        <div class="field" style="margin-bottom:0">
                            <label class="field-label" for="f-meta">JSON</label>
                            <textarea class="textarea textarea-mono @(MetadataError is not null && showErrors ? "invalid" : "")" id="f-meta" rows="5" maxlength="4000"
                                      placeholder="@("{ \"key\": \"value\" }")" @bind="formModel.Metadata" @bind:event="oninput"></textarea>
                            @if (MetadataError is not null && showErrors)
                            {
                                <span class="field-error">@MetadataError</span>
                            }
                            else
                            {
                                <span class="field-help">Optional and free-form. Checked as JSON before saving.</span>
                            }
                        </div>

                        @if (errorMessage is not null)
                        {
                            <div class="form-error" role="alert">@errorMessage</div>
                        }
                    </div>
                    <div class="st-form-foot">
                        <span class="st-form-hint">
                            @if (IsEditMode && entity?.ModifiedOn is not null) { <span>Last saved @StatusUi.FullWhen(entity.ModifiedOn)</span> }
                            else if (!IsEditMode) { <span>You can add dependencies and people after creating it.</span> }
                        </span>
                        <a class="btn btn-ghost" href="@BackHref">Cancel</a>
                        <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
                            @if (isSubmitting) { <span class="spin"></span> }
                            @(isSubmitting ? (IsEditMode ? "Saving…" : "Creating…") : (IsEditMode ? "Save changes" : "Create entity"))
                        </button>
                    </div>
                </div>

                <div class="st-col">
                    <div class="card">
                        <div class="card-head"><h3 class="card-title">Monitoring</h3></div>
                        <div class="card-body">
                            <button type="button" class="st-check" role="switch" aria-checked="@(formModel.IsActive ? "true" : "false")" @onclick="() => formModel.IsActive = !formModel.IsActive">
                                <span class="switch @(formModel.IsActive ? "is-on" : "")"></span>
                                <span><b>Active</b><small>Checked by the ping job and shown on the status board. Turn off to keep the entity without monitoring it.</small></span>
                            </button>
                            <button type="button" class="st-check" style="margin-bottom:0" role="switch" aria-checked="@(formModel.IsCritical ? "true" : "false")" @onclick="() => formModel.IsCritical = !formModel.IsCritical">
                                <span class="switch @(formModel.IsCritical ? "is-on" : "")"></span>
                                <span><b>Critical</b><small>Marked critical on every list and counted first on the overview and in impact summaries.</small></span>
                            </button>
                        </div>
                    </div>

                    @if (IsEditMode)
                    {
                        <div class="card">
                            <div class="card-head">
                                <h3 class="card-title">Dependencies</h3>
                                <span class="tab-count">@dependencies.Count</span>
                                <span class="st-card-spacer"></span>
                                <a class="st-link" href="@($"status/entities/{AssetId}/dependencies{queryParam}")">Manage</a>
                            </div>
                            @if (!dependencies.Any())
                            {
                                <div class="st-deps-empty">No dependencies yet.</div>
                            }
                            else
                            {
                                <ul class="st-deps">
                                    @foreach (var d in dependencies.OrderBy(d => d.Order))
                                    {
                                        var target = allEntities.FirstOrDefault(e => e.Id == d.DependsOnEntityId);
                                        <li>
                                            <span class="st-tile-sm">@StatusUi.TypeSvg(target?.EntityType ?? d.DependencyType ?? AssetType.Server, 12)</span>
                                            <div class="st-deps-name">
                                                <a href="@($"status/entities/{d.DependsOnEntityId}{queryParam}")">@(target?.Name ?? d.DependsOnEntity?.Name ?? "Unknown entity")</a>
                                                <small>@(string.IsNullOrWhiteSpace(d.Description) ? (target is null ? "" : StatusUi.TypeLabel(target.EntityType)) : d.Description)</small>
                                            </div>
                                            @if (d.IsCritical) { <span class="badge badge-danger dl-mini-badge">Critical</span> }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <div class="card">
                            <div class="card-head"><h3 class="card-title">Danger zone</h3></div>
                            <div class="card-body st-btn-stack">
                                <button class="btn btn-secondary st-btn-danger-outline" type="button" @onclick="DeleteEntity">@StatusUi.Icon("trash", 14) Delete entity…</button>
                                <span class="field-help">Removes it from monitoring and the status board. Its history and incidents stay in the database.</span>
                            </div>
                        </div>
                    }
                </div>
            </form>
        }
    </div>

    <StatusConfirm @ref="confirm" />
    <StatusToast @ref="toast" />
</div>

@code {
    [Parameter] public string? AssetId { get; set; }

    private MonitoredAsset formModel = new() { IsActive = true, IsCritical = false, EntityType = AssetType.Server, Group = null };
    private MonitoredAsset? entity;
    private List<MonitoredAsset> allEntities = new();
    private List<AssetDependency> dependencies = new();
    private List<string> groups = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private bool showErrors;
    private string? errorMessage;

    private StatusConfirm confirm = default!;
    private StatusToast toast = default!;

    private bool IsEditMode => !string.IsNullOrEmpty(AssetId);
    private string queryParam => StateContainer.Company is null ? "" : $"?c={StateContainer.Company.Id}";
    private string BackHref => IsEditMode ? $"status/entities/{AssetId}{queryParam}" : $"status/entities{queryParam}";

    private string? MetadataError
    {
        get
        {
            if (string.IsNullOrWhiteSpace(formModel.Metadata)) return null;
            try { using var _ = JsonDocument.Parse(formModel.Metadata); return null; }
            catch (JsonException ex) { return $"Not valid JSON: {ex.Message.Split('.').FirstOrDefault()}."; }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var companyId = StateContainer.Company?.Id ?? "";
        try
        {
            var groupsTask = EntityService.GetEntityGroupsAsync(companyId);
            var entitiesTask = EntityService.GetEntitiesAsync(companyId);
            if (IsEditMode)
            {
                entity = await EntityService.GetEntityAsync(AssetId!);
                if (entity != null)
                {
                    formModel = new MonitoredAsset
                    {
                        Id = entity.Id,
                        Name = entity.Name,
                        Description = entity.Description,
                        EntityType = entity.EntityType,
                        Url = entity.Url,
                        Version = entity.Version,
                        Owner = entity.Owner,
                        Location = entity.Location,
                        Group = entity.Group,
                        IsActive = entity.IsActive,
                        IsCritical = entity.IsCritical,
                        Metadata = entity.Metadata,
                        CompanyId = entity.CompanyId
                    };
                    dependencies = await EntityService.GetEntityDependenciesAsync(AssetId!);
                }
            }
            await Task.WhenAll(groupsTask, entitiesTask);
            groups = groupsTask.Result.Where(g => !string.IsNullOrWhiteSpace(g)).OrderBy(g => g).ToList();
            allEntities = entitiesTask.Result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading entity form: {ex.Message}");
            errorMessage = "Could not load the entity. Reload the page to try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (isSubmitting) return;
        showErrors = true;
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(formModel.Name) || MetadataError is not null) return;

        isSubmitting = true;
        var companyId = StateContainer.Company?.Id ?? "";
        formModel.Name = formModel.Name.Trim();
        formModel.Group = string.IsNullOrWhiteSpace(formModel.Group) ? "Default" : formModel.Group.Trim();
        try
        {
            if (IsEditMode)
            {
                if (await EntityService.UpdateEntityAsync(formModel))
                    Navigation.NavigateTo($"/status/entities/{formModel.Id}{queryParam}");
                else
                    errorMessage = "The entity could not be saved. Check the fields and try again.";
            }
            else
            {
                formModel.CompanyId = companyId;
                var created = await EntityService.CreateEntityAsync(companyId, formModel);
                if (created != null)
                    Navigation.NavigateTo($"/status/entities/{created.Id}{queryParam}");
                else
                    errorMessage = "The entity could not be created. Check the fields and try again.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving entity: {ex.Message}");
            errorMessage = $"The entity could not be saved: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteEntity()
    {
        if (entity is null) return;
        if (!await confirm.Ask($"Delete {entity.Name}?", "It is removed from monitoring and the status board. Its history and incidents stay in the database.")) return;
        if (await EntityService.DeleteEntityAsync(entity.Id))
            Navigation.NavigateTo($"/status/entities{queryParam}");
        else
            toast.Show("Could not delete the entity. Try again.", error: true);
    }
}
