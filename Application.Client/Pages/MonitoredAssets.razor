@page "/status/entities"
@using Application.Shared.Enums
@using System.Threading
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject MonitoredAssetClientService EntityService
@inject StatusOverviewClientService OverviewService
@inject NavigationManager Navigation
@inject StateContainer StateContainer
@attribute [Authorize(Policy = PolicyNames.StatusRead)]

<PageTitle>Status Entities</PageTitle>

@* List recipe from datalist.css (.dl-*), status pieces from status.css (.st-*). *@
<div class="sc">
    <div class="page-wrap dl-wrap">
        <div class="dl-head">
            <div class="page-header">
                <h1 class="page-title">Entities</h1>
                <p class="page-subtitle">
                    @if (summaryTotal is null)
                    {
                        <span class="skeleton st-skel-line" style="display:inline-block;width:160px;vertical-align:middle"></span>
                    }
                    else
                    {
                        <span>@StatusUi.Plural(summaryTotal.Value, "entity", "entities")</span>
                        @if (Count("Offline") + Count("Error") > 0) { <span class="dl-sep">·</span><span>@(Count("Offline") + Count("Error")) down</span> }
                        @if (Count("Degraded") > 0) { <span class="dl-sep">·</span><span>@Count("Degraded") degraded</span> }
                        @if (groups.Any()) { <span class="dl-sep">·</span><span>@StatusUi.Plural(groups.Count, "group")</span> }
                    }
                </p>
            </div>
            <AuthorizeView Roles="@writeRoles">
                <Authorized>
                    <div class="dl-head-actions">
                        <button class="btn btn-primary" type="button" @onclick="CreateEntity">@StatusUi.Icon("plus", 16) New entity</button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="card dl-card">
            <div class="dl-toolbar">
                <div class="dl-search">
                    @StatusUi.Icon("search", 14)
                    <input class="input" type="search" placeholder="Search name, owner, location…" aria-label="Search entities"
                           value="@searchText" @oninput="OnSearchInput" />
                </div>
                <div class="dl-seg" role="group" aria-label="Filter by status">
                    @foreach (var (key, label) in StatusSegments)
                    {
                        var k = key;
                        if (k != "" && Count(k) == 0 && statusFilter != k) continue;
                        <button type="button" class="dl-seg-btn @(statusFilter == k ? "is-active" : "")" @onclick="() => SetStatus(k)">
                            @label
                            @if (summaryTotal is not null) { <span class="dl-seg-count">@(k == "" ? summaryTotal : Count(k))</span> }
                        </button>
                    }
                </div>
                <select class="select" aria-label="Type" @bind="typeFilter" @bind:after="ApplyFilters">
                    <option value="">All types</option>
                    @foreach (var t in Enum.GetValues<AssetType>())
                    {
                        <option value="@t">@StatusUi.TypeLabel(t)</option>
                    }
                </select>
                @if (groups.Any())
                {
                    <select class="select" aria-label="Group" @bind="groupFilter" @bind:after="ApplyFilters">
                        <option value="">All groups</option>
                        @foreach (var g in groups)
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                }
                <select class="select" aria-label="Active" @bind="activeFilter" @bind:after="ApplyFilters">
                    <option value="">Active and inactive</option>
                    <option value="active">Active only</option>
                    <option value="inactive">Inactive only</option>
                </select>
                <button type="button" class="dl-seg-btn st-toggle-btn is-danger @(criticalOnly ? "is-active" : "")" aria-pressed="@(criticalOnly ? "true" : "false")" @onclick="ToggleCritical">
                    @StatusUi.Icon("shield", 13) Critical only
                </button>
                <div class="dl-toolbar-spacer"></div>
                @if (HasActiveFilters)
                {
                    <button type="button" class="dl-seg-btn" @onclick="ClearFilters">@StatusUi.Icon("x", 13) Clear</button>
                }
            </div>

            <div class="dl-table-wrap">
                <table class="dl-table" aria-busy="@(isLoading ? "true" : "false")">
                    <colgroup>
                        <col /><col style="width:130px" /><col style="width:150px" /><col style="width:170px" />
                        <col style="width:150px" /><col style="width:110px" /><col style="width:140px" /><col style="width:112px" />
                    </colgroup>
                    <thead>
                        <tr>
                            @SortHeader("Entity", "name")
                            @SortHeader("Type", "type")
                            @SortHeader("Group", "group")
                            @SortHeader("Status", "status")
                            <th class="dl-th">Last 7 days</th>
                            <th class="dl-th dl-th-num">Uptime 30d</th>
                            @SortHeader("Owner", "owner")
                            <th class="dl-th dl-th-actions"><span class="dl-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && !pageData.Items.Any())
                        {
                            @for (var i = 0; i < 6; i++)
                            {
                                <tr class="dl-row dl-row-skel">
                                    <td class="dl-td"><div class="dl-ident"><span class="skeleton dl-skel-tile"></span><div style="flex:1"><div class="skeleton dl-skel" style="width:55%"></div><div class="skeleton dl-skel" style="width:80%;margin-top:6px;height:10px"></div></div></div></td>
                                    @for (var c = 0; c < 6; c++) { <td class="dl-td"><div class="skeleton dl-skel" style="width:70%"></div></td> }
                                    <td class="dl-td"></td>
                                </tr>
                            }
                        }
                        else if (!pageData.Items.Any())
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="empty">
                                        <div class="dl-empty-icon">@StatusUi.Icon("inbox", 20)</div>
                                        <div class="empty-title">No entities found</div>
                                        <div class="empty-text">@(HasActiveFilters ? "Nothing matches these filters." : "Add the servers, databases, pipelines and reports you want to watch.")</div>
                                        @if (HasActiveFilters)
                                        {
                                            <button class="btn btn-secondary btn-sm" type="button" @onclick="ClearFilters">Clear filters</button>
                                        }
                                        else
                                        {
                                            <AuthorizeView Roles="@writeRoles" Context="emptyCtx">
                                                <Authorized><button class="btn btn-primary btn-sm" type="button" @onclick="CreateEntity">New entity</button></Authorized>
                                            </AuthorizeView>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var entity in pageData.Items)
                            {
                                var e = entity;
                                var latest = StatusUi.Latest(e);
                                var status = latest?.Status ?? AssetStatus.Unknown;
                                overviewById.TryGetValue(e.Id, out var ov);
                                <tr class="dl-row @(e.IsActive ? "" : "st-row-muted")" tabindex="0" @onclick="() => ViewEntity(e.Id)" @onkeydown="@(k => OnRowKey(k, e.Id))">
                                    <td class="dl-td">
                                        <div class="dl-ident">
                                            <span class="dl-tile">@StatusUi.TypeSvg(e.EntityType, 16)</span>
                                            <div class="dl-ident-text">
                                                <div class="dl-name-row">
                                                    <span class="dl-name">@e.Name</span>
                                                    @if (e.IsCritical) { <span class="badge badge-danger dl-mini-badge">Critical</span> }
                                                    @if (!e.IsActive) { <span class="badge badge-neutral dl-mini-badge">Inactive</span> }
                                                </div>
                                                <div class="dl-desc" title="@e.Description">@(string.IsNullOrWhiteSpace(e.Description) ? (e.Url ?? "No description") : e.Description)</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="dl-td"><span class="dl-cell-main">@StatusUi.TypeLabel(e.EntityType)</span></td>
                                    <td class="dl-td"><span class="dl-cell-main">@(string.IsNullOrWhiteSpace(e.Group) ? "—" : e.Group)</span></td>
                                    <td class="dl-td">
                                        @if (!e.IsActive)
                                        {
                                            <div class="st-status s-unknown"><span class="st-dot"></span> Not monitored</div>
                                        }
                                        else
                                        {
                                            <div class="st-status @StatusUi.Cls(status)"><span class="st-dot @(StatusUi.IsUnhealthy(status) ? "is-live" : "")"></span> @StatusUi.Label(status)</div>
                                        }
                                        <div class="dl-cell-sub" title="@latest?.StatusMessage">
                                            @if (latest is null) { <span>no checks yet</span> }
                                            else
                                            {
                                                @(latest.ResponseTime.HasValue ? $"{StatusUi.Ms(latest.ResponseTime)} · " : "")@StatusUi.When(latest.CheckedAt)
                                            }
                                        </div>
                                    </td>
                                    <td class="dl-td st-strip-cell">
                                        @if (ov is not null) { <AvailabilityStrip Days="@StatusUi.LastDays(ov.Days, 7)" Size="xs" Name="@e.Name" /> }
                                        else { <span class="dl-na">—</span> }
                                    </td>
                                    <td class="dl-td dl-td-num">
                                        @if (ov is not null && StatusUi.HasData(ov))
                                        {
                                            <span class="dl-num st-uptime @StatusUi.UptimeCls(ov.UptimePercent)">@ov.UptimePercent.ToString("0.0")<span class="dl-unit">%</span></span>
                                        }
                                        else { <span class="dl-na">—</span> }
                                    </td>
                                    <td class="dl-td"><span class="dl-cell-main">@(string.IsNullOrWhiteSpace(e.Owner) ? "—" : e.Owner)</span></td>
                                    <td class="dl-td dl-td-actions" @onclick:stopPropagation="true">
                                        <div class="dl-actions">
                                            <button class="dl-act" type="button" title="Dependencies" aria-label="Dependencies of @e.Name" @onclick="() => Dependencies(e.Id)">@StatusUi.Icon("branch", 14)</button>
                                            <AuthorizeView Roles="@writeRoles" Context="writeCtx">
                                                <Authorized>
                                                    <button class="dl-act" type="button" title="Edit" aria-label="Edit @e.Name" @onclick="() => EditEntity(e.Id)">@StatusUi.Icon("edit", 14)</button>
                                                    <button class="dl-act dl-act-danger" type="button" title="Delete" aria-label="Delete @e.Name" @onclick="() => DeleteEntity(e)">@StatusUi.Icon("trash", 14)</button>
                                                </Authorized>
                                            </AuthorizeView>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="dl-footer">
                <div class="dl-footer-text">
                    @if (pageData.TotalCount == 0)
                    {
                        <span>No results</span>
                    }
                    else
                    {
                        <span>Showing <strong>@FromRow–@ToRow</strong> of <strong>@pageData.TotalCount</strong></span>
                    }
                    <span class="dl-sep">·</span>
                    <select class="select" aria-label="Rows per page" @bind="pageSize" @bind:after="OnPageSizeChanged">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span> per page</span>
                </div>
                @if (pageData.TotalPages > 1)
                {
                    <div class="dl-pager">
                        <button class="dl-page-btn" type="button" disabled="@(!pageData.HasPrevious)" @onclick="() => GoToPage(pageData.Page - 1)">Prev</button>
                        @if (PageNumbers().First() > 1)
                        {
                            <button class="dl-page-btn" type="button" @onclick="() => GoToPage(1)">1</button>
                            <span class="dl-page-gap">…</span>
                        }
                        @foreach (var n in PageNumbers())
                        {
                            var p = n;
                            <button class="dl-page-btn @(p == pageData.Page ? "is-active" : "")" type="button" @onclick="() => GoToPage(p)">@p</button>
                        }
                        @if (PageNumbers().Last() < pageData.TotalPages)
                        {
                            <span class="dl-page-gap">…</span>
                            <button class="dl-page-btn" type="button" @onclick="() => GoToPage(pageData.TotalPages)">@pageData.TotalPages</button>
                        }
                        <button class="dl-page-btn" type="button" disabled="@(!pageData.HasNext)" @onclick="() => GoToPage(pageData.Page + 1)">Next</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <StatusConfirm @ref="confirm" />
    <StatusToast @ref="toast" />
</div>

@code {
    private PagedResult<MonitoredAsset> pageData = new();
    private List<string> groups = new();
    private Dictionary<string, int> summary = new();
    private int? summaryTotal;
    private Dictionary<string, StatusOverviewEntity> overviewById = new();
    private bool isLoading = true;

    private StatusConfirm confirm = default!;
    private StatusToast toast = default!;

    private readonly EntityQueryParameters query = new() { Page = 1, PageSize = 10, SortBy = "name", SortDir = "asc" };

    private string searchText = "";
    private string typeFilter = "";
    private string statusFilter = "";
    private string activeFilter = "";
    private string groupFilter = "";
    private bool criticalOnly;
    private int pageSize = 10;
    private CancellationTokenSource? searchCts;

    private static readonly (string key, string label)[] StatusSegments =
    {
        ("", "All"), ("Online", "Online"), ("Degraded", "Degraded"), ("Offline", "Offline"),
        ("Error", "Error"), ("Maintenance", "Maintenance"), ("Unknown", "Unknown")
    };

    private int Count(string status) => summary.GetValueOrDefault(status, 0);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchText) || !string.IsNullOrEmpty(typeFilter) ||
        !string.IsNullOrEmpty(statusFilter) || !string.IsNullOrEmpty(activeFilter) ||
        !string.IsNullOrEmpty(groupFilter) || criticalOnly;

    private int FromRow => pageData.TotalCount == 0 ? 0 : (pageData.Page - 1) * pageData.PageSize + 1;
    private int ToRow => Math.Min(pageData.Page * pageData.PageSize, pageData.TotalCount);

    private string queryParam => StateContainer.Company is null ? "" : $"?c={StateContainer.Company.Id}";

    // Status write actions require the company INCIDENTS role (ADMIN always allowed).
    private string writeRoles => $"{StateContainer.Company?.Id}_INCIDENTS,{StateContainer.Company?.Id}_ADMIN";

    protected override async Task OnInitializedAsync()
    {
        var companyId = StateContainer.Company?.Id;
        if (!string.IsNullOrEmpty(companyId))
        {
            var pageTask = LoadPage();
            await LoadSideData(companyId);
            await pageTask;
        }
        else isLoading = false;
    }

    private async Task LoadSideData(string companyId)
    {
        var groupsTask = EntityService.GetEntityGroupsAsync(companyId);
        var summaryTask = EntityService.GetEntityStatusSummaryAsync(companyId);
        var overviewTask = OverviewService.GetOverviewAsync(companyId, 30);
        await Task.WhenAll(groupsTask, summaryTask, overviewTask);
        groups = groupsTask.Result.Where(g => !string.IsNullOrWhiteSpace(g)).ToList();
        summary = summaryTask.Result;
        summaryTotal = summary.Values.Sum();
        overviewById = overviewTask.Result?.Groups.SelectMany(g => g.Entities).GroupBy(e => e.EntityId)
                           .ToDictionary(g => g.Key, g => g.First()) ?? new();
    }

    private async Task LoadPage()
    {
        var companyId = StateContainer.Company?.Id;
        if (string.IsNullOrEmpty(companyId)) { isLoading = false; return; }

        isLoading = true;
        StateHasChanged();

        query.Search = string.IsNullOrWhiteSpace(searchText) ? null : searchText;
        query.Type = Enum.TryParse<AssetType>(typeFilter, out var t) ? t : null;
        query.CurrentStatus = Enum.TryParse<AssetStatus>(statusFilter, out var st) ? st : null;
        query.IsActive = activeFilter switch { "active" => true, "inactive" => false, _ => (bool?)null };
        query.Group = string.IsNullOrWhiteSpace(groupFilter) ? null : groupFilter;
        query.IsCritical = criticalOnly ? true : (bool?)null;

        pageData = await EntityService.GetEntitiesPagedAsync(companyId, query);
        isLoading = false;
        StateHasChanged();
    }

    private async Task ApplyFilters()
    {
        query.Page = 1;
        await LoadPage();
    }

    private async Task SetStatus(string s)
    {
        statusFilter = s;
        await ApplyFilters();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;
        try
        {
            await Task.Delay(350, token);
            if (!token.IsCancellationRequested) await ApplyFilters();
        }
        catch (TaskCanceledException) { /* superseded by a newer keystroke */ }
    }

    private async Task ToggleCritical()
    {
        criticalOnly = !criticalOnly;
        await ApplyFilters();
    }

    private async Task ClearFilters()
    {
        searchText = ""; typeFilter = ""; statusFilter = ""; activeFilter = ""; groupFilter = ""; criticalOnly = false;
        query.SortBy = "name"; query.SortDir = "asc";
        await ApplyFilters();
    }

    private async Task SortByColumn(string column)
    {
        if (query.SortBy == column) query.SortDir = query.SortDir == "asc" ? "desc" : "asc";
        else { query.SortBy = column; query.SortDir = "asc"; }
        query.Page = 1;
        await LoadPage();
    }

    private async Task GoToPage(int p)
    {
        if (p < 1 || p > pageData.TotalPages || p == pageData.Page) return;
        query.Page = p;
        await LoadPage();
    }

    private async Task OnPageSizeChanged()
    {
        query.PageSize = pageSize;
        query.Page = 1;
        await LoadPage();
    }

    private IEnumerable<int> PageNumbers()
    {
        const int window = 2;
        var start = Math.Max(1, pageData.Page - window);
        var end = Math.Min(pageData.TotalPages, pageData.Page + window);
        for (var i = start; i <= end; i++) yield return i;
    }

    private RenderFragment SortHeader(string label, string column) => __builder =>
    {
        var active = query.SortBy == column;
        var dir = active ? (query.SortDir == "asc" ? "ascending" : "descending") : "none";
        <th class="dl-th dl-th-sort @(active ? "is-active" : "")" aria-sort="@dir" @onclick="() => SortByColumn(column)">
            <span class="dl-th-inner">@label <span class="dl-sort-ico">@StatusUi.Icon(active ? (query.SortDir == "asc" ? "sort-asc" : "sort-desc") : "sort", 12)</span></span>
        </th>
    };

    private void OnRowKey(KeyboardEventArgs k, string id)
    {
        if (k.Key == "Enter") ViewEntity(id);
    }

    private void CreateEntity() => Navigation.NavigateTo($"/status/entities/create{queryParam}");
    private void ViewEntity(string id) => Navigation.NavigateTo($"/status/entities/{id}{queryParam}");
    private void EditEntity(string id) => Navigation.NavigateTo($"/status/entities/{id}/edit{queryParam}");
    private void Dependencies(string id) => Navigation.NavigateTo($"/status/entities/{id}/dependencies{queryParam}");

    private async Task DeleteEntity(MonitoredAsset entity)
    {
        if (!await confirm.Ask($"Delete {entity.Name}?", "The entity is removed from monitoring and the status board. Its history and incidents are kept, marked as deleted.")) return;
        if (await EntityService.DeleteEntityAsync(entity.Id))
        {
            // If we removed the last row on the page, step back a page so we don't land on an empty view.
            if (pageData.Items.Count == 1 && pageData.Page > 1) query.Page--;
            toast.Show($"Deleted {entity.Name}");
            await LoadPage();
            var companyId = StateContainer.Company?.Id;
            if (!string.IsNullOrEmpty(companyId)) await LoadSideData(companyId);
        }
        else
        {
            toast.Show($"Could not delete {entity.Name}. Try again.", error: true);
        }
    }
}
