@page "/status"
@using Application.Shared.Enums
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject MonitoredAssetClientService EntityService
@inject IncidentClientService IncidentService
@inject StatusOverviewClientService OverviewService
@inject NavigationManager Navigation
@inject StateContainer StateContainer
@attribute [Authorize(Policy = PolicyNames.StatusRead)]

<PageTitle>Status Overview</PageTitle>

@* Ops console for the status module. Styles: Application/wwwroot/status.css (.st-*). *@
<div class="sc">
    <div class="page-wrap st-wrap">
        <div class="st-head">
            <div class="page-header">
                <h1 class="page-title">Status overview</h1>
                <p class="page-subtitle">
                    @if (isLoading)
                    {
                        <span class="skeleton st-skel-line" style="display:inline-block;width:220px;vertical-align:middle"></span>
                    }
                    else
                    {
                        <span>@StatusUi.Plural(activeEntities.Count, "entity", "entities") monitored</span>
                        <span class="dl-sep">·</span>
                        <span>@StatusUi.Plural(attention.Count, "needs attention", "need attention")</span>
                        @if (overview is not null)
                        {
                            <span class="dl-sep">·</span><span>updated @StatusUi.When(overview.GeneratedAtUtc)</span>
                        }
                    }
                </p>
            </div>
            <div class="st-head-actions">
                <a class="btn btn-secondary" href="@($"status/board{queryParam}")">@StatusUi.Icon("activity", 14) Status board</a>
                <AuthorizeView Roles="@writeRoles">
                    <Authorized>
                        <a class="btn btn-primary" href="@($"status/incidents/create{queryParam}")">@StatusUi.Icon("plus", 14) Report incident</a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="st-kpis">
                @for (var i = 0; i < 6; i++)
                {
                    <div class="st-kpi"><div class="skeleton st-skel-line" style="width:60%"></div><div class="skeleton" style="height:22px;width:40%;margin-top:10px"></div></div>
                }
            </div>
        }
        else
        {
            var online = activeEntities.Count(e => StatusUi.Current(e) == AssetStatus.Online);
            var degraded = activeEntities.Count(e => StatusUi.Current(e) == AssetStatus.Degraded);
            var downList = activeEntities.Where(e => StatusUi.IsDown(StatusUi.Current(e))).ToList();
            var maint = activeEntities.Count(e => StatusUi.Current(e) == AssetStatus.Maintenance);
            var unknown = activeEntities.Count - online - degraded - downList.Count - maint;
            var critIncidents = activeIncidents.Count(i => i.Severity == IncidentSeverity.Critical);
            var oldest = activeIncidents.OrderBy(i => i.StartedAt).FirstOrDefault();
            var withData = overview?.Groups.SelectMany(g => g.Entities).Where(StatusUi.HasData).ToList() ?? new();
            var groupCount = activeEntities.Select(e => e.Group).Where(g => !string.IsNullOrWhiteSpace(g)).Distinct().Count();

            <div class="st-kpis">
                <div class="st-kpi">
                    <div class="st-kpi-label">Entities</div>
                    <div class="st-kpi-value">@activeEntities.Count <small>active</small></div>
                    <div class="st-kpi-sub">@StatusUi.Plural(activeEntities.Select(e => e.EntityType).Distinct().Count(), "type") · @StatusUi.Plural(groupCount, "group")</div>
                    @if (activeEntities.Count > 0)
                    {
                        <div class="st-kpi-bar" aria-hidden="true">
                            @if (online > 0) { <i style="--sc:var(--success);flex:@online"></i> }
                            @if (maint > 0) { <i style="--sc:var(--info);flex:@maint"></i> }
                            @if (degraded > 0) { <i style="--sc:var(--warning);flex:@degraded"></i> }
                            @if (downList.Count > 0) { <i style="--sc:var(--danger);flex:@downList.Count"></i> }
                            @if (unknown > 0) { <i style="--sc:var(--border-strong);flex:@unknown"></i> }
                        </div>
                    }
                </div>
                <div class="st-kpi @(online > 0 ? "is-success" : "")">
                    <div class="st-kpi-label">Online</div>
                    <div class="st-kpi-value">@online</div>
                    <div class="st-kpi-sub">@(activeEntities.Count > 0 ? $"{online * 100 / activeEntities.Count}% of entities" : "—")</div>
                </div>
                <div class="st-kpi @(degraded > 0 ? "is-warning" : "")">
                    <div class="st-kpi-label">Degraded</div>
                    <div class="st-kpi-value">@degraded</div>
                    <div class="st-kpi-sub">@(maint > 0 ? $"{maint} in maintenance" : "none in maintenance")</div>
                </div>
                <div class="st-kpi @(downList.Count > 0 ? "is-danger" : "")">
                    <div class="st-kpi-label">Down</div>
                    <div class="st-kpi-value">@downList.Count</div>
                    <div class="st-kpi-sub">@downList.Count(e => StatusUi.Current(e) == AssetStatus.Offline) offline · @downList.Count(e => StatusUi.Current(e) == AssetStatus.Error) error</div>
                </div>
                <div class="st-kpi @(critIncidents > 0 ? "is-danger" : "")">
                    <div class="st-kpi-label">Active incidents</div>
                    <div class="st-kpi-value">@activeIncidents.Count</div>
                    <div class="st-kpi-sub">@(oldest is null ? "all clear" : $"{critIncidents} critical · oldest {StatusUi.Duration(oldest.Duration)}")</div>
                </div>
                <div class="st-kpi">
                    <div class="st-kpi-label">Uptime, @(overview?.Days ?? 30) days</div>
                    <div class="st-kpi-value">@(withData.Any() ? withData.Average(e => e.UptimePercent).ToString("0.0") : "—")<small>@(withData.Any() ? "%" : "")</small></div>
                    <div class="st-kpi-sub">share of days fully online</div>
                </div>
            </div>

            <div class="st-cols">
                <div class="st-col">
                    <div class="card">
                        <div class="card-head">
                            <h3 class="card-title">Needs attention</h3>
                            <span class="st-card-sub">critical first</span>
                            <span class="st-card-spacer"></span>
                            <a class="st-link" href="@($"status/board{queryParam}")">Open board</a>
                        </div>
                        @if (!attention.Any())
                        {
                            <div class="empty">
                                <div class="dl-empty-icon" style="color:var(--success)">@StatusUi.Icon("check-circle", 20)</div>
                                <div class="empty-title">Everything is online</div>
                                <div class="empty-text">No active entity reported a problem on its latest check.</div>
                            </div>
                        }
                        else
                        {
                            <ul class="st-attn">
                                @foreach (var e in attention.Take(8))
                                {
                                    var latest = StatusUi.Latest(e);
                                    var status = latest?.Status ?? AssetStatus.Unknown;
                                    var inc = activeIncidents.FirstOrDefault(i => i.EntityId == e.Id);
                                    <li>
                                        <span class="st-tile">@StatusUi.TypeSvg(e.EntityType, 18)</span>
                                        <div style="min-width:0">
                                            <a class="st-attn-name" href="@($"status/entities/{e.Id}{queryParam}")">@e.Name</a>
                                            <div class="st-attn-sub">
                                                <span class="st-status @StatusUi.Cls(status)"><span class="st-dot is-live"></span> @StatusUi.Label(status)</span>
                                                @if (e.IsCritical) { <span class="badge badge-danger dl-mini-badge">Critical</span> }
                                                @if (!string.IsNullOrWhiteSpace(latest?.StatusMessage))
                                                {
                                                    <span class="st-muted" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:320px" title="@latest!.StatusMessage">@latest!.StatusMessage</span>
                                                }
                                                @if (inc is not null)
                                                {
                                                    <a class="st-link" href="@($"status/incidents/{inc.Id}{queryParam}")">Incident: @inc.Status</a>
                                                }
                                            </div>
                                        </div>
                                        <div class="st-attn-since"><b>@StatusUi.Ago(latest?.CheckedAt)</b>last check</div>
                                    </li>
                                }
                            </ul>
                            @if (attention.Count > 8)
                            {
                                <div class="dl-footer"><span class="dl-footer-text"><strong>@(attention.Count - 8)</strong> more</span><a class="st-link" href="@($"status/entities{queryParam}")">See all entities</a></div>
                            }
                        }
                    </div>

                    @if (overview is not null && overview.Groups.Any())
                    {
                        <div class="card">
                            <div class="card-head">
                                <h3 class="card-title">By type</h3>
                                <span class="st-card-spacer"></span>
                                <span class="st-card-sub">worst status per day, last 14 days</span>
                            </div>
                            <div class="st-types-wrap">
                                <table class="st-types">
                                    <thead>
                                        <tr><th>Type</th><th class="is-num">Total</th><th class="is-num">Online</th><th class="is-num">Degraded</th><th class="is-num">Down</th><th>Last 14 days</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var g in overview.Groups)
                                        {
                                            var gOn = g.Entities.Count(e => e.CurrentStatus == AssetStatus.Online);
                                            var gDeg = g.Entities.Count(e => e.CurrentStatus == AssetStatus.Degraded);
                                            var gDown = g.Entities.Count(e => StatusUi.IsDown(e.CurrentStatus));
                                            <tr>
                                                <td><span class="st-type-name">@StatusUi.TypeSvg(g.EntityType, 14) @StatusUi.TypePlural(g.EntityType)</span></td>
                                                <td class="is-num">@g.EntityCount</td>
                                                <td class="is-num @(gOn == 0 ? "is-zero" : "")">@gOn</td>
                                                <td class="is-num @(gDeg == 0 ? "is-zero" : "is-warn")">@gDeg</td>
                                                <td class="is-num @(gDown == 0 ? "is-zero" : "is-bad")">@gDown</td>
                                                <td><AvailabilityStrip Days="@StatusUi.LastDays(StatusUi.WorstDays(g.Entities), 14)" Size="xs" Name="@StatusUi.TypePlural(g.EntityType)" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>

                <div class="st-col">
                    <div class="card">
                        <div class="card-head">
                            <h3 class="card-title">Active incidents</h3>
                            <span class="tab-count">@activeIncidents.Count</span>
                            <span class="st-card-spacer"></span>
                            <a class="st-link" href="@($"status/incidents{queryParam}")">View all</a>
                        </div>
                        @if (!activeIncidents.Any())
                        {
                            <div class="st-card-empty">No open incidents.</div>
                        }
                        else
                        {
                            <ul class="st-inc">
                                @foreach (var i in activeIncidents.OrderByDescending(i => i.Severity).ThenBy(i => i.StartedAt).Take(8))
                                {
                                    <li class="@StatusUi.Cls(i.Severity)">
                                        <div class="st-inc-text">
                                            <a class="st-inc-title" href="@($"status/incidents/{i.Id}{queryParam}")">@i.Title</a>
                                            <div class="st-inc-meta">
                                                <span class="badge @StatusUi.Cls(i.Status)"><i></i>@i.Status</span>
                                                <span>@(i.Entity?.Name ?? "Unknown entity")</span>
                                                <span>·</span>
                                                <span>@(string.IsNullOrWhiteSpace(i.AssignedTo) ? "unassigned" : i.AssignedTo)</span>
                                            </div>
                                        </div>
                                        <span class="st-inc-dur">@StatusUi.Duration(i.Duration)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    @if (inactiveCount > 0)
                    {
                        <div class="st-callout is-info">
                            @StatusUi.Icon("info", 14)
                            <div>@StatusUi.Plural(inactiveCount, "entity is", "entities are") inactive and not counted here. <a class="st-link" href="@($"status/entities{queryParam}")">Manage entities</a></div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<MonitoredAsset> activeEntities = new();
    private List<MonitoredAsset> attention = new();
    private List<Incident> activeIncidents = new();
    private StatusOverviewDto? overview;
    private int inactiveCount;
    private bool isLoading = true;

    private string queryParam => StateContainer.Company is null ? "" : $"?c={StateContainer.Company.Id}";
    private string writeRoles => $"{StateContainer.Company?.Id}_INCIDENTS,{StateContainer.Company?.Id}_ADMIN";

    protected override async Task OnInitializedAsync()
    {
        var companyId = StateContainer.Company?.Id;
        if (string.IsNullOrEmpty(companyId)) { isLoading = false; return; }

        var entitiesTask = EntityService.GetEntitiesWithLatestStatusAsync(companyId);
        var incidentsTask = IncidentService.GetActiveIncidentsAsync(companyId);
        var overviewTask = OverviewService.GetOverviewAsync(companyId, 30);
        await Task.WhenAll(entitiesTask, incidentsTask, overviewTask);

        var all = entitiesTask.Result;
        activeEntities = all.Where(e => e.IsActive).ToList();
        inactiveCount = all.Count - activeEntities.Count;
        activeIncidents = incidentsTask.Result;
        overview = overviewTask.Result;

        attention = activeEntities
            .Where(e => StatusUi.NeedsAttention(StatusUi.Current(e)))
            .OrderByDescending(e => e.IsCritical)
            .ThenByDescending(e => StatusUi.Rank(StatusUi.Current(e)))
            .ThenBy(e => e.Name)
            .ToList();

        isLoading = false;
    }
}
