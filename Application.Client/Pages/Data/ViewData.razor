@page "/data/view"
@page "/data/edit"
@using System.Text.Json
@using Application.Shared.Models.Data
@using Application.Shared.Models
@using Application.Shared.Enums
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject IToastService ToastService
@inject Application.Client.Services.ActivityLogClient ActivityLog
@inject Application.Client.Services.TableExportClient TableExport
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize(Policy = PolicyNames.DatasetsAccess)]
@implements IAsyncDisposable

<PageTitle>Data Viewer - @(TableInfo?.TableName ?? "Loading...")</PageTitle>

@if (!canView)
{
    <div class="sc dvw-shell">
        <div class="dvw-center">
            <div class="empty">
                <div class="dvw-empty-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div class="empty-title">Access denied</div>
                <div class="empty-text">You don't have permission to view data.</div>
            </div>
        </div>
    </div>
}
else
{
<div class="sc dvw-shell">
    @* ---------- top bar: identity on the left, actions on the right ---------- *@
    <header class="dvw-top">
        <div class="dvw-top-left">
            <button type="button" class="dvw-back" @onclick="GoBack" title="Back to tables" aria-label="Back to tables">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            </button>
            <span class="dvw-tile @(sourceMode ? "dvw-tile-ext" : "")" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/></svg>
            </span>
            <div class="dvw-heading">
                <div class="dvw-crumbs">
                    @if (DatasetInfo != null)
                    {
                        <a class="dvw-crumb" href="@($"/data/tables?c={c}&d={DatasetId}")" title="Back to the dataset's tables">@DatasetInfo.Name</a>
                        <span class="dvw-crumb-sep">/</span>
                    }
                    <h1 class="dvw-title" title="@(TableInfo?.TableName ?? TableName)">@(TableInfo?.TableName ?? TableName ?? "Loading…")</h1>
                </div>
                <div class="dvw-meta">
                    @if (IsLoading || DatasetInfo == null)
                    {
                        <span class="skeleton dvw-skel"></span>
                    }
                    else
                    {
                        @if (sourceMode)
                        {
                            <span class="badge badge-accent" title="Rows are read straight from the connected source database as you scroll">Live source</span>
                        }
                        else if (DatasetInfo.SourceType == DatasetSourceType.External)
                        {
                            <span class="badge badge-neutral" title="A saved snapshot of the external source">Snapshot</span>
                        }
                        else
                        {
                            <span class="badge badge-neutral" title="Stored in this dataset's DuckDB file">Local</span>
                        }
                        @if (AllowEdit)
                        {
                            <span class="badge badge-success" title="You can edit cells and add or delete rows">Editable</span>
                        }
                        else
                        {
                            <span class="badge badge-neutral">Read-only</span>
                        }
                        <span class="dvw-meta-text">
                            @if (TotalRows > 0) { <span>@TotalRows.ToString("N0") rows</span> } else { <span>Counting rows…</span> }
                            <span class="dvw-dot">·</span>
                            <span>@(TableColumns?.Count ?? 0) column@((TableColumns?.Count ?? 0) == 1 ? "" : "s")</span>
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="dvw-actions">
            @if (AllowEdit)
            {
                <button class="btn btn-primary btn-sm" @onclick="AddRow" disabled="@IsLoading" title="Add a blank row and fill it in">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    Add row
                </button>
                <button class="btn btn-secondary btn-sm dvw-btn-danger" @onclick="DeleteSelected" disabled="@IsLoading" title="Delete the ticked rows">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                    Delete
                </button>
                <span class="dvw-vsep" aria-hidden="true"></span>
            }
            @if (!sourceMode)
            {
                <button class="btn btn-secondary btn-sm" @onclick="DownloadCsv" disabled="@(IsLoading || isExporting)" title="Download the full table as CSV">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                    @(isExporting ? "Preparing…" : "Download")
                </button>
            }
            <button class="btn btn-secondary btn-sm" @onclick="RefreshData" disabled="@IsLoading" title="Reload the rows on screen">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
                Refresh
            </button>
            <button class="btn btn-secondary btn-sm" @onclick="GoToQuery" disabled="@IsLoading" title="Open this table in the SQL workbench">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/></svg>
                Query
            </button>
            <button class="btn btn-secondary btn-sm" @onclick="@(() => ShowApiDocs = true)" title="How to fetch this data through the API">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                API
            </button>
            <button class="btn btn-secondary btn-sm @(ShowCommentsPanel ? "is-active" : "")" @onclick="@(() => ShowCommentsPanel = !ShowCommentsPanel)" disabled="@IsLoading" title="@(ShowCommentsPanel ? "Hide comments" : "Show comments")" aria-pressed="@(ShowCommentsPanel ? "true" : "false")">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Comments
                @if (CommentsCount > 0) { <span class="dvw-count">@CommentsCount</span> }
            </button>
        </div>
    </header>

    @* ---------- body: the grid, plus the comments panel when open ---------- *@
    <div class="dvw-body">
        <section class="dvw-main">
            @if (IsLoading || !hasLoadedOnce)
            {
                <div class="dvw-center">
                    <div class="dvw-loading"><span class="spin"></span><span>Loading table…</span></div>
                </div>
            }
            else if (TableColumns?.Any() == true)
            {
                <div id="@GridId" class="ag-theme-quartz dvw-grid"></div>
                <footer class="dvw-status">
                    <div class="dvw-status-left">
                        <span class="dvw-status-rows">@(TotalRows > 0 ? $"{TotalRows:N0} rows" : "Loading rows…")</span>
                        @if (gridSortCount > 0 || gridFilterCount > 0)
                        {
                            <span class="dvw-dot">·</span>
                            <span>
                                @if (gridSortCount > 0) { <text>sorted by @gridSortCount column@(gridSortCount == 1 ? "" : "s")</text> }
                                @if (gridSortCount > 0 && gridFilterCount > 0) { <text>, </text> }
                                @if (gridFilterCount > 0) { <text>@gridFilterCount filter@(gridFilterCount == 1 ? "" : "s")</text> }
                            </span>
                            <button type="button" class="dvw-link" @onclick="ClearGridState" title="Remove every sort and filter">Clear</button>
                        }
                    </div>
                    <div class="dvw-status-right">
                        @if (sourceMode) { <span>Rows come straight from the source database as you scroll. Sort and filter from the header row.</span> }
                        else if (AllowEdit) { <span>Click a cell to edit; changes save on their own. Tick rows to delete them.</span> }
                        else { <span>Scroll to load more. Sort and filter from the header row.</span> }
                    </div>
                </footer>
            }
            else
            {
                <div class="dvw-center">
                    <div class="empty">
                        <div class="dvw-empty-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/></svg>
                        </div>
                        <div class="empty-title">No data available</div>
                        <div class="empty-text">This table appears to be empty or could not be loaded.</div>
                        @if (!string.IsNullOrEmpty(DatasetId) && !string.IsNullOrEmpty(TableName))
                        {
                            <button class="btn btn-secondary btn-sm" style="margin-top:6px;" @onclick="ReloadTable">Try again</button>
                        }
                    </div>
                </div>
            }
        </section>

        @if (ShowCommentsPanel)
        {
            <aside class="dvw-side" aria-label="Comments">
                <CommentsSidebar CompanyId="@c"
                                DatasetId="@DatasetId"
                                CurrentUserId="@CurrentUserId"
                                TableName="@TableName"
                                OnCommentAdded="@OnCommentAdded"
                                OnCommentDeleted="@OnCommentDeleted" />
            </aside>
        }
    </div>
</div>

<ApiDocsDialog IsVisible="@ShowApiDocs"
               IsVisibleChanged="@((bool v) => ShowApiDocs = v)"
               CompanyId="@c"
               DatasetId="@DatasetId"
               DatasetName="@(DatasetInfo?.Name)"
               TableName="@TableName"
               IsExternalSource="@(DatasetInfo?.SourceType == DatasetSourceType.External)"
               LiveSource="@sourceMode" />
}

<style>
    /* ------------------------------------------------------------------------------------------------
       Data viewer — `.dvw-*`. Built on the shadcn tokens in shadcn.css, so light and dark both come from
       the tokens. The grid itself is AG Grid's Quartz theme, re-skinned through its own custom properties
       (further down) off those same tokens; the row virtualisation and infinite scrolling are untouched.
       ------------------------------------------------------------------------------------------------ */
    .dvw-shell {
        /* Fill the layout's main area edge to edge: its height is the viewport minus the app chrome, and
           the negative margins cancel .al-main's 20px/24px padding. */
        height: calc(100dvh - var(--header-height) - var(--footer-height));
        margin: -20px -24px;
        display: flex; flex-direction: column; overflow: hidden;
        background: var(--bg); color: var(--text-primary);
    }
    @@media (max-width: 767px) { .dvw-shell { margin: -14px -16px; } }

    /* ---- top bar ---- */
    .dvw-top {
        flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 12px;
        min-height: 58px; padding: 10px 20px; border-bottom: 1px solid var(--border); background: var(--surface);
    }
    .dvw-top-left { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .dvw-back {
        appearance: none; flex: 0 0 auto; width: 30px; height: 30px; border-radius: 6px; border: 0;
        background: transparent; color: var(--text-muted); display: inline-flex; align-items: center;
        justify-content: center; cursor: pointer; transition: background .12s ease, color .12s ease;
    }
    .dvw-back:hover { background: var(--surface-subtle); color: var(--text-primary); }
    .dvw-back:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    .dvw-tile {
        flex: 0 0 auto; width: 34px; height: 34px; border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--border); background: var(--surface-subtle); color: var(--text-secondary);
    }
    .dvw-tile-ext { background: var(--accent-subtle); border-color: color-mix(in srgb, var(--accent) 28%, transparent); color: var(--accent); }
    .dvw-heading { min-width: 0; }
    .dvw-crumbs { display: flex; align-items: baseline; gap: 6px; min-width: 0; }
    .sc .dvw-crumb { font-size: 13px; color: var(--text-muted); text-decoration: none; white-space: nowrap; }
    .sc .dvw-crumb:hover { color: var(--text-primary); text-decoration: underline; text-underline-offset: 3px; }
    .dvw-crumb-sep { color: var(--border-strong); font-size: 13px; }
    .dvw-title {
        margin: 0; font-family: var(--font-mono); font-size: 14px; font-weight: 600; line-height: 1.3;
        color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .dvw-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 3px; font-size: 12px; color: var(--text-muted); }
    .dvw-meta-text { display: inline-flex; align-items: center; gap: 6px; font-variant-numeric: tabular-nums; }
    .dvw-dot { color: var(--border-strong); }
    .dvw-skel { display: inline-block; width: 180px; height: 11px; }

    .dvw-actions { display: flex; align-items: center; justify-content: flex-end; gap: 6px; flex: 0 0 auto; flex-wrap: wrap; }
    .dvw-vsep { width: 1px; height: 20px; background: var(--border); margin: 0 4px; }
    .sc .dvw-btn-danger { color: var(--danger); }
    .sc .dvw-btn-danger:hover:not(:disabled) { background: var(--danger-subtle); border-color: var(--danger-border) !important; }
    .sc .dvw-actions .btn.is-active { background: var(--accent-subtle); color: var(--accent); border-color: color-mix(in srgb, var(--accent) 35%, transparent) !important; }
    .dvw-count {
        display: inline-flex; align-items: center; justify-content: center; min-width: 18px; height: 18px;
        padding: 0 5px; border-radius: 999px; background: var(--accent); color: var(--text-on-accent);
        font-size: 11px; font-weight: 600; line-height: 1; margin-left: 2px;
    }

    /* ---- body ---- */
    .dvw-body { flex: 1 1 auto; display: flex; min-height: 0; }
    /* The grid sits in a framed panel with a gutter around it; the status bar is the panel's footer. */
    .dvw-main { flex: 1 1 auto; min-width: 0; min-height: 0; display: flex; flex-direction: column; padding: 14px 20px 16px; background: var(--bg); }
    .dvw-grid {
        flex: 1 1 auto; min-height: 0; width: 100%;
        border: 1px solid var(--border); border-radius: 8px 8px 0 0; overflow: hidden; background: var(--surface);
    }
    .dvw-side { flex: 0 0 340px; min-height: 0; display: flex; flex-direction: column; overflow: hidden; border-left: 1px solid var(--border); background: var(--surface); }
    .dvw-center { flex: 1 1 auto; display: flex; align-items: center; justify-content: center; padding: 24px; }
    .dvw-loading { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--text-muted); }
    .dvw-empty-icon {
        width: 44px; height: 44px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center;
        background: var(--surface-subtle); border: 1px solid var(--border); color: var(--text-muted); margin-bottom: 6px;
    }

    /* ---- status bar under the grid ---- */
    .dvw-status {
        flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 12px;
        min-height: 34px; padding: 6px 14px; border: 1px solid var(--border); border-top: 0; border-radius: 0 0 8px 8px;
        background: var(--surface-subtle); font-size: 12px; color: var(--text-muted);
    }
    .dvw-status-left { display: flex; align-items: center; gap: 6px; white-space: nowrap; }
    .dvw-status-rows { font-weight: 600; color: var(--text-secondary); font-variant-numeric: tabular-nums; }
    .dvw-link { appearance: none; background: none; border: 0; padding: 0 4px; font: inherit; font-size: 12px; font-weight: 600; color: var(--accent); cursor: pointer; }
    .dvw-link:hover { text-decoration: underline; text-underline-offset: 3px; }
    .dvw-status-right { text-align: right; }
    @@media (max-width: 960px) { .dvw-status-right { display: none; } }

    /* ---- AG Grid (Quartz) re-skinned through its custom properties ----
       Same tokens as the rest of the page, so dark mode needs no separate block. This out-ranks the
       app-wide dark override in app.css because it comes later at equal specificity. */
    .dvw-grid.ag-theme-quartz {
        --ag-font-family: var(--font-body);
        --ag-font-size: 13px;
        --ag-active-color: var(--accent);
        --ag-background-color: var(--surface);
        --ag-foreground-color: var(--text-primary);
        --ag-secondary-foreground-color: var(--text-secondary);
        --ag-subtle-text-color: var(--text-muted);
        --ag-header-background-color: var(--surface-subtle);
        --ag-header-foreground-color: var(--text-muted);
        --ag-border-color: var(--border);
        --ag-row-border-color: var(--border);
        --ag-row-hover-color: var(--surface-muted);
        --ag-odd-row-background-color: var(--surface);
        --ag-selected-row-background-color: var(--accent-subtle);
        --ag-range-selection-border-color: var(--accent);
        --ag-control-panel-background-color: var(--surface);
        --ag-input-background-color: var(--surface);
        --ag-input-border-color: var(--border);
        --ag-input-focus-border-color: var(--accent);
        --ag-input-focus-box-shadow: 0 0 0 3px var(--ring);
        --ag-checkbox-checked-color: var(--accent);
        --ag-checkbox-unchecked-color: var(--border-strong);
        --ag-header-column-separator-display: none;
        --ag-header-column-resize-handle-display: block;
        --ag-header-column-resize-handle-color: var(--border);
        --ag-header-column-resize-handle-height: 40%;
        --ag-cell-horizontal-padding: 12px;
        --ag-border-radius: 6px;
        --ag-wrapper-border-radius: 0;
        --ag-card-shadow: var(--shadow-md);
        --ag-popup-shadow: var(--shadow-md);
        --ag-modal-overlay-background-color: color-mix(in srgb, var(--bg) 70%, transparent);
        --ag-icon-size: 14px;
        --ag-header-height: 36px;
        --ag-row-height: 34px;
    }
    .dvw-grid .ag-root-wrapper { border: 0; }
    .dvw-grid .ag-header { border-bottom: 1px solid var(--border); }
    .dvw-grid .ag-header-cell-text { font-size: 11px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; }
    .dvw-grid .dvw-col-type {
        margin-left: 6px; font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: 0;
        text-transform: none; color: var(--text-muted); opacity: .7; white-space: nowrap;
    }
    .dvw-grid .ag-header-cell:hover .dvw-col-type { opacity: 1; }
    /* Right-aligned (numeric) headers lay their label out in reverse, which would put the tag before the
       name; pulling it to the front of the flex order puts it back after the name. */
    .dvw-grid .ag-right-aligned-header .dvw-col-type { order: -1; }
    /* The filter row's inputs: Quartz sizes them with `input[class^=ag-]` selectors, so this has to be more
       specific than that to take. 22px tall in a 34px row leaves clear space above and below. */
    .dvw-grid.ag-theme-quartz .ag-floating-filter input[class^=ag-] {
        height: 22px; min-height: 22px; max-height: 22px; line-height: 20px;
        padding: 0 8px; font-size: 11.5px; border-radius: 5px;
    }
    .dvw-grid.ag-theme-quartz .ag-floating-filter { padding-top: 0; padding-bottom: 0; }
    .dvw-grid .ag-floating-filter-button { margin-left: 6px; }
    .dvw-grid .ag-row { border-bottom-style: solid; }
    .dvw-grid .dvw-cell-int, .dvw-grid .dvw-cell-num { font-variant-numeric: tabular-nums; }
    .dvw-grid .dvw-cell-date, .dvw-grid .dvw-cell-time { color: var(--text-secondary); font-variant-numeric: tabular-nums; }
    .dvw-grid .dvw-cell-json, .dvw-grid .dvw-cell-blob { font-family: var(--font-mono); font-size: 12px; color: var(--text-secondary); }
    .dvw-grid .dvw-cell-bool { text-transform: lowercase; }
    .dvw-grid .dvw-null:not(.ag-cell-inline-editing)::before { content: "null"; color: var(--text-muted); font-style: italic; opacity: .7; }
    .dvw-grid .ag-loading { color: var(--text-muted); font-size: 12px; }
    .dvw-overlay {
        display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px;
        border: 1px solid var(--border); border-radius: 8px; background: var(--surface); box-shadow: var(--shadow-sm);
        font-size: 12.5px; color: var(--text-muted);
    }
    .dvw-overlay-spin {
        width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--accent-border); border-top-color: var(--accent);
        animation: dvw-rotate .7s linear infinite;
    }
    @@keyframes dvw-rotate { to { transform: rotate(360deg); } }
</style>

@code {
    [SupplyParameterFromQuery] public string? c { get; set; }
    [SupplyParameterFromQuery] public string? DatasetId { get; set; }
    [SupplyParameterFromQuery] public string? TableName { get; set; }
    // When true (set by the tables list when viewing an external dataset's live source), read the rows from
    // the live source database instead of the local DuckDB snapshot.
    [SupplyParameterFromQuery] public bool? source { get; set; }

    private const string GridId = "data-view-grid";

    // ---- Live-source mode (external datasets) ----
    // Confirmed after the dataset loads (source flag AND the dataset really is External). Rows are read
    // from the source database one block at a time as the grid scrolls, with sort and filter pushed into
    // the source query (POST source-tables/{table}/data). The source is read-only here.
    private bool sourceMode;
    // The filter model the last live-source COUNT was taken for. The count is only re-run on the first
    // block after the filters change, so scrolling does not repeat it on every block.
    private string? countedFilterJson;

    private bool ShowApiDocs = false;

    private Dataset? DatasetInfo;
    private Table? TableInfo;
    private List<Column>? TableColumns;

    private bool canView;
    private bool canEdit;
    // Editing is offered only to EDIT_DATA users on local DuckDB datasets; external sources are read-only.
    private bool AllowEdit => canEdit && DatasetInfo?.SourceType == DatasetSourceType.Local;
    private bool IsLoading = false;
    // False until the first load attempt has finished, so the page shows "loading" rather than "no data"
    // for the frame before the table is fetched.
    private bool hasLoadedOnce;
    private bool ShowCommentsPanel = false;
    private int TotalRows = 0;
    private int CommentsCount = 0;
    private string CurrentUserId = string.Empty;

    // Sort/filter state reported by the grid (see dataGridEditor.notifyState) for the status bar.
    private int gridSortCount;
    private int gridFilterCount;

    private string? loadedKey;
    private bool gridInitialized;
    private DotNetObjectReference<ViewData>? dotNetRef;

    /// <summary>Shape returned to AG Grid's infinite datasource: a page of rows + the known total.</summary>
    public class FetchRowsResult
    {
        public List<Dictionary<string, object>> Rows { get; set; } = new();
        public int LastRow { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        EnsureCompanyHeader();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentUserId = authState.User.Claims.FirstOrDefault(x => x.Type.EndsWith("nameidentifier"))?.Value ??
                        authState.User.Claims.FirstOrDefault(x => x.Type.EndsWith("id"))?.Value ?? string.Empty;
        EnsureUserIdHeader();

        var companyId = c ?? "";
        canView = authState.User.HasCompanyRole(companyId, "VIEW_DATA");
        canEdit = authState.User.HasCompanyRole(companyId, "EDIT_DATA");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!canView) return;
        if (string.IsNullOrEmpty(DatasetId) || string.IsNullOrEmpty(TableName))
        {
            hasLoadedOnce = true; // nothing to load — show the empty state rather than a spinner
            return;
        }

        var key = $"{DatasetId}|{TableName}|{source}";
        if (key == loadedKey) return;
        loadedKey = key;

        // New table/mode — forget the previous grid's sort/filter state and the live-source row count.
        countedFilterJson = null;
        gridSortCount = 0;
        gridFilterCount = 0;

        // Navigated to a different table on the same component instance — tear the grid down first.
        if (gridInitialized)
        {
            try { await JSRuntime.InvokeVoidAsync("dataGridEditor.dispose"); } catch { }
            gridInitialized = false;
        }

        await LoadInitialData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Build the grid once the column metadata is loaded and the container has rendered. The grid then
        // pulls rows from the server on demand (infinite row model) via FetchRows.
        if (!canView || IsLoading || TableColumns == null || !TableColumns.Any() || gridInitialized)
            return;
        gridInitialized = true;
        dotNetRef ??= DotNetObjectReference.Create(this);
        var colPayload = TableColumns.Select(col => new { name = col.Name, dataType = col.DataType }).ToList();
        await JSRuntime.InvokeVoidAsync("dataGridEditor.init", GridId, dotNetRef, colPayload, null,
            new { editable = AllowEdit, infinite = true });
    }

    private async Task LoadInitialData()
    {
        IsLoading = true;
        TotalRows = 0;
        StateHasChanged();
        EnsureCompanyHeader();

        try
        {
            DatasetInfo = await HttpClient.GetFromJsonAsync<Dataset>($"api/Datasets/{DatasetId}");
            // Only treat this as a live-source view if the caller asked for it AND the dataset really is
            // external — otherwise fall through to the normal DuckDB snapshot path.
            sourceMode = source == true && DatasetInfo?.SourceType == DatasetSourceType.External;

            if (sourceMode)
            {
                // The source table has no DuckDB snapshot, so read its column shape from the live source
                // (the columns endpoint falls back to the source schema) and synthesize the table info.
                var cols = await HttpClient.GetFromJsonAsync<List<Column>>(
                    $"api/Datasets/{DatasetId}/tables/{Uri.EscapeDataString(TableName!)}/columns") ?? new();
                TableColumns = cols;
                TableInfo = new Table { TableName = TableName!, DatasetId = DatasetId!, CompanyId = c ?? string.Empty, Columns = cols };
            }
            else
            {
                TableInfo = await HttpClient.GetFromJsonAsync<Table>($"api/Datasets/{DatasetId}/tables/{TableName}");
                TableColumns = TableInfo?.Columns;
            }
            await LoadCommentsCount();
            _ = ActivityLog.LogAsync(c, sourceMode ? "table.page_open_source" : "table.page_open", "table", DatasetId, TableName, "/data/view");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading initial data: {ex.Message}");
            ToastService.ShowError($"Failed to load table: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            hasLoadedOnce = true;
            StateHasChanged();
        }
    }

    private async Task ReloadTable() => await LoadInitialData();

    private async Task LoadCommentsCount()
    {
        try
        {
            var comments = await HttpClient.GetFromJsonAsync<List<DataTableComment>>($"api/DataViews/comments/{DatasetId}/{TableName}");
            CommentsCount = comments?.Count(x => x.DatasetId == DatasetId && x.TableName == TableName) ?? 0;
        }
        catch (Exception ex) { Console.WriteLine($"Error loading comments: {ex.Message}"); }
    }

    // ---- AG Grid infinite datasource callbacks ----

    [JSInvokable]
    public async Task<FetchRowsResult> FetchRows(int startRow, int endRow, string sortJson, string filterJson)
    {
        EnsureCompanyHeader();
        EnsureUserIdHeader();

        var pageSize = Math.Max(1, endRow - startRow);
        var query = new TableDataQuery
        {
            DatasetId = DatasetId!,
            TableName = TableName!,
            Page = startRow / pageSize + 1,
            PageSize = pageSize,
            IncludeRowId = AllowEdit && !sourceMode,
            SortColumns = ParseSort(sortJson),
            Filters = ParseFilters(filterJson)
        };

        // Live source: the same query goes to the source database itself, one block at a time. The COUNT is
        // a second round trip there, so it is only asked for on the first block after the filters change
        // (the grid restarts from row 0 whenever its sort or filter model changes). The DuckDB path counts
        // every time, as it always has.
        var countNeeded = !sourceMode || (startRow == 0 && (countedFilterJson != filterJson || TotalRows == 0));
        var url = sourceMode
            ? $"api/Datasets/{DatasetId}/source-tables/{Uri.EscapeDataString(TableName!)}/data?includeTotal={(countNeeded ? "true" : "false")}"
            : $"api/Datasets/{DatasetId}/tables/{TableName}/data";

        HttpResponseMessage response;
        try
        {
            response = await HttpClient.PostAsJsonAsync(url, query);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load data: {ex.Message}");
            return new FetchRowsResult { Rows = new(), LastRow = startRow };
        }
        if (!response.IsSuccessStatusCode)
        {
            // The live-source path returns the engine's own message (e.g. a filter the source rejected);
            // that is worth showing. The snapshot path keeps the status code as before.
            var detail = sourceMode ? await response.Content.ReadAsStringAsync() : response.StatusCode.ToString();
            ToastService.ShowError($"Failed to load data: {detail}");
            return new FetchRowsResult { Rows = new(), LastRow = startRow };
        }

        var result = await response.Content.ReadFromJsonAsync<TableDataResult>();
        var rows = result?.Data ?? new();
        if (countNeeded)
        {
            TotalRows = result?.TotalRows ?? (startRow + rows.Count);
            countedFilterJson = filterJson;
        }
        else if (TotalRows < startRow + rows.Count)
        {
            TotalRows = startRow + rows.Count; // the source grew since it was counted
        }
        await InvokeAsync(StateHasChanged); // refresh the row count in the header
        return new FetchRowsResult { Rows = rows, LastRow = TotalRows };
    }

    // Called by the grid whenever its sort or filter model changes (dataGridEditor.notifyState).
    [JSInvokable]
    public async Task GridStateChanged(int sorts, int filters)
    {
        gridSortCount = sorts;
        gridFilterCount = filters;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearGridState() => await JSRuntime.InvokeVoidAsync("dataGridEditor.clearSortAndFilters");

    [JSInvokable]
    public async Task UpdateCell(long rowId, string column, string? value)
    {
        EnsureCompanyHeader();
        EnsureUserIdHeader();
        var model = new RowEditModel { RowId = rowId, Values = new Dictionary<string, string?> { [column] = value } };
        var response = await HttpClient.PutAsJsonAsync($"api/Datasets/{DatasetId}/tables/{TableName}/rows", model);
        if (!response.IsSuccessStatusCode)
        {
            ToastService.ShowError($"Save failed: {await response.Content.ReadAsStringAsync()}");
            return;
        }
        var result = await response.Content.ReadFromJsonAsync<RowMutationResult>();
        if (result?.Success != true)
            ToastService.ShowError(result?.Error ?? "The change could not be saved.");
    }

    [JSInvokable]
    public async Task DeleteRows(long[] ids)
    {
        if (ids == null || ids.Length == 0) return;
        EnsureCompanyHeader();
        EnsureUserIdHeader();
        var request = new BulkRowEditRequest { Deletes = ids.ToList() };
        var response = await HttpClient.PostAsJsonAsync($"api/Datasets/{DatasetId}/tables/{TableName}/rows/bulk", request);
        if (!response.IsSuccessStatusCode)
        {
            ToastService.ShowError($"Delete failed: {await response.Content.ReadAsStringAsync()}");
            return;
        }
        var result = await response.Content.ReadFromJsonAsync<BulkRowEditResult>();
        if (result?.Success == true) ToastService.ShowSuccess($"{result.Deleted} row(s) deleted");
        else ToastService.ShowError(result?.Error ?? "Delete failed.");
    }

    [JSInvokable]
    public async Task<bool> InsertRow()
    {
        EnsureCompanyHeader();
        EnsureUserIdHeader();
        // Insert a blank row (all columns NULL); the user then fills cells, each auto-committing.
        var values = (TableColumns ?? new()).ToDictionary(col => col.Name, _ => (string?)null);
        var model = new RowEditModel { Values = values };
        var response = await HttpClient.PostAsJsonAsync($"api/Datasets/{DatasetId}/tables/{TableName}/rows", model);
        if (!response.IsSuccessStatusCode)
        {
            ToastService.ShowError($"Add row failed: {await response.Content.ReadAsStringAsync()}");
            return false;
        }
        var result = await response.Content.ReadFromJsonAsync<RowMutationResult>();
        if (result?.Success == true) { ToastService.ShowSuccess("Row added — edit its cells to fill it in."); return true; }
        ToastService.ShowError(result?.Error ?? "Could not add a blank row (the table may have required columns).");
        return false;
    }

    private async Task AddRow() => await JSRuntime.InvokeVoidAsync("dataGridEditor.addRow");

    private async Task DeleteSelected()
    {
        var count = await JSRuntime.InvokeAsync<int>("dataGridEditor.deleteSelected");
        if (count == 0)
            ToastService.ShowInfo("Select one or more rows (using the checkboxes) to delete.");
    }

    private async Task RefreshData() => await JSRuntime.InvokeVoidAsync("dataGridEditor.refresh");

    private bool isExporting;

    private async Task DownloadCsv()
    {
        if (isExporting) return;

        // Server-side full-table export (the grid only has the loaded blocks in memory). DuckDB writes the
        // CSV and the browser collects it directly — see TableExportClient for why it does not come back
        // through this page.
        isExporting = true;
        try
        {
            var ticket = await TableExport.DownloadAsync(DatasetId!, TableName!, c ?? string.Empty, CurrentUserId);
            ToastService.ShowSuccess($"Downloading {ticket.Rows:N0} rows ({FormatSize(ticket.Bytes)})");
        }
        catch (Exception ex) { ToastService.ShowError($"Error downloading: {ex.Message}"); }
        finally { isExporting = false; }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        <= 0 => "size unknown",
        < 1024 * 1024 => $"{bytes / 1024.0:N0} KB",
        < 1024L * 1024 * 1024 => $"{bytes / (1024.0 * 1024):N1} MB",
        _ => $"{bytes / (1024.0 * 1024 * 1024):N2} GB",
    };

    // ---- AG Grid sort/filter model → TableDataQuery ----

    private static List<SortColumn> ParseSort(string json)
    {
        var list = new List<SortColumn>();
        try
        {
            using var doc = JsonDocument.Parse(json);
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                var col = el.TryGetProperty("colId", out var c) ? c.GetString() : null;
                if (string.IsNullOrEmpty(col) || col == "__sel") continue;
                var dir = el.TryGetProperty("sort", out var s) ? s.GetString() : "asc";
                list.Add(new SortColumn { ColumnName = col, IsDescending = dir == "desc" });
            }
        }
        catch { /* no sort */ }
        return list;
    }

    private static List<FilterCondition> ParseFilters(string json)
    {
        var list = new List<FilterCondition>();
        try
        {
            using var doc = JsonDocument.Parse(json);
            foreach (var prop in doc.RootElement.EnumerateObject())
            {
                if (prop.Name == "__sel") continue;
                var f = prop.Value;
                var type = f.TryGetProperty("type", out var t) ? t.GetString() : "contains";
                string? val = null;
                if (f.TryGetProperty("filter", out var v))
                    val = v.ValueKind == JsonValueKind.String ? v.GetString() : v.ToString();
                if (string.IsNullOrEmpty(val)) continue;
                list.Add(new FilterCondition { ColumnName = prop.Name, Operator = MapOperator(type), Value = val });
            }
        }
        catch { /* no filters */ }
        return list;
    }

    private static string MapOperator(string? agType) => agType switch
    {
        "equals" => "equals",
        "notEqual" => "equals",
        "startsWith" => "startswith",
        "endsWith" => "endswith",
        "greaterThan" or "greaterThanOrEqual" => "greaterthan",
        "lessThan" or "lessThanOrEqual" => "lessthan",
        _ => "contains"
    };

    private void EnsureCompanyHeader()
    {
        if (!HttpClient.DefaultRequestHeaders.Contains("X-Company-ID"))
            HttpClient.DefaultRequestHeaders.Add("X-Company-ID", c);
    }

    private void EnsureUserIdHeader()
    {
        if (string.IsNullOrEmpty(CurrentUserId)) return;
        HttpClient.DefaultRequestHeaders.Remove("UserId");
        HttpClient.DefaultRequestHeaders.Add("UserId", CurrentUserId);
    }

    private void GoBack() => NavigationManager.NavigateTo($"/data/tables?c={c}&d={DatasetId}");
    private void GoToQuery() => NavigationManager.NavigateTo($"/data/query?c={c}&DatasetId={DatasetId}&TableName={TableName}");
    private void OnCommentAdded(DataTableComment comment) { CommentsCount++; StateHasChanged(); }
    private void OnCommentDeleted(string commentId) { CommentsCount = Math.Max(0, CommentsCount - 1); StateHasChanged(); }

    public async ValueTask DisposeAsync()
    {
        try { await JSRuntime.InvokeVoidAsync("dataGridEditor.dispose"); } catch { /* circuit may already be gone */ }
        dotNetRef?.Dispose();
    }
}
