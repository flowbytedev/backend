}

<ApiDocsDialog IsVisible="@showApiDocs"
               IsVisibleChanged="@((bool v) => showApiDocs = v)"
               CompanyId="@companyId"
               DatasetId="@datasetId"
               DatasetName="@datasetName"
               TableName="@apiDocsTable"
               IsExternalSource="@isExternal"
               LiveSource="@SourceMode" />

@* ---------- Share table ---------- *@
@if (showShareTable)
{
    <div class="fb-modal-backdrop" @onclick="() => showShareTable = false">
        <div class="fb-modal sc" role="dialog" aria-modal="true" aria-label="Share table" @onclick:stopPropagation="true">
            <div class="fb-modal-head">
                <div class="fb-modal-title">Share table <span class="dl-modal-sub">— @shareTableName</span></div>
                <button class="btn btn-ghost btn-icon" @onclick="() => showShareTable = false" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>
            <div class="fb-modal-body">
                <div class="field">
                    <label class="field-label">Email address</label>
                    <div class="tl-autocomplete">
                        <input class="input" type="text" autocomplete="off"
                               placeholder="Search company members by name or email"
                               value="@shareTableEmail"
                               @oninput="OnShareTableEmailInput" @onfocus="OnShareTableEmailFocus" @onblur="OnShareTableEmailBlur" />
                        @if (showShareTableSuggestions && shareTableMemberSuggestions.Any())
                        {
                            <div class="tl-suggestions">
                                @foreach (var m in shareTableMemberSuggestions)
                                {
                                    var member = m;
                                    <div class="tl-suggestion" @onmousedown="() => SelectShareTableMember(member)">
                                        <div class="tl-suggestion-avatar">@(string.IsNullOrEmpty(member.Email) ? "?" : member.Email[..1].ToUpper())</div>
                                        <div style="min-width:0;">
                                            @if (!string.IsNullOrWhiteSpace(member.FullName) && member.FullName != member.Email)
                                            {
                                                <div class="tl-suggestion-name">@member.FullName</div>
                                            }
                                            <div class="tl-suggestion-email">@member.Email</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="field">
                    <label class="field-label">Access level</label>
                    <select class="select" @bind="shareTableType">
                        <option value="Viewer">Viewer — can view and query data</option>
                        <option value="Editor">Editor — can modify dataset structure</option>
                        <option value="Admin">Admin — full access including sharing</option>
                    </select>
                    <span class="field-help">Grants access to this table only. Users who already have full dataset access are unaffected.</span>
                </div>
                <div class="field" style="margin-bottom:0;">
                    <label class="field-label">Columns</label>
                    <div class="tl-radios">
                        <label class="tl-check"><input type="radio" name="stCols" checked="@(!shareTableSpecificColumns)" @onchange="() => SetShareTableColumnMode(false)" /> All columns</label>
                        <label class="tl-check"><input type="radio" name="stCols" checked="@shareTableSpecificColumns" @onchange="() => SetShareTableColumnMode(true)" /> Specific columns</label>
                    </div>
                    @if (shareTableSpecificColumns)
                    {
                        @if (shareTableColumnsLoading)
                        {
                            <span class="field-help" style="display:flex;align-items:center;gap:6px;"><span class="spin"></span> Loading columns…</span>
                        }
                        else if (shareTableColumns.Count > 0)
                        {
                            <div class="tl-cols-box">
                                @foreach (var col in shareTableColumns)
                                {
                                    var column = col;
                                    <label class="tl-check tl-check-mono">
                                        <input type="checkbox" checked="@shareTableSelectedColumns.Contains(column)" @onchange="e => ToggleShareTableColumn(column, (bool)e.Value!)" />
                                        @column
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="field-help">No columns available to scope for this table.</span>
                        }
                    }
                </div>
            </div>
            <div class="fb-modal-foot">
                <button type="button" class="btn btn-secondary" @onclick="() => showShareTable = false">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="ShareTableSubmit" disabled="@isSharingTable">
                    @if (isSharingTable) { <span class="spin"></span><span>Sharing…</span> }
                    else { <span>Share table</span> }
                </button>
            </div>
        </div>
    </div>
}

@* ---------- Move table ---------- *@
@if (showMoveTable)
{
    <div class="fb-modal-backdrop" @onclick="() => showMoveTable = false">
        <div class="fb-modal sc" role="dialog" aria-modal="true" aria-label="Move table" @onclick:stopPropagation="true">
            <div class="fb-modal-head">
                <div class="fb-modal-title">Move table <span class="dl-modal-sub">— @moveTableName</span></div>
                <button class="btn btn-ghost btn-icon" @onclick="() => showMoveTable = false" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>
            <div class="fb-modal-body">
                @if (isLoadingMoveDatasets)
                {
                    <div class="skeleton dl-skel" style="width:60%;margin-bottom:10px;"></div>
                    <div class="skeleton dl-skel" style="width:40%;"></div>
                }
                else if (!moveTargetOptions.Any())
                {
                    <div class="empty-text">No other datasets are available to move this table to.</div>
                }
                else
                {
                    <div class="field" style="margin-bottom:0;">
                        <label class="field-label">Destination dataset</label>
                        <select class="select" @bind="moveTargetDatasetId">
                            <option value="">Select a dataset…</option>
                            @foreach (var ds in moveTargetOptions)
                            {
                                <option value="@ds.Id">@ds.Name</option>
                            }
                        </select>
                        <span class="field-help">This moves the table's data and any table-specific sharing to the selected dataset. Users with access will be notified by email.</span>
                    </div>
                }
            </div>
            @if (!isLoadingMoveDatasets && moveTargetOptions.Any())
            {
                <div class="fb-modal-foot">
                    <button type="button" class="btn btn-secondary" @onclick="() => showMoveTable = false">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="MoveTableSubmit" disabled="@(isMovingTable || string.IsNullOrEmpty(moveTargetDatasetId))">
                        @if (isMovingTable) { <span class="spin"></span><span>Moving…</span> }
                        else { <span>Move table</span> }
                    </button>
                </div>
            }
        </div>
    </div>
}

@* ---------- Connect to a dashboard ---------- *@
@if (showConnectModal)
{
    <div class="fb-modal-backdrop" @onclick="() => showConnectModal = false">
        <div class="fb-modal sc" role="dialog" aria-modal="true" aria-label="Connect to dashboard" @onclick:stopPropagation="true">
            <div class="fb-modal-head">
                <div class="fb-modal-title">Connect to dashboard <span class="dl-modal-sub">— @connectTableName</span></div>
                <button class="btn btn-ghost btn-icon" @onclick="() => showConnectModal = false" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>
            <div class="fb-modal-body">
                @if (isLoadingLinks)
                {
                    <div class="skeleton dl-skel" style="width:60%;margin-bottom:10px;"></div>
                    <div class="skeleton dl-skel" style="width:40%;"></div>
                }
                else if (!availableDashboards.Any())
                {
                    <div class="empty-text">No dashboards available to connect.</div>
                }
                else
                {
                    <p class="field-help" style="margin:0 0 6px;">Choose which dashboards open this table for their item-level details. Each dashboard links to one table — connecting reassigns it.</p>
                    @foreach (var dash in availableDashboards)
                    {
                        var connected = connectedPageUrls.Contains(dash.PageUrl);
                        <div class="dl-share-row">
                            <div style="min-width:0;">
                                <div class="dl-share-name">
                                    @dash.Label
                                    @if (connected) { <span class="badge badge-success dl-mini-badge" style="margin-left:6px;">Connected</span> }
                                </div>
                                <div class="dl-share-meta dl-share-meta-mono">@dash.PageUrl</div>
                            </div>
                            @if (connected)
                            {
                                <button class="btn btn-secondary btn-sm dl-btn-danger-outline" @onclick="() => DisconnectDashboard(dash.PageUrl)" disabled="@isSavingLink">Disconnect</button>
                            }
                            else
                            {
                                <button class="btn btn-primary btn-sm" @onclick="() => ConnectDashboard(dash.PageUrl)" disabled="@isSavingLink">Connect</button>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@* ---------- Shared with ---------- *@
@if (showSharedModal)
{
    <div class="fb-modal-backdrop" @onclick="() => showSharedModal = false">
        <div class="fb-modal sc" role="dialog" aria-modal="true" aria-label="Shared with" @onclick:stopPropagation="true">
            <div class="fb-modal-head">
                <div class="fb-modal-title">Shared with <span class="dl-modal-sub">— @sharedTableName</span></div>
                <button class="btn btn-ghost btn-icon" @onclick="() => showSharedModal = false" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>
            <div class="fb-modal-body">
                @if (isLoadingShared)
                {
                    <div class="skeleton dl-skel" style="width:60%;margin-bottom:10px;"></div>
                    <div class="skeleton dl-skel" style="width:40%;"></div>
                }
                else if (!sharedTableUsers.Any())
                {
                    <div class="empty-text">No one has access to this table.</div>
                }
                else
                {
                    <p class="field-help" style="margin:0 0 6px;">People who can access <strong>@sharedTableName</strong>. Users with full dataset access are managed from the datasets page.</p>
                    @foreach (var u in sharedTableUsers)
                    {
                        var fullAccess = !u.Tables.Any();
                        <div class="dl-share-row">
                            <div style="min-width:0;">
                                <div class="dl-share-name">@(string.IsNullOrEmpty(u.Email) ? u.UserId : u.Email)</div>
                                <div class="dl-share-meta">@u.Type · @(fullAccess ? "Full dataset access" : "This table")</div>
                            </div>
                            @if (canEdit)
                            {
                                var lastOne = sharedTableUsers.Count <= 1;
                                @if (fullAccess)
                                {
                                    <button class="btn btn-secondary btn-sm dl-btn-danger-outline"
                                            title="@(lastOne ? "Can't remove the only person this table is shared with." : "This person has access to the whole dataset — removing here revokes their entire dataset access.")"
                                            @onclick="() => RemoveFromDataset(u.UserId)" disabled="@(isRemovingShare || lastOne)">Remove from dataset</button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm dl-btn-danger-outline"
                                            title="@(lastOne ? "Can't remove the only person this table is shared with." : "Stop sharing this table with this person")"
                                            @onclick="() => StopSharingTable(u.UserId)" disabled="@(isRemovingShare || lastOne)">Stop sharing</button>
                                }
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

