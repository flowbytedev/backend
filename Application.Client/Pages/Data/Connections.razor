    /// <summary>
    /// The token-fields grid, as an ordered map. Kept separate from the model because the editor is a grid
    /// and the stored shape is a JSON object; converting on load and save keeps both honest.
    /// </summary>
    private readonly Dictionary<string, string> _tokenFields = new(StringComparer.Ordinal);

    private void LoadTokenFields(string? json)
    {
        _tokenFields.Clear();

        if (string.IsNullOrWhiteSpace(json)) return;

        try
        {
            if (System.Text.Json.Nodes.JsonNode.Parse(json!)
                is System.Text.Json.Nodes.JsonObject obj)
            {
                foreach (var (name, value) in obj)
                    if (!string.IsNullOrWhiteSpace(name))
                        _tokenFields[name] = value?.ToString() ?? string.Empty;
            }
        }
        catch (System.Text.Json.JsonException)
        {
            // A hand-edited row with broken JSON shows an empty grid rather than failing the page. Saving
            // then rewrites it, which is the recovery path.
        }
    }

    private string? TokenFieldsAsJson()
    {
        if (_tokenFields.Count == 0) return null;

        var obj = new System.Text.Json.Nodes.JsonObject();
        foreach (var (name, value) in _tokenFields)
            if (!string.IsNullOrWhiteSpace(name)) obj[name] = value;

        return obj.Count == 0 ? null : obj.ToJsonString();
    }

    private void AddTokenField() => _tokenFields[string.Empty] = string.Empty;

    private void SetTokenField(string name, string? value) => _tokenFields[name] = value ?? string.Empty;

    private void RemoveTokenField(string name) => _tokenFields.Remove(name);

    /// <summary>
    /// Renames a row, preserving order by rebuilding — a plain remove-then-add would send the row to the
    /// bottom of the grid mid-typing, which makes the field impossible to edit.
    /// </summary>
    private void RenameTokenField(string oldName, string? newName)
    {
        var name = (newName ?? string.Empty).Trim();
        if (string.Equals(oldName, name, StringComparison.Ordinal)) return;

        var entries = _tokenFields.Select(kv => (kv.Key, kv.Value)).ToList();
        _tokenFields.Clear();

        foreach (var (key, value) in entries)
            _tokenFields[string.Equals(key, oldName, StringComparison.Ordinal) ? name : key] = value;
    }

    /// <summary>
    /// Seeds the name field an auth type needs, when it is still empty.
    /// <para>
    /// A placeholder is not enough here. It shows the right answer in grey, which reads as already filled in
    /// — and then the save is refused for a missing value the operator believes they supplied. Prefilling
    /// makes the common case correct and still lets it be changed.
    /// </para>
    /// <para>
    /// Only fills a blank. Switching away and back must not overwrite something deliberately typed.
    /// </para>
    /// </summary>
    private void OnAuthTypeChanged()
    {
        if (_editApi is null) return;

        switch (_editApi.AuthType)
        {
            // The name the OAuth2 spec gives it, so it is right for practically every endpoint.
            case ApiAuthTypes.FormField when string.IsNullOrWhiteSpace(_editApi.FormFieldName):
                _editApi.FormFieldName = "client_secret";
                break;

            case ApiAuthTypes.OAuth2:
                if (string.IsNullOrWhiteSpace(_editApi.FormFieldName))
                    _editApi.FormFieldName = "client_secret";

                // The three fields a client-credentials request always has. Seeded so the grid opens with
                // the shape of the answer rather than empty — grant_type is the same for every provider.
                if (_tokenFields.Count == 0)
                {
                    _tokenFields["grant_type"] = "client_credentials";
                    _tokenFields["client_id"] = string.Empty;
                    _tokenFields["scope"] = string.Empty;
                }
                break;

            // No comparable convention for these two — a header could be X-Api-Key, Authorization or
            // anything the vendor chose, so guessing would be worse than an empty box.
            case ApiAuthTypes.Header:
            case ApiAuthTypes.QueryParam:
                break;
        }
    }

    private static string AuthLabel(string? authType) => authType switch
    {
        ApiAuthTypes.Bearer => "Bearer",
        ApiAuthTypes.Basic => "Basic",
        ApiAuthTypes.Header => "Header",
        ApiAuthTypes.QueryParam => "Query",
        ApiAuthTypes.FormField => "Form field",
        ApiAuthTypes.OAuth2 => "OAuth2",
        _ => "None"
    };

    private sealed class ApiCredentialModel
    {
        public string? Id { get; set; }
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? BaseUrl { get; set; }
        public string? AuthType { get; set; }
        public string? Username { get; set; }
        public string? HeaderName { get; set; }
        public string? QueryParamName { get; set; }
        public string? FormFieldName { get; set; }
        public string? TokenUrl { get; set; }
        public string? TokenFieldsJson { get; set; }
        public string? ExtraHeadersJson { get; set; }
        public bool AllowWrite { get; set; }
        public bool AllowInvalidCertificate { get; set; }
        public bool IsEnabled { get; set; }
        public int? TimeoutSeconds { get; set; }
        public bool HasSecret { get; set; }
    }

    /// <summary>Mirrors the server's DatabaseConnectionRowDto. Never carries the secret.</summary>
    private sealed class DatabaseRowModel
    {
        public string? EntityId { get; set; }
        public string? EntityName { get; set; }
        public string? Description { get; set; }
        public bool Configured { get; set; }
        public DataSourceType DatabaseType { get; set; }
        public string? Host { get; set; }
        public int Port { get; set; }
        public string? DatabaseName { get; set; }
        public string? Username { get; set; }
        public string? FilePath { get; set; }
        public bool UseSsl { get; set; }
        public bool HasSecret { get; set; }
    }

    private sealed class WriteCredentialModel
    {
        public string? EntityId { get; set; }
        public string? EntityName { get; set; }
        public bool Configured { get; set; }
        public string? Username { get; set; }
        public bool AllowCreateTable { get; set; }
        public bool HasSecret { get; set; }
    }
