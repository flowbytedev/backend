@*
    The credentials a pipeline needs but must never store itself.

    Both kinds on one page because they answer the same question — "what is this pipeline allowed to reach?"
    — and because both were previously reachable only by hand-writing SQL. Secrets are write-only
    throughout: the server never returns one, so a blank secret box means "keep what is stored", never
    "clear it".
*@
@page "/data/connections"
@using System.Net.Http.Json
@using Application.Shared.Authorization
@using Application.Shared.Enums
@using Application.Shared.Models
@using Application.Shared.Models.Data
@inject HttpClient _httpClient
@inject IToastService _toastService
@inject NavigationManager _navigationManager
@inject AuthenticationStateProvider _authenticationStateProvider
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize(Policy = PolicyNames.DataAdminAccess)]

<PageTitle>Connections</PageTitle>

@if (!_canView && !_loading)
{
    <div class="sc">
        <div class="page-wrap">
            <div class="empty">
                <div class="empty-title">Access denied</div>
                <div class="empty-text">You don't have permission to manage connections.</div>
            </div>
        </div>
    </div>
}
else
{
    <div class="sc">
        <div class="page-wrap">
            <div class="page-header">
                <h1 class="page-title">Connections</h1>
                <p class="page-subtitle">
                    Everything the data module is allowed to reach: the databases datasets and pipelines
                    read from, and the credentials pipeline steps use by name. Kept here rather than on the
                    step, so a token is never stored in a pipeline's document or shown in its YAML.
                </p>
            </div>

            <div class="tabs">
                <button class="tab @(_tab == Tab.Databases ? "is-active" : "")"
                        @onclick="() => _tab = Tab.Databases">
                    Databases
                    <span class="tab-count">@_databases.Count(d => d.Configured)</span>
                </button>
                <button class="tab @(_tab == Tab.Api ? "is-active" : "")" @onclick="() => _tab = Tab.Api">
                    API credentials
                    <span class="tab-count">@_apis.Count</span>
                </button>
                <button class="tab @(_tab == Tab.Write ? "is-active" : "")" @onclick="() => _tab = Tab.Write">
                    Database write access
                    <span class="tab-count">@_writes.Count(w => w.Configured)</span>
                </button>
            </div>

            @if (_loading)
            {
                <div class="card"><div class="card-body">
                    <div class="skeleton" style="height:18px;margin-bottom:8px;"></div>
                    <div class="skeleton" style="height:18px;width:70%;"></div>
                </div></div>
            }
            else if (_tab == Tab.Databases)
            {
                <div class="action-bar">
                    <span class="action-bar-spacer"></span>
                    <button class="btn btn-primary" @onclick="StartCreateDatabase">New database</button>
                </div>

                @if (_databases.Count == 0)
                {
                    <div class="card"><div class="empty">
                        <div class="empty-title">No databases yet</div>
                        <div class="empty-text">
                            Add one to back a dataset with an external database, or to read from it in a
                            pipeline.
                        </div>
                    </div></div>
                }
                else
                {
                    <div class="card">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Engine</th>
                                    <th>Server</th>
                                    <th>Login</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _databases)
                                {
                                    <tr @key="row.EntityId">
                                        <td>
                                            <div class="cell-strong">@row.EntityName</div>
                                            @if (!string.IsNullOrWhiteSpace(row.Description))
                                            {
                                                <div class="cell-sub">@row.Description</div>
                                            }
                                        </td>
                                        <td>
                                            @if (row.Configured)
                                            {
                                                <span>@DatabaseConnectionFields.EngineLabel(row.DatabaseType)</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning">no connection</span>
                                            }
                                        </td>
                                        <td class="cell-mono">
                                            @if (!row.Configured)
                                            {
                                                <span>—</span>
                                            }
                                            else if (row.DatabaseType == DataSourceType.DuckDB)
                                            {
                                                <span>@row.FilePath</span>
                                            }
                                            else
                                            {
                                                <span>@row.Host@(row.Port > 0 ? $":{row.Port}" : "")/@row.DatabaseName</span>
                                            }
                                        </td>
                                        <td class="cell-mono">@(row.Configured ? row.Username ?? "—" : "—")</td>
                                        <td class="table-actions">
                                            <button class="btn btn-ghost btn-sm" @onclick="() => StartEditDatabase(row)">
                                                @(row.Configured ? "Edit" : "Add connection")
                                            </button>
                                            @if (row.Configured)
                                            {
                                                <button class="btn btn-ghost btn-sm"
                                                        @onclick="() => TestDatabase(row)">Test</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else if (_tab == Tab.Api)
            {
                <div class="action-bar">
                    <span class="action-bar-spacer"></span>
                    <button class="btn btn-primary" @onclick="StartCreateApi">New API credential</button>
                </div>

                @if (_apis.Count == 0)
                {
                    <div class="card"><div class="empty">
                        <div class="empty-title">No API credentials yet</div>
                        <div class="empty-text">
                            Add one to use the API source or destination steps in a pipeline.
                        </div>
                    </div></div>
                }
                else
                {
                    <div class="card">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Base URL</th>
                                    <th>Auth</th>
                                    <th>May send data</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _apis)
                                {
                                    <tr @key="row.Id">
                                        <td>
                                            <div class="cell-strong">@row.Name</div>
                                            @if (!string.IsNullOrWhiteSpace(row.Description))
                                            {
                                                <div class="cell-sub">@row.Description</div>
                                            }
                                        </td>
                                        <td class="cell-mono">@(row.BaseUrl ?? "—")</td>
                                        <td>
                                            @AuthLabel(row.AuthType)
                                            @if (!row.HasSecret && row.AuthType != ApiAuthTypes.None)
                                            {
                                                <span class="badge badge-warning">no secret</span>
                                            }
                                            @* Shown in the list, not only in the form: a credential that
                                               stopped verifying its host months ago should be visible
                                               without opening it. *@
                                            @if (row.AllowInvalidCertificate)
                                            {
                                                <span class="badge badge-warning"
                                                      title="TLS certificate validation is off for this credential">
                                                    unverified TLS
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (row.AllowWrite)
                                            {
                                                <span class="badge badge-warning">yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge">read only</span>
                                            }
                                        </td>
                                        <td>
                                            @if (row.IsEnabled)
                                            {
                                                <span class="badge badge-success">enabled</span>
                                            }
                                            else
                                            {
                                                <span class="badge">disabled</span>
                                            }
                                        </td>
                                        <td class="table-actions">
                                            <button class="btn btn-ghost btn-sm" @onclick="() => StartEditApi(row)">Edit</button>
                                            <button class="btn btn-ghost btn-sm" @onclick="() => DeleteApi(row)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                <div class="card">
                    <div class="card-body">
                        <p class="field-help">
                            A pipeline writing into an <strong>external</strong> dataset needs a credential
                            that is allowed to INSERT. The read-only connection the dataset already uses is
                            deliberately not reused for this — a write is refused rather than escalated.
                            Host, port and database still come from the entity's existing connection; only
                            the login differs.
                        </p>
                    </div>
                </div>

                @if (_writes.Count == 0)
                {
                    <div class="card"><div class="empty">
                        <div class="empty-title">No database entities</div>
                        <div class="empty-text">Register a database entity first.</div>
                    </div></div>
                }
                else
                {
                    <div class="card">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Database</th>
                                    <th>Write login</th>
                                    <th>May create tables</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _writes)
                                {
                                    <tr @key="row.EntityId">
                                        <td><div class="cell-strong">@row.EntityName</div></td>
                                        <td>
                                            @if (row.Configured)
                                            {
                                                <span class="cell-mono">@row.Username</span>
                                            }
                                            else
                                            {
                                                <span class="cell-sub">not configured — pipelines cannot write here</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!row.Configured)
                                            {
                                                <span>—</span>
                                            }
                                            else if (row.AllowCreateTable)
                                            {
                                                <span class="badge badge-warning">yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge">no</span>
                                            }
                                        </td>
                                        <td class="table-actions">
                                            <button class="btn btn-ghost btn-sm" @onclick="() => StartEditWrite(row)">
                                                @(row.Configured ? "Edit" : "Add")
                                            </button>
                                            @if (row.Configured)
                                            {
                                                <button class="btn btn-ghost btn-sm" @onclick="() => DeleteWrite(row)">Remove</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>

    @* ---------------- database connection editor ---------------- *@
    @if (_editDatabase is not null)
    {
        <div class="sc">
            <div class="fb-modal-backdrop" @onclick="CancelDatabaseEdit">
                <div class="fb-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                    <div class="fb-modal-head">
                        <h2 class="fb-modal-title">
                            @(_editDatabaseIsNew ? "New database" : $"Edit {_editDatabase.EntityName}")
                        </h2>
                    </div>
                    <div class="fb-modal-body">
                        @if (_editDatabaseIsNew)
                        {
                            <div class="field">
                                <label class="field-label">Name</label>
                                <input class="input" @bind="_editDatabase.EntityName" @bind:event="oninput"
                                       placeholder="Warehouse" />
                                <div class="field-help">
                                    How this database is listed when picking a dataset source or wiring a
                                    pipeline step. It also becomes an entity in the dependency map.
                                </div>
                            </div>

                            <div class="field">
                                <label class="field-label">Description</label>
                                <input class="input" @bind="_editDatabase.Description" @bind:event="oninput" />
                            </div>
                        }

                        <DatabaseConnectionFields Form="_databaseForm"
                                                  HasSavedSecret="_editDatabase.HasSecret" />

                        <div class="field-help" style="margin-top:0.75rem;">
                            Read access. A pipeline that needs to <em>write</em> into this database uses a
                            separate login, under <strong>Database write access</strong>.
                        </div>

                        @if (_error is not null)
                        {
                            <div class="form-error">@_error</div>
                        }
                        @if (_databaseTestMessage is not null)
                        {
                            <div class="field-help" style="margin-top:0.5rem;">@_databaseTestMessage</div>
                        }
                    </div>
                    <div class="fb-modal-foot">
                        @if (!_editDatabaseIsNew && _editDatabase.Configured)
                        {
                            <button class="btn btn-ghost" disabled="@_saving"
                                    @onclick="DeleteDatabaseConnection">Remove connection</button>
                            <button class="btn btn-ghost" disabled="@_saving"
                                    @onclick="() => TestDatabase(_editDatabase!)">Test</button>
                        }
                        <span class="action-bar-spacer"></span>
                        <button class="btn btn-ghost" @onclick="CancelDatabaseEdit">Cancel</button>
                        <button class="btn btn-primary" disabled="@_saving" @onclick="SaveDatabase">
                            @(_saving ? "Saving…" : "Save")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ---------------- API credential editor ---------------- *@
    @if (_editApi is not null)
    {
        <div class="sc">
            <div class="fb-modal-backdrop" @onclick="() => _editApi = null">
                <div class="fb-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                    <div class="fb-modal-head">
                        <h2 class="fb-modal-title">@(_editApiIsNew ? "New API credential" : $"Edit {_editApiOriginalName}")</h2>
                    </div>
                    <div class="fb-modal-body">
                        <div class="field">
                            <label class="field-label">Name</label>
                            <input class="input" @bind="_editApi.Name" @bind:event="oninput" placeholder="erp-api" />
                            <div class="field-help">How pipeline steps refer to this. Changing it breaks steps that use the old name.</div>
                        </div>

                        <div class="field">
                            <label class="field-label">Description</label>
                            <input class="input" @bind="_editApi.Description" @bind:event="oninput" />
                        </div>

                        <div class="field">
                            <label class="field-label">Base URL</label>
                            <input class="input" @bind="_editApi.BaseUrl" @bind:event="oninput"
                                   placeholder="https://erp.internal/api/v2/" />
                            <div class="field-help">
                                Optional, but recommended: steps then use relative paths, and this credential
                                cannot be pointed at any other host.
                            </div>
                        </div>

                        <div class="field">
                            <label class="field-label">Authentication</label>
                            <select class="select" @bind="_editApi.AuthType" @bind:after="OnAuthTypeChanged">
                                <option value="@ApiAuthTypes.None">None</option>
                                <option value="@ApiAuthTypes.Bearer">Bearer token</option>
                                <option value="@ApiAuthTypes.Basic">Basic (username + password)</option>
                                <option value="@ApiAuthTypes.Header">Secret in a header</option>
                                <option value="@ApiAuthTypes.QueryParam">Secret in a query parameter</option>
                                <option value="@ApiAuthTypes.FormField">Secret in a form field (OAuth2 client_secret)</option>
                                <option value="@ApiAuthTypes.OAuth2">OAuth2 client credentials (fetches a token for you)</option>
                            </select>
                        </div>

                        @if (_editApi.AuthType == ApiAuthTypes.Basic)
                        {
                            <div class="field">
                                <label class="field-label">Username</label>
                                <input class="input" @bind="_editApi.Username" @bind:event="oninput" />
                            </div>
                        }

                        @if (_editApi.AuthType == ApiAuthTypes.Header)
                        {
                            <div class="field">
                                <label class="field-label">Header name</label>
                                <input class="input" @bind="_editApi.HeaderName" @bind:event="oninput"
                                       placeholder="X-Api-Key" />
                            </div>
                        }

                        @if (_editApi.AuthType == ApiAuthTypes.QueryParam)
                        {
                            <div class="field">
                                <label class="field-label">Query parameter name</label>
                                <input class="input" @bind="_editApi.QueryParamName" @bind:event="oninput"
                                       placeholder="api_key" />
                                <div class="field-help">
                                    Weaker than a header — query strings are recorded in proxy and server logs.
                                    Use it only when the API offers nothing else.
                                </div>
                            </div>
                        }

                        @if (_editApi.AuthType == ApiAuthTypes.OAuth2)
                        {
                            <div class="field">
                                <label class="field-label">Token URL</label>
                                <input class="input" @bind="_editApi.TokenUrl" @bind:event="oninput"
                                       placeholder="https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token" />
                                <div class="field-help">
                                    Where the token is fetched from. Exempt from the base URL restriction
                                    above — a token endpoint is nearly always on a different host from the
                                    API it issues tokens for.
                                </div>
                            </div>

                            <div class="field">
                                <label class="field-label">Token fields</label>
                                <div class="pl-row-head pl-kv-row">
                                    <span>Name</span><span>Value</span><span></span>
                                </div>
                                @foreach (var name in _tokenFields.Keys.ToList())
                                {
                                    var key = name;
                                    <div class="pl-kv-row">
                                        <input class="input input-mono" value="@key"
                                               @onchange="e => RenameTokenField(key, e.Value?.ToString())" />
                                        <input class="input input-mono" value="@_tokenFields[key]"
                                               @onchange="e => SetTokenField(key, e.Value?.ToString())" />
                                        <button class="btn btn-ghost btn-sm"
                                                @onclick="() => RemoveTokenField(key)">✕</button>
                                    </div>
                                }
                                <button class="btn btn-ghost btn-sm" @onclick="AddTokenField">Add</button>
                                <div class="field-help">
                                    Posted to the token endpoint, form-encoded — values are encoded for you.
                                    The client_secret is NOT a row here: it goes in Secret below, under the
                                    field name given above.
                                </div>
                            </div>

                            <div class="field">
                                <label class="field-label">Secret field name</label>
                                <input class="input" @bind="_editApi.FormFieldName" @bind:event="oninput"
                                       placeholder="client_secret" />
                                <div class="field-help">
                                    Which field carries the secret. Empty means client_secret.
                                </div>
                            </div>
                        }

                        @if (_editApi.AuthType == ApiAuthTypes.FormField)
                        {
                            <div class="field">
                                <label class="field-label">Form field name</label>
                                <input class="input" @bind="_editApi.FormFieldName" @bind:event="oninput"
                                       placeholder="client_secret" />
                                <div class="field-help">
                                    Appended to the step's form-encoded body, so the secret stays here rather
                                    than in the pipeline's own body field — which is stored in the clear and
                                    copied onto every run. The step must POST with content type
                                    application/x-www-form-urlencoded.
                                </div>
                            </div>
                        }

                        @if (_editApi.AuthType != ApiAuthTypes.None)
                        {
                            <div class="field">
                                <label class="field-label">
                                    @(_editApi.AuthType == ApiAuthTypes.Basic ? "Password" : "Secret")
                                </label>
                                <input class="input" type="password" autocomplete="new-password"
                                       @bind="_secret" @bind:event="oninput" />
                                <div class="field-help">
                                    @if (_editApiIsNew)
                                    {
                                        <span>Stored encrypted. It is never shown again after saving.</span>
                                    }
                                    else if (_editApi.HasSecret)
                                    {
                                        <span>A secret is stored. Leave this empty to keep it.</span>
                                    }
                                    else
                                    {
                                        <span>No secret is stored yet.</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="field">
                            <label class="field-label">Extra headers</label>
                            <textarea class="textarea" rows="3" @bind="_editApi.ExtraHeadersJson" @bind:event="oninput"
                                      placeholder='{"Accept": "application/json"}'></textarea>
                            <div class="field-help">A JSON object, sent on every request. Not for secrets.</div>
                        </div>

                        <div class="field">
                            <label class="field-label">Timeout (seconds)</label>
                            <input class="input" type="number" min="1" max="3600"
                                   value="@(_editApi.TimeoutSeconds?.ToString() ?? string.Empty)"
                                   @oninput="e => _editApi.TimeoutSeconds = int.TryParse(e.Value?.ToString(), out var t) ? t : null" />
                            <div class="field-help">Empty uses the server default.</div>
                        </div>

                        <div class="field field-check">
                            <label>
                                <input type="checkbox" @bind="_editApi.AllowWrite" />
                                May send data
                            </label>
                            <div class="field-help">
                                Required for a "Send to API" step. Leave off for a credential that only reads —
                                a destination using it is refused outright, not downgraded.
                            </div>
                        </div>

                        <div class="field field-check">
                            <label>
                                <input type="checkbox" @bind="_editApi.AllowInvalidCertificate" />
                                Accept an invalid TLS certificate
                            </label>
                            <div class="field-help">
                                For an internal endpoint whose certificate this server does not trust —
                                self-signed, expired, or issued to a different name. It turns off the check
                                that the host is who it claims to be, so requests through this credential,
                                including its secret, can be read and altered by anything on the path.
                                Prefer installing the issuing certificate on the server where that is possible.
                            </div>
                        </div>

                        <div class="field field-check">
                            <label>
                                <input type="checkbox" @bind="_editApi.IsEnabled" />
                                Enabled
                            </label>
                            <div class="field-help">Turning this off stops every step that uses it, without deleting anything.</div>
                        </div>

                        @if (_error is not null)
                        {
                            <div class="form-error">@_error</div>
                        }
                    </div>
                    <div class="fb-modal-foot">
                        <button class="btn btn-ghost" @onclick="() => _editApi = null">Cancel</button>
                        <button class="btn btn-primary" disabled="@_saving" @onclick="SaveApi">
                            @(_saving ? "Saving…" : "Save")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ---------------- write credential editor ---------------- *@
    @if (_editWrite is not null)
    {
        <div class="sc">
            <div class="fb-modal-backdrop" @onclick="() => _editWrite = null">
                <div class="fb-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                    <div class="fb-modal-head">
                        <h2 class="fb-modal-title">Write access to @_editWrite.EntityName</h2>
                    </div>
                    <div class="fb-modal-body">
                        <div class="field">
                            <label class="field-label">Login</label>
                            <input class="input" @bind="_editWrite.Username" @bind:event="oninput" />
                        </div>

                        <div class="field">
                            <label class="field-label">Password</label>
                            <input class="input" type="password" autocomplete="new-password"
                                   @bind="_secret" @bind:event="oninput" />
                            <div class="field-help">
                                @(_editWrite.HasSecret
                                    ? "A password is stored. Leave this empty to keep it."
                                    : "Stored encrypted; never shown again.")
                            </div>
                        </div>

                        <div class="field field-check">
                            <label>
                                <input type="checkbox" @bind="_editWrite.AllowCreateTable" />
                                May create tables
                            </label>
                            <div class="field-help">
                                Lets a pipeline issue CREATE TABLE inside that database. Off unless you need
                                "create the table if it does not exist" to work.
                            </div>
                        </div>

                        @if (_error is not null)
                        {
                            <div class="form-error">@_error</div>
                        }
                    </div>
                    <div class="fb-modal-foot">
                        <button class="btn btn-ghost" @onclick="() => _editWrite = null">Cancel</button>
                        <button class="btn btn-primary" disabled="@_saving" @onclick="SaveWrite">
                            @(_saving ? "Saving…" : "Save")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private enum Tab { Databases, Api, Write }

    [SupplyParameterFromQuery(Name = "c")] public string? c { get; set; }

    /// <summary>
    /// Deep link from a database entity's page: open this database's connection straight away, so
    /// "Edit on the Connections page" lands on the right row rather than on a list to search.
    /// </summary>
    [SupplyParameterFromQuery(Name = "db")] public string? db { get; set; }

    private string _companyId = string.Empty;
    private bool _canView;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private Tab _tab = Tab.Databases;

    private List<DatabaseRowModel> _databases = new();
    private List<ApiCredentialModel> _apis = new();
    private List<WriteCredentialModel> _writes = new();

    private DatabaseRowModel? _editDatabase;
    private bool _editDatabaseIsNew;
    private string? _databaseTestMessage;

    /// <summary>
    /// The connection being edited. Separate from the row model for the same reason the secret is: the row
    /// came from the server and is what the table renders, and cancelling must leave it untouched.
    /// </summary>
    private DatabaseConnectionRequest _databaseForm = new();

    private ApiCredentialModel? _editApi;
    private bool _editApiIsNew;
    private string? _editApiOriginalName;

    private WriteCredentialModel? _editWrite;

    /// <summary>
    /// Held apart from the bound model, because the model round-trips from the server and the server never
    /// sends a secret. Keeping them separate is what makes "empty means keep" unambiguous.
    /// </summary>
    private string _secret = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _companyId = c ?? string.Empty;

        var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
        _canView = authState.User.HasCompanyRole(_companyId, "DATA_ADMIN");
        if (!_canView) { _loading = false; return; }

        _httpClient.DefaultRequestHeaders.Remove("X-Company-Id");
        _httpClient.DefaultRequestHeaders.Add("X-Company-Id", _companyId);

        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            _httpClient.DefaultRequestHeaders.Remove("UserId");
            _httpClient.DefaultRequestHeaders.Add("UserId", userId);
        }

        await Load();

        // Honoured after the first load, so the row it names exists to open.
        if (!string.IsNullOrWhiteSpace(db))
        {
            var target = _databases.FirstOrDefault(d => d.EntityId == db);
            if (target is not null) StartEditDatabase(target);
        }
    }

    private async Task Load()
    {
        _loading = true;

        try
        {
            _databases = await _httpClient.GetFromJsonAsync<List<DatabaseRowModel>>("api/database-connections")
                         ?? new();
        }
        catch (Exception ex)
        {
            _databases = new();
            _toastService.ShowError($"Could not load databases: {ex.Message}");
        }

        try
        {
            _apis = await _httpClient.GetFromJsonAsync<List<ApiCredentialModel>>("api/api-credentials")
                    ?? new();
        }
        catch (Exception ex)
        {
            _apis = new();
            _toastService.ShowError($"Could not load API credentials: {ex.Message}");
        }

        try
        {
            _writes = await _httpClient
                          .GetFromJsonAsync<List<WriteCredentialModel>>("api/database-write-credentials")
                      ?? new();
        }
        catch (Exception ex)
        {
            _writes = new();
            _toastService.ShowError($"Could not load database write access: {ex.Message}");
        }

        _loading = false;
    }

    // ---------------- databases ----------------

    private void StartCreateDatabase()
    {
        _editDatabase = new DatabaseRowModel { DatabaseType = DataSourceType.SQLServer };
        _databaseForm = new DatabaseConnectionRequest
        {
            DatabaseType = DataSourceType.SQLServer,
            Port = DatabaseConnectionFields.DefaultPort(DataSourceType.SQLServer)
        };
        _editDatabaseIsNew = true;
        _databaseTestMessage = null;
        _error = null;
    }

    private void StartEditDatabase(DatabaseRowModel row)
    {
        // A copy, so cancelling leaves the table untouched.
        _editDatabase = new DatabaseRowModel
        {
            EntityId = row.EntityId,
            EntityName = row.EntityName,
            Description = row.Description,
            Configured = row.Configured,
            DatabaseType = row.DatabaseType,
            Host = row.Host,
            Port = row.Port,
            DatabaseName = row.DatabaseName,
            Username = row.Username,
            FilePath = row.FilePath,
            UseSsl = row.UseSsl,
            HasSecret = row.HasSecret
        };

        _databaseForm = new DatabaseConnectionRequest
        {
            DatabaseType = row.Configured ? row.DatabaseType : DataSourceType.SQLServer,
            Host = row.Host,
            Port = row.Configured ? row.Port : DatabaseConnectionFields.DefaultPort(DataSourceType.SQLServer),
            DatabaseName = row.DatabaseName,
            Username = row.Username,
            FilePath = row.FilePath,
            UseSsl = row.UseSsl,
            // Never prefilled: the server does not return it, and an empty box means "keep it".
            Secret = null
        };

        _editDatabaseIsNew = false;
        _databaseTestMessage = null;
        _error = null;
        _tab = Tab.Databases;
    }

    private void CancelDatabaseEdit()
    {
        _editDatabase = null;
        _databaseTestMessage = null;
        _error = null;
    }

    private async Task SaveDatabase()
    {
        if (_editDatabase is null) return;

        if (_editDatabaseIsNew && string.IsNullOrWhiteSpace(_editDatabase.EntityName))
        {
            _error = "Give this database a name.";
            return;
        }

        _saving = true;
        _error = null;
        _databaseTestMessage = null;

        try
        {
            HttpResponseMessage response;

            if (_editDatabaseIsNew)
            {
                response = await _httpClient.PostAsJsonAsync("api/database-connections", new
                {
                    Name = _editDatabase.EntityName,
                    _editDatabase.Description,
                    Connection = _databaseForm
                });
            }
            else
            {
                response = await _httpClient.PutAsJsonAsync(
                    $"api/database-connections/{_editDatabase.EntityId}", _databaseForm);
            }

            if (!response.IsSuccessStatusCode)
            {
                _error = await response.Content.ReadAsStringAsync();
                _saving = false;
                return;
            }

            _toastService.ShowSuccess($"Saved {_editDatabase.EntityName}.");
            _editDatabase = null;
            _databaseForm = new DatabaseConnectionRequest();
            await Load();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        _saving = false;
    }

    private async Task TestDatabase(DatabaseRowModel row)
    {
        _databaseTestMessage = "Testing…";
        StateHasChanged();

        try
        {
            var response = await _httpClient.PostAsync(
                $"api/database-connections/{row.EntityId}/test", null);

            var result = await response.Content.ReadFromJsonAsync<DatabaseConnectionTestResult>();

            // Reported against what is STORED, not against what is on screen: an unsaved edit has not
            // reached the server, and saying "connection succeeded" about the old details would be a lie.
            var message = result?.Ok == true
                ? "The stored connection works."
                : $"The stored connection failed: {result?.Error ?? "unknown error"}";

            if (_editDatabase is not null) _databaseTestMessage = message;
            else if (result?.Ok == true) _toastService.ShowSuccess(message);
            else _toastService.ShowError(message);
        }
        catch (Exception ex)
        {
            if (_editDatabase is not null) _databaseTestMessage = ex.Message;
            else _toastService.ShowError(ex.Message);
        }

        StateHasChanged();
    }

    private async Task DeleteDatabaseConnection()
    {
        if (_editDatabase is null) return;

        _saving = true;
        _error = null;

        try
        {
            var response = await _httpClient.DeleteAsync(
                $"api/database-connections/{_editDatabase.EntityId}");

            if (!response.IsSuccessStatusCode)
            {
                _error = await response.Content.ReadAsStringAsync();
                _saving = false;
                return;
            }

            // The entity itself is left alone. Removing the connection is undoing a configuration; removing
            // the database from the dependency map is a different decision, made on its own page.
            _toastService.ShowSuccess($"Removed the connection to {_editDatabase.EntityName}.");
            _editDatabase = null;
            await Load();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        _saving = false;
    }

    // ---------------- API credentials ----------------

    private void StartCreateApi()
    {
        _tokenFields.Clear();
        _editApi = new ApiCredentialModel { AuthType = ApiAuthTypes.None, IsEnabled = true };
        _editApiIsNew = true;
        _editApiOriginalName = null;
        _secret = string.Empty;
        _error = null;
    }

    private void StartEditApi(ApiCredentialModel row)
    {
        // A copy, so cancelling leaves the table untouched.
        _editApi = new ApiCredentialModel
        {
            Id = row.Id,
            Name = row.Name,
            Description = row.Description,
            BaseUrl = row.BaseUrl,
            AuthType = row.AuthType,
            Username = row.Username,
            HeaderName = row.HeaderName,
            QueryParamName = row.QueryParamName,
            FormFieldName = row.FormFieldName,
            TokenUrl = row.TokenUrl,
            TokenFieldsJson = row.TokenFieldsJson,
            ExtraHeadersJson = row.ExtraHeadersJson,
            AllowWrite = row.AllowWrite,
            AllowInvalidCertificate = row.AllowInvalidCertificate,
            IsEnabled = row.IsEnabled,
            TimeoutSeconds = row.TimeoutSeconds,
            HasSecret = row.HasSecret
        };
        LoadTokenFields(row.TokenFieldsJson);
        _editApiIsNew = false;
        _editApiOriginalName = row.Name;
        _secret = string.Empty;
        _error = null;
    }

    private async Task SaveApi()
    {
        if (_editApi is null) return;

        _saving = true;
        _error = null;

        var payload = new
        {
            _editApi.Name,
            _editApi.Description,
            _editApi.BaseUrl,
            _editApi.AuthType,
            _editApi.Username,
            Secret = string.IsNullOrEmpty(_secret) ? null : _secret,
            _editApi.HeaderName,
            _editApi.QueryParamName,
            _editApi.FormFieldName,
            _editApi.TokenUrl,
            // Serialized from the grid rather than bound directly: the grid is the editor, the JSON is the
            // storage shape.
            TokenFieldsJson = TokenFieldsAsJson(),
            _editApi.ExtraHeadersJson,
            _editApi.AllowWrite,
            _editApi.AllowInvalidCertificate,
            _editApi.IsEnabled,
            _editApi.TimeoutSeconds
        };

        try
        {
            var response = _editApiIsNew
                ? await _httpClient.PostAsJsonAsync("api/api-credentials", payload)
                : await _httpClient.PutAsJsonAsync($"api/api-credentials/{_editApi.Id}", payload);

            if (!response.IsSuccessStatusCode)
            {
                _error = await response.Content.ReadAsStringAsync();
                _saving = false;
                return;
            }

            _toastService.ShowSuccess($"Saved {_editApi.Name}.");
            _editApi = null;
            _secret = string.Empty;
            await Load();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        _saving = false;
    }

    private async Task DeleteApi(ApiCredentialModel row)
    {
        try
        {
            var response = await _httpClient.DeleteAsync($"api/api-credentials/{row.Id}");

            if (!response.IsSuccessStatusCode)
            {
                // The server refuses when pipelines still reference it, and names them.
                _toastService.ShowError(await response.Content.ReadAsStringAsync());
                return;
            }

            _toastService.ShowSuccess($"Deleted {row.Name}.");
            await Load();
        }
        catch (Exception ex)
        {
            _toastService.ShowError(ex.Message);
        }
    }

