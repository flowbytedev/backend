@page "/status/incidents/{IncidentId}"
@using Application.Shared.Enums
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject NavigationManager Navigation
@inject IncidentClientService IncidentService
@inject AssetStatusHistoryClientService HistoryService
@inject EntityAudienceClientService AudienceService
@inject StateContainer StateContainer
@attribute [Authorize(Policy = PolicyNames.StatusRead)]

<PageTitle>@(incident?.Title ?? "Incident") · Status</PageTitle>

@* Styles: Application/wwwroot/status.css (.st-steps, .st-tl, .st-compose). *@
<div class="sc">
    <div class="page-wrap st-wrap">
        @if (isLoading)
        {
            <div class="card"><div class="st-loading"><span class="spin"></span> Loading incident…</div></div>
        }
        else if (incident is null)
        {
            <div class="card">
                <div class="empty">
                    <div class="dl-empty-icon">@StatusUi.Icon("inbox", 20)</div>
                    <div class="empty-title">Incident not found</div>
                    <div class="empty-text">It may have been deleted, or it belongs to another company.</div>
                    <a class="btn btn-secondary btn-sm" href="@($"status/incidents{queryParam}")">Back to incidents</a>
                </div>
            </div>
        }
        else
        {
            var resolved = incident.Status == IncidentStatus.Resolved;
            <div class="st-head">
                <div class="st-head-left">
                    <a class="st-back" href="@($"status/incidents{queryParam}")" title="Back to incidents" aria-label="Back to incidents">@StatusUi.Icon("arrow-left", 16)</a>
                    <div class="st-head-main">
                        <div class="st-crumbs">
                            <a href="@($"status/incidents{queryParam}")">Incidents</a>
                            @StatusUi.Icon("chev-right", 12)<span class="st-mono">@ShortId</span>
                        </div>
                        <div class="st-title-row">
                            <h1 class="page-title">@incident.Title</h1>
                            <span class="badge @StatusUi.Cls(incident.Severity)"><i></i>@incident.Severity</span>
                            <span class="badge @StatusUi.Cls(incident.Status)"><i></i>@incident.Status</span>
                        </div>
                        <div class="st-meta">
                            @if (incident.Entity is not null)
                            {
                                <span class="st-meta-item">
                                    @StatusUi.TypeSvg(incident.Entity.EntityType, 12)
                                    <a href="@($"status/entities/{incident.EntityId}{queryParam}")">@incident.Entity.Name</a>
                                    @if (entityStatus.HasValue)
                                    {
                                        <span class="st-status @StatusUi.Cls(entityStatus.Value)" style="margin-left:4px"><span class="st-dot"></span> @StatusUi.Label(entityStatus.Value)</span>
                                    }
                                </span>
                            }
                            <span>Opened @StatusUi.FullWhen(incident.StartedAt)@(string.IsNullOrWhiteSpace(incident.ReportedBy) ? "" : $" by {incident.ReportedBy}")</span>
                            <span>@(resolved ? "Lasted" : "Ongoing") <b class="st-mono" style="color:var(--text-primary)">@StatusUi.Duration(incident.Duration)</b></span>
                            @if (!string.IsNullOrWhiteSpace(incident.ExternalIncidentId)) { <span class="chip">@incident.ExternalIncidentId</span> }
                        </div>
                    </div>
                </div>
                <AuthorizeView Roles="@writeRoles">
                    <Authorized>
                        <div class="st-head-actions">
                            @if (!resolved)
                            {
                                <button class="btn btn-secondary st-btn-success" type="button" @onclick="OpenResolve">@StatusUi.Icon("check-circle", 14) Resolve…</button>
                            }
                            <a class="btn btn-secondary" href="@($"status/incidents/{IncidentId}/edit{queryParam}")">@StatusUi.Icon("edit", 14) Edit</a>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>

            <div class="card" style="margin-bottom:16px">
                <div class="st-steps" role="list" aria-label="Incident progress">
                    @{ var currentIdx = Array.IndexOf(StatusUi.Flow, incident.Status); }
                    @for (var i = 0; i < StatusUi.Flow.Length; i++)
                    {
                        var s = StatusUi.Flow[i];
                        var reached = StepTime(s);
                        var state = i < currentIdx ? "is-done" : i == currentIdx ? $"is-current {StatusUi.Cls(s)}" : "";
                        if (resolved && i == currentIdx) state = "is-done";
                        <div class="st-step @state" role="listitem">
                            <div class="st-step-bar"></div>
                            <div class="st-step-name">@s</div>
                            <div class="st-step-time">
                                @if (i == currentIdx && !resolved && reached.HasValue)
                                {
                                    <span>since @StatusUi.When(reached) · @StatusUi.Duration(DateTime.UtcNow - DateTime.SpecifyKind(reached.Value, DateTimeKind.Utc))</span>
                                }
                                else if (reached.HasValue && i <= currentIdx)
                                {
                                    <span>@StatusUi.When(reached)</span>
                                }
                                else if (i < currentIdx)
                                {
                                    <span>skipped</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="st-cols">
                <div class="st-col">
                    <div class="card">
                        <div class="card-head">
                            <h3 class="card-title">Timeline</h3>
                            <span class="st-card-sub">newest first · local time</span>
                            <span class="st-card-spacer"></span>
                            <span class="tab-count">@(incidentUpdates?.Count ?? 0)</span>
                        </div>
                        @if (!resolved)
                        {
                            <AuthorizeView Roles="@writeRoles" Context="composeCtx">
                                <Authorized>
                                    <div class="st-compose">
                                        <label class="dl-sr-only" for="st-compose-msg">Update</label>
                                        <textarea class="textarea" id="st-compose-msg" rows="2" maxlength="2000"
                                                  placeholder="Post an update for the people following this incident…"
                                                  @bind="composeMessage" @bind:event="oninput"></textarea>
                                        <div class="st-compose-row">
                                            <label class="st-muted" style="font-size:12px" for="st-compose-status">Also move to</label>
                                            <select class="select" id="st-compose-status" @bind="composeStatus">
                                                <option value="">Keep @incident.Status</option>
                                                @foreach (var s in StatusUi.Flow.Where(s => s != incident.Status))
                                                {
                                                    <option value="@s">@s</option>
                                                }
                                            </select>
                                            <button class="btn btn-primary btn-sm" type="button" disabled="@(!CanPost || isPosting)" @onclick="PostUpdate">
                                                @(isPosting ? "Posting…" : ComposeTarget == IncidentStatus.Resolved ? "Resolve…" : "Post update")
                                            </button>
                                        </div>
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                        }
                        <ul class="st-tl">
                            @if (incident.ResolvedAt.HasValue)
                            {
                                <li>
                                    <span class="st-tl-ico is-status s-resolved">@StatusUi.Icon("check-circle", 13)</span>
                                    <div>
                                        <div class="st-tl-head"><b>Resolved</b> after @StatusUi.Duration(incident.Duration)<time>@StatusUi.When(incident.ResolvedAt)</time></div>
                                        @if (!string.IsNullOrWhiteSpace(incident.ResolutionDetails))
                                        {
                                            <div class="st-tl-msg is-resolution">@incident.ResolutionDetails</div>
                                        }
                                    </div>
                                </li>
                            }
                            @foreach (var u in (incidentUpdates ?? new()).OrderByDescending(u => u.PostedAt))
                            {
                                <li>
                                    @if (u.StatusChange.HasValue)
                                    {
                                        <span class="st-tl-ico is-status @StatusUi.Cls(u.StatusChange.Value)">@StatusUi.Icon("activity", 13)</span>
                                    }
                                    else
                                    {
                                        <span class="st-tl-ico">@StatusUi.Icon("message", 13)</span>
                                    }
                                    <div>
                                        <div class="st-tl-head">
                                            <b>@(string.IsNullOrWhiteSpace(u.Author) ? "System" : u.Author)</b>
                                            @if (u.StatusChange.HasValue)
                                            {
                                                <span>moved to</span><span class="badge @StatusUi.Cls(u.StatusChange.Value)"><i></i>@u.StatusChange</span>
                                            }
                                            <time title="@StatusUi.FullWhen(u.PostedAt)">@StatusUi.When(u.PostedAt)</time>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(u.Message) && u.Message != $"Status changed to {u.StatusChange}")
                                        {
                                            <div class="st-tl-msg">@u.Message</div>
                                        }
                                    </div>
                                </li>
                            }
                            <li>
                                <span class="st-tl-ico is-status s-open">@StatusUi.Icon("alert", 13)</span>
                                <div>
                                    <div class="st-tl-head">
                                        <b>@(string.IsNullOrWhiteSpace(incident.ReportedBy) ? "Someone" : incident.ReportedBy)</b>
                                        <span>opened the incident as</span><span class="badge @StatusUi.Cls(incident.Severity)"><i></i>@incident.Severity</span>
                                        <time title="@StatusUi.FullWhen(incident.StartedAt)">@StatusUi.When(incident.StartedAt)</time>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="st-col">
                    <div class="card">
                        <div class="card-head">
                            <h3 class="card-title">Details</h3>
                            <span class="st-card-spacer"></span>
                            <AuthorizeView Roles="@writeRoles" Context="editCtx">
                                <Authorized><a class="st-link" href="@($"status/incidents/{IncidentId}/edit{queryParam}")">Edit</a></Authorized>
                            </AuthorizeView>
                        </div>
                        <div class="card-body">
                            <dl class="st-dl">
                                <dt>Entity</dt>
                                <dd>
                                    @if (incident.Entity is not null)
                                    {
                                        <a href="@($"status/entities/{incident.EntityId}{queryParam}")">@incident.Entity.Name</a><span class="st-muted"> · @StatusUi.TypeLabel(incident.Entity.EntityType)</span>
                                    }
                                    else { <span class="st-muted">Unknown</span> }
                                </dd>
                                <dt>Severity</dt><dd><span class="badge @StatusUi.Cls(incident.Severity)"><i></i>@incident.Severity</span></dd>
                                <dt>Status</dt><dd><span class="badge @StatusUi.Cls(incident.Status)"><i></i>@incident.Status</span></dd>
                                <dt>Assigned to</dt>
                                <dd>
                                    @if (string.IsNullOrWhiteSpace(incident.AssignedTo)) { <span class="st-muted">Unassigned</span> }
                                    else { <span class="st-av is-sm" style="vertical-align:middle;margin-right:6px">@StatusUi.Initials(incident.AssignedTo)</span>@incident.AssignedTo }
                                </dd>
                                <dt>Reported by</dt><dd>@(string.IsNullOrWhiteSpace(incident.ReportedBy) ? "—" : incident.ReportedBy)</dd>
                                <dt>Started</dt><dd>@StatusUi.FullWhen(incident.StartedAt)</dd>
                                <dt>Resolved</dt><dd class="@(incident.ResolvedAt.HasValue ? "" : "st-muted")">@StatusUi.FullWhen(incident.ResolvedAt)</dd>
                                <dt>Duration</dt><dd><span class="st-mono">@StatusUi.Duration(incident.Duration)</span>@(resolved ? "" : " and counting")</dd>
                                @if (!string.IsNullOrWhiteSpace(incident.ExternalIncidentId)) { <dt>External ID</dt><dd><span class="st-mono">@incident.ExternalIncidentId</span></dd> }
                            </dl>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-head"><h3 class="card-title">Description</h3></div>
                        <div class="card-body st-prose">@incident.Description</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(incident.ImpactDescription))
                    {
                        <div class="card">
                            <div class="card-head"><h3 class="card-title">Impact</h3></div>
                            <div class="card-body st-prose">@incident.ImpactDescription</div>
                        </div>
                    }

                    @if (audience.Any())
                    {
                        <div class="card">
                            <div class="card-head"><h3 class="card-title">Following</h3><span class="st-card-sub">people on @(incident.Entity?.Name ?? "the entity")</span></div>
                            <div class="card-body">
                                <ul class="st-people">
                                    @foreach (var m in audience.OrderBy(a => a.AudienceType))
                                    {
                                        <li>
                                            <span class="st-av">@StatusUi.Initials(m.DisplayName ?? m.Email)</span>
                                            <div class="st-who"><b>@(m.DisplayName ?? m.Email)</b><small>@m.AudienceType</small></div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (showResolveModal)
            {
                <div class="fb-modal-backdrop" @onclick="() => showResolveModal = false">
                    <div class="fb-modal" role="dialog" aria-modal="true" aria-labelledby="st-resolve-title" @onclick:stopPropagation="true">
                        <div class="fb-modal-head">
                            <div class="fb-modal-title" id="st-resolve-title">Resolve incident</div>
                            <button type="button" class="st-modal-x" aria-label="Close" @onclick="() => showResolveModal = false">@StatusUi.Icon("x", 15)</button>
                        </div>
                        <div class="fb-modal-body">
                            <div class="field">
                                <label class="field-label" for="st-resolution">What fixed it <b>*</b></label>
                                <textarea class="textarea" id="st-resolution" rows="4" maxlength="2000" placeholder="Root cause and the fix, for whoever reads this later"
                                          @bind="resolutionDetails" @bind:event="oninput"></textarea>
                            </div>
                            <div class="st-callout is-success">@StatusUi.Icon("check-circle", 14)<div>The incident closes now, after <b>@StatusUi.Duration(incident.Duration)</b>. It stays in the history.</div></div>
                        </div>
                        <div class="fb-modal-foot">
                            <button type="button" class="btn btn-ghost" @onclick="() => showResolveModal = false">Cancel</button>
                            <button type="button" class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(resolutionDetails) || isPosting)" @onclick="HandleResolve">
                                @(isPosting ? "Resolving…" : "Resolve incident")
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <StatusToast @ref="toast" />
</div>

@code {
    [Parameter] public string IncidentId { get; set; } = string.Empty;

    private Incident? incident;
    private List<IncidentUpdate>? incidentUpdates;
    private List<EntityAudience> audience = new();
    private AssetStatus? entityStatus;
    private bool isLoading = true;

    private string composeMessage = "";
    private string composeStatus = "";
    private bool isPosting;
    private bool showResolveModal;
    private string resolutionDetails = "";

    private StatusToast toast = default!;

    private string CompanyId => StateContainer.Company?.Id ?? "";
    private string queryParam => StateContainer.Company is null ? "" : $"?c={StateContainer.Company.Id}";

    // Incident write actions require the company INCIDENTS role (ADMIN always allowed).
    private string writeRoles => $"{StateContainer.Company?.Id}_INCIDENTS,{StateContainer.Company?.Id}_ADMIN";

    private string ShortId => incident is null ? "" : incident.Id.Length > 8 ? incident.Id[..8] : incident.Id;

    private IncidentStatus? ComposeTarget => Enum.TryParse<IncidentStatus>(composeStatus, out var s) ? s : null;
    private bool CanPost => ComposeTarget.HasValue || !string.IsNullOrWhiteSpace(composeMessage);

    protected override async Task OnInitializedAsync()
    {
        await LoadIncident();
        await LoadIncidentUpdates();
        if (incident is not null)
        {
            var statusTask = HistoryService.GetLatestEntityStatusAsync(incident.EntityId, CompanyId);
            var audienceTask = AudienceService.GetAudienceAsync(CompanyId, incident.EntityId);
            try
            {
                await Task.WhenAll(statusTask, audienceTask);
                entityStatus = statusTask.Result?.Status;
                audience = audienceTask.Result;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading incident context: {ex.Message}");
            }
        }
    }

    private async Task LoadIncident()
    {
        try
        {
            incident = await IncidentService.GetIncidentAsync(IncidentId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading incident: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadIncidentUpdates()
    {
        try
        {
            incidentUpdates = await IncidentService.GetIncidentUpdatesAsync(IncidentId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading incident updates: {ex.Message}");
        }
    }

    /// <summary>When the incident first reached a step: Open is its start, later steps come from the timeline.</summary>
    private DateTime? StepTime(IncidentStatus s)
    {
        if (incident is null) return null;
        if (s == IncidentStatus.Open) return incident.StartedAt;
        if (s == IncidentStatus.Resolved && incident.ResolvedAt.HasValue) return incident.ResolvedAt;
        return incidentUpdates?.Where(u => u.StatusChange == s).OrderBy(u => u.PostedAt).Select(u => (DateTime?)u.PostedAt).FirstOrDefault();
    }

    private async Task PostUpdate()
    {
        if (incident is null || !CanPost) return;
        if (ComposeTarget == IncidentStatus.Resolved)
        {
            resolutionDetails = composeMessage;
            showResolveModal = true;
            return;
        }

        isPosting = true;
        try
        {
            if (ComposeTarget is IncidentStatus target)
            {
                incident.Status = target;
                if (!await IncidentService.UpdateIncidentAsync(incident))
                {
                    toast.Show("Could not change the status. Try again.", error: true);
                    await LoadIncident();
                    return;
                }
                var message = string.IsNullOrWhiteSpace(composeMessage) ? $"Status changed to {target}" : composeMessage.Trim();
                await IncidentService.AddIncidentUpdateAsync(IncidentId, new IncidentUpdate { IncidentId = IncidentId, Message = message, StatusChange = target });
                toast.Show($"Moved to {target}");
            }
            else
            {
                var added = await IncidentService.AddIncidentUpdateAsync(IncidentId, new IncidentUpdate { IncidentId = IncidentId, Message = composeMessage.Trim() });
                if (added is null) { toast.Show("Could not post the update. Try again.", error: true); return; }
                toast.Show("Update posted");
            }
            composeMessage = "";
            composeStatus = "";
            await LoadIncident();
            await LoadIncidentUpdates();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error posting update: {ex.Message}");
            toast.Show("Could not post the update. Try again.", error: true);
        }
        finally
        {
            isPosting = false;
        }
    }

    private void OpenResolve()
    {
        resolutionDetails = "";
        showResolveModal = true;
    }

    private async Task HandleResolve()
    {
        if (incident is null || string.IsNullOrWhiteSpace(resolutionDetails)) return;
        isPosting = true;
        try
        {
            incident.Status = IncidentStatus.Resolved;
            incident.ResolvedAt = DateTime.UtcNow;
            incident.ResolutionDetails = resolutionDetails.Trim();
            if (await IncidentService.UpdateIncidentAsync(incident))
            {
                showResolveModal = false;
                composeMessage = "";
                composeStatus = "";
                toast.Show("Incident resolved");
            }
            else
            {
                toast.Show("Could not resolve the incident. Try again.", error: true);
            }
            await LoadIncident();
            await LoadIncidentUpdates();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resolving incident: {ex.Message}");
            toast.Show("Could not resolve the incident. Try again.", error: true);
        }
        finally
        {
            isPosting = false;
        }
    }
}
