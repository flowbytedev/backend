@page "/status/entities/{AssetId}"
@using Application.Shared.Enums
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject NavigationManager Navigation
@inject MonitoredAssetClientService EntityService
@inject AssetStatusHistoryClientService HistoryService
@inject EntityAudienceClientService AudienceService
@inject IncidentClientService IncidentService
@inject StatusOverviewClientService OverviewService
@inject StateContainer StateContainer
@attribute [Authorize(Policy = PolicyNames.StatusRead)]

<PageTitle>@(entity?.Name ?? "Entity") · Status</PageTitle>

@* Styles: Application/wwwroot/status.css (.st-*). *@
<div class="sc">
    <div class="page-wrap st-wrap">
        @if (isLoading)
        {
            <div class="card"><div class="st-loading"><span class="spin"></span> Loading entity…</div></div>
        }
        else if (entity is null)
        {
            <div class="card">
                <div class="empty">
                    <div class="dl-empty-icon">@StatusUi.Icon("inbox", 20)</div>
                    <div class="empty-title">Entity not found</div>
                    <div class="empty-text">It may have been deleted, or it belongs to another company.</div>
                    <a class="btn btn-secondary btn-sm" href="@($"status/entities{queryParam}")">Back to entities</a>
                </div>
            </div>
        }
        else
        {
            var status = entity.IsActive ? currentStatus : AssetStatus.Unknown;
            var openIncidents = incidents.Where(i => i.Status != IncidentStatus.Resolved).OrderByDescending(i => i.Severity).ToList();

            <div class="st-head">
                <div class="st-head-left">
                    <a class="st-back" href="@($"status/entities{queryParam}")" title="Back to entities" aria-label="Back to entities">@StatusUi.Icon("arrow-left", 16)</a>
                    <div class="st-head-main">
                        <div class="st-crumbs">
                            <a href="@($"status/entities{queryParam}")">Entities</a>
                            @if (!string.IsNullOrWhiteSpace(entity.Group) && entity.Group != "Default")
                            {
                                @StatusUi.Icon("chev-right", 12)<span>@entity.Group</span>
                            }
                        </div>
                        <div class="st-title-row">
                            <span class="st-tile">@StatusUi.TypeSvg(entity.EntityType, 20)</span>
                            <h1 class="page-title">@entity.Name</h1>
                            <span class="badge badge-neutral">@StatusUi.TypeLabel(entity.EntityType)</span>
                            @if (entity.IsCritical) { <span class="badge badge-danger">Critical</span> }
                            @if (!entity.IsActive)
                            {
                                <span class="badge badge-neutral">Inactive · not monitored</span>
                            }
                            else
                            {
                                <span class="st-status is-lg @StatusUi.Cls(status)"><span class="st-dot @(StatusUi.IsUnhealthy(status) ? "is-live" : "")"></span> @StatusUi.Label(status)</span>
                            }
                        </div>
                        <div class="st-meta">
                            @if (!string.IsNullOrWhiteSpace(entity.Description)) { <span>@entity.Description</span> }
                            @if (!string.IsNullOrWhiteSpace(entity.Url))
                            {
                                <span class="st-meta-item">@StatusUi.Icon("link", 11)
                                    @if (IsHttpUrl(entity.Url))
                                    {
                                        <a class="st-mono" href="@entity.Url" target="_blank" rel="noopener noreferrer">@entity.Url</a>
                                    }
                                    else
                                    {
                                        <span class="st-mono">@entity.Url</span>
                                    }
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(entity.Owner)) { <span>Owner <b style="color:var(--text-secondary);font-weight:500">@entity.Owner</b></span> }
                            @if (!string.IsNullOrWhiteSpace(entity.Location)) { <span>@entity.Location</span> }
                        </div>
                    </div>
                </div>
                <div class="st-head-actions">
                    <AuthorizeView Roles="@writeRoles">
                        <Authorized>
                            <button class="btn btn-secondary" type="button" @onclick="OpenUpdateStatusModal">@StatusUi.Icon("activity", 14) Update status</button>
                            <a class="btn btn-secondary" href="@($"status/incidents/create{QueryWith("entity", entity.Id)}")">@StatusUi.Icon("alert", 14) Report incident</a>
                        </Authorized>
                    </AuthorizeView>
                    <a class="btn btn-secondary" href="@($"status/entities/{entity.Id}/dependencies{queryParam}")">@StatusUi.Icon("branch", 14) Dependencies</a>
                    <AuthorizeView Roles="@writeRoles">
                        <Authorized>
                            <a class="btn btn-primary" href="@($"status/entities/{entity.Id}/edit{queryParam}")">@StatusUi.Icon("edit", 14) Edit</a>
                            <button class="btn btn-ghost btn-icon" type="button" title="Delete entity" aria-label="Delete entity" @onclick="DeleteEntity">@StatusUi.Icon("trash", 15)</button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>

            @if (openIncidents.Any())
            {
                var top = openIncidents[0];
                <div class="st-callout @(top.Severity >= IncidentSeverity.High ? "is-danger" : "is-warning") st-page-callout">
                    @StatusUi.Icon("alert", 15)
                    <div>
                        <b>@(openIncidents.Count == 1 ? "Open incident:" : $"{openIncidents.Count} open incidents, most severe:")</b>
                        <a href="@($"status/incidents/{top.Id}{queryParam}")">@top.Title</a>
                        · @top.Severity · @top.Status · open for @StatusUi.Duration(top.Duration)@(string.IsNullOrWhiteSpace(top.AssignedTo) ? "" : $" · {top.AssignedTo}")
                    </div>
                </div>
            }

            var stats30 = UptimeFor(30);
            var stats90 = UptimeFor(90);
            var inc90 = incidents.Count(i => i.StartedAt >= DateTime.UtcNow.AddDays(-90));
            var resolvedDurations = incidents.Where(i => i.IsResolved && i.Duration.HasValue).Select(i => i.Duration!.Value.TotalMinutes).ToList();

            <div class="st-kpis">
                <div class="st-kpi @(stats30.pct is < 99 ? "is-danger" : stats30.pct is < 99.9 ? "is-warning" : "")">
                    <div class="st-kpi-label">Uptime, 30 days</div>
                    <div class="st-kpi-value">@(stats30.pct?.ToString("0.0") ?? "—")<small>@(stats30.pct.HasValue ? "%" : "")</small></div>
                    <div class="st-kpi-sub">@(stats30.withData == 0 ? "no data yet" : $"{stats30.online} of {stats30.withData} days fully online")</div>
                </div>
                <div class="st-kpi">
                    <div class="st-kpi-label">Uptime, 90 days</div>
                    <div class="st-kpi-value">@(stats90.pct?.ToString("0.0") ?? "—")<small>@(stats90.pct.HasValue ? "%" : "")</small></div>
                    <div class="st-kpi-sub">@(stats90.withData == 0 ? "no data yet" : $"{stats90.withData} days with checks")</div>
                </div>
                <div class="st-kpi @(StatusUi.IsUnhealthy(status) ? "is-warning" : "")">
                    <div class="st-kpi-label">Response, last check</div>
                    <div class="st-kpi-value">@(latest?.ResponseTime is double rt ? rt.ToString("#,0").Replace(",", " ") : "—")<small>@(latest?.ResponseTime.HasValue == true ? "ms" : "")</small></div>
                    <div class="st-kpi-sub">@(AvgResponse is double a ? $"avg {StatusUi.Ms(a)} over {historyDays}d" : "no response times recorded")</div>
                </div>
                <div class="st-kpi">
                    <div class="st-kpi-label">Last check</div>
                    <div class="st-kpi-value" style="font-size:18px">@StatusUi.Ago(latest?.CheckedAt)</div>
                    <div class="st-kpi-sub">@StatusUi.FullWhen(latest?.CheckedAt)</div>
                </div>
                <div class="st-kpi @(openIncidents.Any() ? "is-danger" : "")">
                    <div class="st-kpi-label">Incidents, 90 days</div>
                    <div class="st-kpi-value">@inc90</div>
                    <div class="st-kpi-sub">@openIncidents.Count open@(resolvedDurations.Any() ? $" · MTTR {StatusUi.Duration(TimeSpan.FromMinutes(resolvedDurations.Average()))}" : "")</div>
                </div>
            </div>

            <div class="st-cols">
                <div class="st-col">
                    <div class="card">
                        <div class="card-head">
                            <h3 class="card-title">Availability</h3>
                            <span class="st-card-sub">last @stripDays days</span>
                            <span class="st-card-spacer"></span>
                            <div class="dl-seg" role="group" aria-label="Range">
                                @foreach (var d in new[] { 30, 90 })
                                {
                                    var dd = d;
                                    <button type="button" class="dl-seg-btn @(stripDays == dd ? "is-active" : "")" @onclick="() => { stripDays = dd; CloseDay(); }">@(dd)d</button>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            @if (overviewEntity is null)
                            {
                                <div class="st-card-empty">No availability data yet. Days appear here once the ping job has checked this entity.</div>
                            }
                            else
                            {
                                var strip = StatusUi.LastDays(overviewEntity.Days, stripDays);
                                <AvailabilityStrip Days="@strip" Size="lg" Interactive="true" MarkToday="true" Name="@entity.Name"
                                                   SelectedDate="@openDate" OnDayClick="ToggleDay" />
                                <div class="st-strip-axis">
                                    <span>@strip.First().Date.ToString("d MMM")</span>
                                    <span>@strip[strip.Count / 2].Date.ToString("d MMM")</span>
                                    <span>Today</span>
                                </div>
                                @if (openDate.HasValue)
                                {
                                    <div class="st-day">
                                        <div class="st-day-head">
                                            <span>@openDate.Value.ToString("d MMMM yyyy") · @(dayLoading ? "loading…" : StatusUi.Plural(dayEvents.Count, "check"))</span>
                                            <button type="button" class="st-link" @onclick="CloseDay">Close</button>
                                        </div>
                                        @if (!dayLoading && !dayEvents.Any())
                                        {
                                            <div class="st-day-empty">No checks were recorded on this day.</div>
                                        }
                                        else if (!dayLoading)
                                        {
                                            <ul class="st-day-list">
                                                @foreach (var ev in dayEvents)
                                                {
                                                    <li>
                                                        <time>@StatusUi.Local(ev.CheckedAt).ToString("HH:mm")</time>
                                                        <span class="st-status @StatusUi.Cls(ev.Status)"><span class="st-dot"></span> @StatusUi.Label(ev.Status)</span>
                                                        <span class="st-day-ms">@(ev.ResponseTime.HasValue ? StatusUi.Ms(ev.ResponseTime) : "")</span>
                                                        <span class="st-day-msg" title="@ev.StatusMessage">@ev.StatusMessage</span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                }
                                <div class="st-legend" style="margin-top:14px">
                                    <span><i class="s-online"></i> Online</span><span><i class="s-degraded"></i> Degraded</span>
                                    <span><i class="s-offline"></i> Offline / error</span><span><i class="s-maintenance"></i> Maintenance</span>
                                    <span><i class="s-none"></i> No data</span>
                                    <span class="st-legend-note">Click a day to see its checks</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-head">
                            <h3 class="card-title">Response time</h3>
                            <span class="st-card-sub">last @(historyDays == 1 ? "24 hours" : $"{historyDays} days")</span>
                            <span class="st-card-spacer"></span>
                            <div class="dl-seg" role="group" aria-label="Range">
                                @foreach (var d in new[] { 1, 7, 30 })
                                {
                                    var dd = d;
                                    <button type="button" class="dl-seg-btn @(historyDays == dd ? "is-active" : "")" @onclick="() => SetHistoryDays(dd)">@(dd == 1 ? "24h" : $"{dd}d")</button>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            @if (historyLoading)
                            {
                                <div class="st-load"><span class="spin"></span> Loading checks…</div>
                            }
                            else
                            {
                                <ResponseTimeChart History="@history" />
                            }
                        </div>
                    </div>

                    <div class="card">
                        <div class="tabs" style="margin:0;padding:0 14px" role="tablist">
                            <button class="tab @(tab == "checks" ? "is-active" : "")" type="button" role="tab" @onclick='() => tab = "checks"'>Recent checks <span class="tab-count">@history.Count</span></button>
                            <button class="tab @(tab == "incidents" ? "is-active" : "")" type="button" role="tab" @onclick='() => tab = "incidents"'>Incidents <span class="tab-count">@incidents.Count</span></button>
                        </div>
                        @if (tab == "checks")
                        {
                            var rows = (changesOnly ? StatusChanges() : history.OrderByDescending(h => h.CheckedAt)).Take(checksShown).ToList();
                            <div class="card-body" style="padding:10px 14px;border-bottom:1px solid var(--border)">
                                <button type="button" class="switch-row" style="background:none;border:0;padding:0" @onclick="() => changesOnly = !changesOnly">
                                    <span class="switch @(changesOnly ? "is-on" : "")"></span><span class="switch-label">Status changes only</span>
                                </button>
                            </div>
                            @if (!rows.Any())
                            {
                                <div class="st-card-empty">No checks in the last @(historyDays == 1 ? "24 hours" : $"{historyDays} days").</div>
                            }
                            else
                            {
                                <div class="st-checks-wrap">
                                    <table class="st-checks">
                                        @foreach (var h in rows)
                                        {
                                            <tr>
                                                <td class="is-time">@(h.CheckedAt.HasValue ? StatusUi.Local(h.CheckedAt.Value).ToString(historyDays == 1 ? "HH:mm:ss" : "d MMM HH:mm") : "—")</td>
                                                <td><span class="st-status @StatusUi.Cls(h.Status)"><span class="st-dot"></span> @StatusUi.Label(h.Status)</span></td>
                                                <td class="is-msg" title="@h.StatusMessage">@(string.IsNullOrWhiteSpace(h.StatusMessage) ? "—" : h.StatusMessage)</td>
                                                <td class="is-ms">@(h.ResponseTime.HasValue ? StatusUi.Ms(h.ResponseTime) : "")</td>
                                            </tr>
                                        }
                                    </table>
                                </div>
                                <div class="dl-footer">
                                    <span class="dl-footer-text">Local time · <strong>@rows.Count</strong> of @(changesOnly ? StatusChanges().Count() : history.Count)</span>
                                    @if (rows.Count < (changesOnly ? StatusChanges().Count() : history.Count))
                                    {
                                        <button class="st-link" type="button" @onclick="() => checksShown += 25">Show more</button>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            @if (!incidents.Any())
                            {
                                <div class="st-card-empty">No incidents recorded for this entity.</div>
                            }
                            else
                            {
                                <ul class="st-inc">
                                    @foreach (var i in incidents.OrderByDescending(i => i.StartedAt).Take(20))
                                    {
                                        <li class="@(i.Status == IncidentStatus.Resolved ? "" : StatusUi.Cls(i.Severity))">
                                            <div class="st-inc-text">
                                                <a class="st-inc-title" href="@($"status/incidents/{i.Id}{queryParam}")">@i.Title</a>
                                                <div class="st-inc-meta">
                                                    <span class="badge @StatusUi.Cls(i.Status)"><i></i>@i.Status</span>
                                                    <span class="badge @StatusUi.Cls(i.Severity)"><i></i>@i.Severity</span>
                                                    <span>@StatusUi.When(i.StartedAt)</span>
                                                </div>
                                            </div>
                                            <span class="st-inc-dur">@StatusUi.Duration(i.Duration)@(i.IsResolved ? "" : " · ongoing")</span>
                                        </li>
                                    }
                                </ul>
                            }
                        }
                    </div>

                    @if (entity.EntityType == AssetType.Server)
                    {
                        <div class="st-legacy"><ServerManagement EntityId="@entity.Id" /></div>
                    }
                    @if (entity.EntityType == AssetType.Dataset
                         && !string.IsNullOrEmpty(entity.Url)
                         && entity.Url.Contains("powerbi.com", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="st-legacy"><PowerBiDataset EntityId="@entity.Id" EntityUrl="@entity.Url" /></div>
                    }
                    @if (entity.EntityType == AssetType.Database)
                    {
                        <div class="st-legacy"><DatabaseTables EntityId="@entity.Id" /></div>
                    }
                    @if (entity.EntityType == AssetType.Table)
                    {
                        <div class="st-legacy"><TableFreshness EntityId="@entity.Id" /></div>
                    }
                </div>

                <div class="st-col">
                    <DependencyImpact EntityId="@entity.Id" />

                    <div class="card">
                        <div class="card-head"><h3 class="card-title">Details</h3></div>
                        <div class="card-body">
                            <dl class="st-dl">
                                <dt>Type</dt><dd>@StatusUi.TypeLabel(entity.EntityType)</dd>
                                <dt>Group</dt><dd>@(string.IsNullOrWhiteSpace(entity.Group) ? "—" : entity.Group)</dd>
                                @if (!string.IsNullOrWhiteSpace(entity.Url)) { <dt>URL or host</dt><dd><span class="st-mono">@entity.Url</span></dd> }
                                @if (!string.IsNullOrWhiteSpace(entity.Version)) { <dt>Version</dt><dd>@entity.Version</dd> }
                                @if (!string.IsNullOrWhiteSpace(entity.Owner)) { <dt>Owner</dt><dd>@entity.Owner</dd> }
                                @if (!string.IsNullOrWhiteSpace(entity.Location)) { <dt>Location</dt><dd>@entity.Location</dd> }
                                <dt>Monitoring</dt><dd>@(entity.IsActive ? "Active" : "Inactive")@(entity.IsCritical ? " · critical" : "")</dd>
                                <dt>Created</dt><dd>@StatusUi.FullWhen(entity.CreatedOn)</dd>
                                <dt>Modified</dt><dd>@StatusUi.FullWhen(entity.ModifiedOn)</dd>
                                <dt>ID</dt><dd><span class="st-mono" style="color:var(--text-muted)">@entity.Id</span></dd>
                            </dl>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-head">
                            <h3 class="card-title">People</h3>
                            <span class="st-card-sub">notified about incidents</span>
                        </div>
                        <div class="card-body">
                            @if (!audience.Any())
                            {
                                <div class="st-muted" style="font-size:12.5px">Nobody is assigned yet. Owners and maintainers receive incident emails.</div>
                            }
                            else
                            {
                                <ul class="st-people">
                                    @foreach (var member in audience.OrderBy(a => a.AudienceType).ThenBy(a => a.DisplayName ?? a.Email))
                                    {
                                        var m = member;
                                        <li>
                                            <span class="st-av">@StatusUi.Initials(m.DisplayName ?? m.Email)</span>
                                            <div class="st-who"><b>@(m.DisplayName ?? m.Email)</b><small>@m.Email</small></div>
                                            <span class="badge @(m.AudienceType == EntityAudienceType.Owner ? "badge-accent" : "badge-neutral")">@m.AudienceType</span>
                                            <AuthorizeView Roles="@writeRoles" Context="rmCtx">
                                                <Authorized>
                                                    <button class="dl-act" style="opacity:1" type="button" title="Remove" aria-label="Remove @(m.DisplayName ?? m.Email)" @onclick="() => RemoveAudienceMember(m)">@StatusUi.Icon("x", 13)</button>
                                                </Authorized>
                                            </AuthorizeView>
                                        </li>
                                    }
                                </ul>
                            }
                            <AuthorizeView Roles="@writeRoles" Context="addCtx">
                                <Authorized>
                                    <div class="st-people-add">
                                        <select class="select" aria-label="Person" @bind="selectedAudienceUserId">
                                            <option value="">Add a person…</option>
                                            @foreach (var u in assignableUsers.Where(u => !string.IsNullOrEmpty(u.Id)).OrderBy(u => u.Email ?? u.UserName))
                                            {
                                                <option value="@u.Id">@(u.Email ?? u.UserName)</option>
                                            }
                                        </select>
                                        <select class="select" aria-label="Role" @bind="selectedAudienceType">
                                            <option value="@EntityAudienceType.Owner">Owner</option>
                                            <option value="@EntityAudienceType.Maintainer">Maintainer</option>
                                            <option value="@EntityAudienceType.Stakeholder">Stakeholder</option>
                                        </select>
                                        <button class="btn btn-secondary" type="button" disabled="@(string.IsNullOrEmpty(selectedAudienceUserId) || isSavingAudience)" @onclick="AddAudienceMember">
                                            @(isSavingAudience ? "Adding…" : "Add")
                                        </button>
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(entity.Metadata))
                    {
                        <div class="card">
                            <div class="card-head"><h3 class="card-title">Metadata</h3><span class="st-card-spacer"></span><span class="chip">json</span></div>
                            <div class="card-body"><pre class="code">@PrettyJson(entity.Metadata)</pre></div>
                        </div>
                    }
                </div>
            </div>

            @if (showStatusUpdateModal)
            {
                <div class="fb-modal-backdrop" @onclick="CloseStatusUpdateModal">
                    <div class="fb-modal" role="dialog" aria-modal="true" aria-labelledby="st-status-title" @onclick:stopPropagation="true">
                        <div class="fb-modal-head">
                            <div class="fb-modal-title" id="st-status-title">Update status of @entity.Name</div>
                            <button type="button" class="st-modal-x" aria-label="Close" @onclick="CloseStatusUpdateModal">@StatusUi.Icon("x", 15)</button>
                        </div>
                        <div class="fb-modal-body">
                            <div class="field">
                                <span class="field-label">Current</span>
                                <span class="st-status is-lg @StatusUi.Cls(currentStatus)"><span class="st-dot"></span> @StatusUi.Label(currentStatus)
                                    @if (latest?.CheckedAt is not null) { <span class="st-muted" style="font-weight:400">· since @StatusUi.When(latest.CheckedAt)</span> }
                                </span>
                            </div>
                            <div class="field">
                                <label class="field-label" for="st-new-status">New status <b>*</b></label>
                                <select class="select" id="st-new-status" @bind="newStatus">
                                    @foreach (var s in new[] { AssetStatus.Online, AssetStatus.Degraded, AssetStatus.Maintenance, AssetStatus.Offline, AssetStatus.Error, AssetStatus.Unknown })
                                    {
                                        <option value="@s">@StatusUi.Label(s)</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label class="field-label" for="st-status-msg">Message <b>*</b></label>
                                <textarea class="textarea" id="st-status-msg" rows="3" placeholder="What changed, and why" @bind="statusMessage" @bind:event="oninput"></textarea>
                                <span class="field-help">Recorded in the check history.</span>
                            </div>
                            @if (newStatus != AssetStatus.Online && currentStatus == AssetStatus.Online)
                            {
                                <div class="st-callout is-warning">@StatusUi.Icon("alert", 14)<div>Moving from Online to @StatusUi.Label(newStatus) <b>opens a new incident</b> for this entity.</div></div>
                            }
                            else if (newStatus == AssetStatus.Online && currentStatus != AssetStatus.Online)
                            {
                                <div class="st-callout is-success">@StatusUi.Icon("check-circle", 14)<div>Moving to Online <b>resolves this entity's open incidents</b>.</div></div>
                            }
                        </div>
                        <div class="fb-modal-foot">
                            <button type="button" class="btn btn-ghost" @onclick="CloseStatusUpdateModal">Cancel</button>
                            <button type="button" class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(statusMessage) || isUpdatingStatus)" @onclick="HandleStatusUpdate">
                                @(isUpdatingStatus ? "Updating…" : "Update status")
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <StatusConfirm @ref="confirm" />
    <StatusToast @ref="toast" />
</div>

@code {
    [Parameter] public string AssetId { get; set; } = string.Empty;

    private MonitoredAsset? entity;
    private bool isLoading = true;
    private AssetStatusHistory? latest;
    private AssetStatus currentStatus = AssetStatus.Unknown;

    private StatusOverviewEntity? overviewEntity;
    private int stripDays = 90;
    private DateTime? openDate;
    private List<StatusDayEventDto> dayEvents = new();
    private bool dayLoading;

    private List<AssetStatusHistory> history = new();
    private int historyDays = 1;
    private bool historyLoading;
    private string tab = "checks";
    private bool changesOnly;
    private int checksShown = 25;

    private List<Incident> incidents = new();

    private List<EntityAudience> audience = new();
    private List<EntityAudienceClientService.AssignableUser> assignableUsers = new();
    private string selectedAudienceUserId = "";
    private EntityAudienceType selectedAudienceType = EntityAudienceType.Stakeholder;
    private bool isSavingAudience;

    private bool showStatusUpdateModal;
    private bool isUpdatingStatus;
    private AssetStatus newStatus = AssetStatus.Online;
    private string statusMessage = "";

    private StatusConfirm confirm = default!;
    private StatusToast toast = default!;

    private string CompanyId => StateContainer.Company?.Id ?? "";
    private string queryParam => StateContainer.Company is null ? "" : $"?c={StateContainer.Company.Id}";
    private string QueryWith(string key, string value) =>
        (string.IsNullOrEmpty(queryParam) ? "?" : queryParam + "&") + $"{key}={Uri.EscapeDataString(value)}";

    // Status write actions require the company INCIDENTS role (ADMIN always allowed).
    private string writeRoles => $"{StateContainer.Company?.Id}_INCIDENTS,{StateContainer.Company?.Id}_ADMIN";

    private double? AvgResponse
    {
        get
        {
            var v = history.Where(h => h.ResponseTime.HasValue).Select(h => h.ResponseTime!.Value).ToList();
            return v.Any() ? v.Average() : null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(AssetId)) return;
        isLoading = true;
        openDate = null;
        await LoadEntity();
    }

    private async Task LoadEntity()
    {
        try
        {
            entity = await EntityService.GetEntityAsync(AssetId);
            if (entity is null) return;

            var latestTask = HistoryService.GetLatestEntityStatusAsync(AssetId, CompanyId);
            var overviewTask = OverviewService.GetOverviewAsync(CompanyId, 90);
            var incidentsTask = IncidentService.GetIncidentsByEntityAsync(AssetId);
            var audienceTask = AudienceService.GetAudienceAsync(CompanyId, AssetId);
            var usersTask = AudienceService.GetAssignableUsersAsync(CompanyId, AssetId);
            var historyTask = HistoryService.GetEntityStatusHistoryAsync(AssetId, CompanyId, historyDays);
            await Task.WhenAll(latestTask, overviewTask, incidentsTask, audienceTask, usersTask, historyTask);

            latest = latestTask.Result;
            currentStatus = latest?.Status ?? AssetStatus.Unknown;
            overviewEntity = overviewTask.Result?.Groups.SelectMany(g => g.Entities).FirstOrDefault(e => e.EntityId == AssetId);
            incidents = incidentsTask.Result;
            audience = audienceTask.Result;
            assignableUsers = usersTask.Result;
            history = historyTask.Result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading entity: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private (double? pct, int online, int withData) UptimeFor(int days)
    {
        var d = StatusUi.LastDays(overviewEntity?.Days, days);
        var withData = d.Count(x => x.Status.HasValue);
        var online = d.Count(x => x.Status == AssetStatus.Online);
        return (withData == 0 ? null : Math.Round(online * 100.0 / withData, 1), online, withData);
    }

    private IEnumerable<AssetStatusHistory> StatusChanges()
    {
        AssetStatus? prev = null;
        var changes = new List<AssetStatusHistory>();
        foreach (var h in history.OrderBy(h => h.CheckedAt))
        {
            if (h.Status != prev) changes.Add(h);
            prev = h.Status;
        }
        changes.Reverse();
        return changes;
    }

    private async Task SetHistoryDays(int d)
    {
        if (historyDays == d) return;
        historyDays = d;
        checksShown = 25;
        historyLoading = true;
        history = await HistoryService.GetEntityStatusHistoryAsync(AssetId, CompanyId, d);
        historyLoading = false;
    }

    private void CloseDay()
    {
        openDate = null;
        dayEvents = new();
    }

    private async Task ToggleDay(DateTime date)
    {
        if (openDate == date) { CloseDay(); return; }
        openDate = date;
        dayEvents = new();
        dayLoading = true;
        dayEvents = (await OverviewService.GetDayEventsAsync(CompanyId, AssetId, date)).OrderByDescending(e => e.CheckedAt).ToList();
        dayLoading = false;
    }

    private async Task DeleteEntity()
    {
        if (entity is null) return;
        if (!await confirm.Ask($"Delete {entity.Name}?", "It is removed from monitoring and the status board. Its history and incidents stay in the database.")) return;
        try
        {
            if (await EntityService.DeleteEntityAsync(entity.Id))
                Navigation.NavigateTo($"/status/entities{queryParam}");
            else
                toast.Show("Could not delete the entity. Try again.", error: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting entity: {ex.Message}");
            toast.Show("Could not delete the entity. Try again.", error: true);
        }
    }

    private void OpenUpdateStatusModal()
    {
        newStatus = currentStatus == AssetStatus.Online ? AssetStatus.Maintenance : AssetStatus.Online;
        statusMessage = "";
        showStatusUpdateModal = true;
    }

    private void CloseStatusUpdateModal() => showStatusUpdateModal = false;

    private async Task HandleStatusUpdate()
    {
        if (entity is null || string.IsNullOrWhiteSpace(statusMessage)) return;
        isUpdatingStatus = true;
        try
        {
            if (await EntityService.UpdateEntityStatusAsync(AssetId, newStatus, statusMessage))
            {
                showStatusUpdateModal = false;
                toast.Show($"Status set to {StatusUi.Label(newStatus)}");
                await LoadEntity();
            }
            else
            {
                toast.Show("Could not update the status. Try again.", error: true);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating entity status: {ex.Message}");
            toast.Show("Could not update the status. Try again.", error: true);
        }
        finally
        {
            isUpdatingStatus = false;
        }
    }

    private async Task AddAudienceMember()
    {
        if (string.IsNullOrEmpty(selectedAudienceUserId)) return;
        isSavingAudience = true;
        try
        {
            var created = await AudienceService.AddAsync(CompanyId, AssetId, selectedAudienceUserId, selectedAudienceType);
            if (created != null)
            {
                audience = await AudienceService.GetAudienceAsync(CompanyId, AssetId);
                selectedAudienceUserId = "";
                toast.Show($"Added {created.DisplayName ?? created.Email} as {created.AudienceType}");
            }
            else
            {
                toast.Show("Could not add this person. They may already have this role, or have no email address.", error: true);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding audience member: {ex.Message}");
            toast.Show("Could not add this person. Try again.", error: true);
        }
        finally
        {
            isSavingAudience = false;
        }
    }

    private async Task RemoveAudienceMember(EntityAudience member)
    {
        var name = member.DisplayName ?? member.Email;
        if (!await confirm.Ask($"Remove {name}?", "They stop receiving incident notifications for this entity.", "Remove")) return;
        try
        {
            if (await AudienceService.RemoveAsync(CompanyId, member.Id))
            {
                audience = await AudienceService.GetAudienceAsync(CompanyId, AssetId);
                toast.Show($"Removed {name}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing audience member: {ex.Message}");
        }
    }

    private static bool IsHttpUrl(string url) =>
        url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || url.StartsWith("https://", StringComparison.OrdinalIgnoreCase);

    private static string PrettyJson(string raw)
    {
        try
        {
            using var doc = JsonDocument.Parse(raw);
            return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch { return raw; }
    }
}
