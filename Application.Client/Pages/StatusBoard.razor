@page "/status/board"
@using Application.Shared.Enums
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject StatusOverviewClientService OverviewService
@inject StateContainer StateContainer
@attribute [Authorize]

<PageTitle>Status</PageTitle>

@* Read-only status page for every signed-in user. Styles: Application/wwwroot/status.css (.st-*). *@
<div class="sc">
    <div class="page-wrap st-wrap">
        <div class="st-head">
            <div class="page-header">
                <h1 class="page-title">Status</h1>
                <p class="page-subtitle">Availability of every monitored entity over the last @days days, grouped by type.</p>
            </div>
            <div class="st-head-actions">
                <div class="dl-search">
                    @StatusUi.Icon("search", 14)
                    <input class="input" type="search" placeholder="Filter entities…" aria-label="Filter entities"
                           @bind="filter" @bind:event="oninput" />
                </div>
                <div class="dl-seg" role="group" aria-label="Range">
                    @foreach (var d in new[] { 30, 90 })
                    {
                        var dd = d;
                        <button type="button" class="dl-seg-btn @(days == dd ? "is-active" : "")" @onclick="() => SetRange(dd)">@(dd)d</button>
                    }
                </div>
                <button class="btn btn-secondary" type="button" @onclick="Reload" disabled="@isLoading">
                    @StatusUi.Icon("refresh", 14) Reload
                </button>
            </div>
        </div>

        @if (isLoading && overview is null)
        {
            <div class="card"><div class="st-loading"><span class="spin"></span> Loading status…</div></div>
        }
        else if (overview is null || !overview.Groups.Any())
        {
            <div class="card">
                <div class="empty">
                    <div class="dl-empty-icon">@StatusUi.Icon("activity", 20)</div>
                    <div class="empty-title">Nothing is monitored yet</div>
                    <div class="empty-text">Entities added under Status → Entities appear here with their daily availability.</div>
                </div>
            </div>
        }
        else
        {
            var all = overview.Groups.SelectMany(g => g.Entities).ToList();
            var down = all.Where(e => StatusUi.IsDown(e.CurrentStatus)).ToList();
            var degraded = all.Where(e => e.CurrentStatus is AssetStatus.Degraded).ToList();
            var maint = all.Where(e => e.CurrentStatus is AssetStatus.Maintenance).ToList();
            var bannerCls = down.Any() ? "s-offline" : degraded.Any() ? "s-degraded" : maint.Any() ? "s-maintenance" : "s-online";

            <div class="st-banner @bannerCls">
                <span class="st-banner-dot"></span>
                <div class="st-banner-text">
                    <h2 class="st-banner-title">@BannerTitle(down.Count, degraded.Count, maint.Count)</h2>
                    <div class="st-banner-sub">@BannerDetail(down, degraded, maint)</div>
                </div>
                <div class="st-banner-right">
                    Updated<strong>@StatusUi.FullWhen(overview.GeneratedAtUtc)</strong>@StatusUi.Plural(all.Count, "entity", "entities") monitored
                </div>
            </div>

            <div class="st-legend" style="margin: 0 0 12px 2px">
                <span><i class="s-online"></i> Online</span>
                <span><i class="s-degraded"></i> Degraded</span>
                <span><i class="s-offline"></i> Offline / error</span>
                <span><i class="s-maintenance"></i> Maintenance</span>
                <span><i class="s-unknown"></i> Unknown</span>
                <span><i class="s-none"></i> No data</span>
                <span class="st-legend-note">Click a day to see its checks</span>
            </div>

            var groups = FilteredGroups().ToList();
            @if (!groups.Any())
            {
                <div class="card">
                    <div class="empty">
                        <div class="empty-title">No entities match “@filter”</div>
                        <button class="btn btn-ghost btn-sm" type="button" @onclick='() => filter = ""'>Clear filter</button>
                    </div>
                </div>
            }

            @foreach (var group in groups)
            {
                var g = group;
                var isOpen = HasFilter || !collapsed.Contains(g.EntityType);
                var shown = FilteredEntities(g).ToList();
                var bad = g.Entities.Where(e => StatusUi.NeedsAttention(e.CurrentStatus)).ToList();
                <div class="card st-group @(isOpen ? "is-open" : "")">
                    <button class="st-group-head" type="button" @onclick="() => Toggle(g.EntityType)" aria-expanded="@(isOpen ? "true" : "false")">
                        <span class="st-tile">@StatusUi.TypeSvg(g.EntityType, 18)</span>
                        <span class="st-group-name">@StatusUi.TypePlural(g.EntityType)</span>
                        <span class="st-group-count">@(HasFilter ? $"{shown.Count} / {g.EntityCount}" : g.EntityCount.ToString())</span>
                        <span class="st-status @StatusUi.Cls(g.WorstCurrentStatus)"><span class="st-dot"></span> @GroupSummary(g, bad)</span>
                        <span class="st-group-strip"><AvailabilityStrip Days="@StatusUi.WorstDays(g.Entities)" Size="sm" Name="@StatusUi.TypePlural(g.EntityType)" /></span>
                        <span class="st-group-chev">@StatusUi.Icon("chev-down", 16)</span>
                    </button>
                    @if (isOpen)
                    {
                        <div>
                            @foreach (var entity in shown)
                            {
                                var e = entity;
                                var hasData = StatusUi.HasData(e);
                                <div class="st-row">
                                    <div class="st-row-head">
                                        <span class="st-status @StatusUi.Cls(e.CurrentStatus)" title="@StatusUi.Label(e.CurrentStatus)"><span class="st-dot @(StatusUi.IsUnhealthy(e.CurrentStatus) ? "is-live" : "")"></span></span>
                                        <span class="st-row-name">@e.Name</span>
                                        <span class="st-muted" style="font-size:12px">@StatusUi.Label(e.CurrentStatus)</span>
                                        <span class="st-spacer"></span>
                                        <span class="st-uptime @(hasData ? StatusUi.UptimeCls(e.UptimePercent) : "")">@(hasData ? $"{e.UptimePercent:0.0}% uptime" : "No data")</span>
                                    </div>
                                    <AvailabilityStrip Days="@e.Days" Interactive="true" MarkToday="true" Name="@e.Name"
                                                       SelectedDate="@(openEntityId == e.EntityId ? openDate : null)"
                                                       OnDayClick="@(d => ToggleDay(e.EntityId, d))" />
                                    @if (openEntityId == e.EntityId && openDate.HasValue)
                                    {
                                        <div class="st-day">
                                            <div class="st-day-head">
                                                <span>@openDate.Value.ToString("d MMMM yyyy") · @(dayLoading ? "loading…" : StatusUi.Plural(dayEvents.Count, "check"))</span>
                                                <button type="button" class="st-link" @onclick="CloseDay">Close</button>
                                            </div>
                                            @if (dayLoading)
                                            {
                                                <div class="st-day-empty">Loading checks…</div>
                                            }
                                            else if (!dayEvents.Any())
                                            {
                                                <div class="st-day-empty">No checks were recorded on this day.</div>
                                            }
                                            else
                                            {
                                                <ul class="st-day-list">
                                                    @foreach (var ev in dayEvents)
                                                    {
                                                        <li>
                                                            <time>@StatusUi.Local(ev.CheckedAt).ToString("HH:mm")</time>
                                                            <span class="st-status @StatusUi.Cls(ev.Status)"><span class="st-dot"></span> @StatusUi.Label(ev.Status)</span>
                                                            <span class="st-day-ms">@(ev.ResponseTime.HasValue ? StatusUi.Ms(ev.ResponseTime) : "")</span>
                                                            <span class="st-day-msg" title="@ev.StatusMessage">@ev.StatusMessage</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    private StatusOverviewDto? overview;
    private bool isLoading = true;
    private int days = 90;

    private readonly HashSet<AssetType> collapsed = new();
    private bool collapseApplied;
    private string filter = "";
    private bool HasFilter => !string.IsNullOrWhiteSpace(filter);

    private string? openEntityId;
    private DateTime? openDate;
    private List<StatusDayEventDto> dayEvents = new();
    private bool dayLoading;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        var companyId = StateContainer.Company?.Id;
        if (string.IsNullOrEmpty(companyId)) { isLoading = false; return; }

        isLoading = true;
        overview = await OverviewService.GetOverviewAsync(companyId, days);
        isLoading = false;

        // Healthy groups start collapsed when there are several, so the problems are what you see first.
        if (overview is not null && !collapseApplied)
        {
            collapseApplied = true;
            if (overview.Groups.Count > 3)
                foreach (var g in overview.Groups.Where(g => !g.Entities.Any(e => StatusUi.NeedsAttention(e.CurrentStatus))))
                    collapsed.Add(g.EntityType);
        }
    }

    private async Task Reload()
    {
        CloseDay();
        await Load();
    }

    private async Task SetRange(int d)
    {
        if (days == d) return;
        days = d;
        await Reload();
    }

    private void Toggle(AssetType type)
    {
        if (!collapsed.Remove(type)) collapsed.Add(type);
    }

    private IEnumerable<StatusOverviewTypeGroup> FilteredGroups() =>
        HasFilter ? overview!.Groups.Where(g => FilteredEntities(g).Any()) : overview!.Groups;

    private IEnumerable<StatusOverviewEntity> FilteredEntities(StatusOverviewTypeGroup group)
    {
        var ordered = group.Entities.OrderByDescending(e => StatusUi.Rank(e.CurrentStatus) >= 3).ThenBy(e => e.Name);
        if (!HasFilter) return ordered;
        var f = filter.Trim();
        return ordered.Where(e => e.Name.Contains(f, StringComparison.OrdinalIgnoreCase));
    }

    private void CloseDay()
    {
        openEntityId = null;
        openDate = null;
        dayEvents = new();
    }

    private async Task ToggleDay(string entityId, DateTime date)
    {
        if (openEntityId == entityId && openDate == date) { CloseDay(); return; }

        openEntityId = entityId;
        openDate = date;
        dayEvents = new();
        dayLoading = true;

        var companyId = StateContainer.Company?.Id;
        if (!string.IsNullOrEmpty(companyId))
            dayEvents = (await OverviewService.GetDayEventsAsync(companyId, entityId, date)).OrderByDescending(e => e.CheckedAt).ToList();

        dayLoading = false;
    }

    private static string GroupSummary(StatusOverviewTypeGroup g, List<StatusOverviewEntity> bad)
    {
        if (!bad.Any()) return g.Entities.All(e => e.CurrentStatus == AssetStatus.Online) ? "All online" : "No problems";
        var worst = g.WorstCurrentStatus;
        var n = bad.Count(e => StatusUi.Rank(e.CurrentStatus) == StatusUi.Rank(worst));
        return $"{n} {StatusUi.Label(worst).ToLowerInvariant()}";
    }

    private static string BannerTitle(int down, int degraded, int maint)
    {
        if (down == 0 && degraded == 0 && maint == 0) return "All systems operational";
        var parts = new List<string>();
        if (down > 0) parts.Add($"{down} {(down == 1 ? "component" : "components")} down");
        if (degraded > 0) parts.Add($"{degraded} degraded");
        if (maint > 0) parts.Add($"{maint} in maintenance");
        var s = string.Join(", ", parts);
        return char.ToUpperInvariant(s[0]) + s[1..];
    }

    private static string BannerDetail(List<StatusOverviewEntity> down, List<StatusOverviewEntity> degraded, List<StatusOverviewEntity> maint)
    {
        static string Names(List<StatusOverviewEntity> l) => string.Join(", ", l.Take(3).Select(e => e.Name)) + (l.Count > 3 ? $" +{l.Count - 3} more" : "");
        var parts = new List<string>();
        if (down.Any()) parts.Add($"{Names(down)} {(down.Count == 1 ? "is" : "are")} down");
        if (degraded.Any()) parts.Add($"{Names(degraded)} {(degraded.Count == 1 ? "is" : "are")} degraded");
        if (maint.Any()) parts.Add($"{Names(maint)} in maintenance");
        return parts.Any() ? string.Join(" · ", parts) : "Every monitored entity reported online on its latest check.";
    }
}
