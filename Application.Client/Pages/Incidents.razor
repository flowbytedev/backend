@page "/status/incidents"
@using Application.Shared.Enums
@using System.Threading
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject IncidentClientService IncidentService
@inject NavigationManager Navigation
@inject StateContainer StateContainer
@attribute [Authorize(Policy = PolicyNames.StatusRead)]

<PageTitle>Status Incidents</PageTitle>

@* List recipe from datalist.css (.dl-*), status pieces from status.css (.st-*). *@
<div class="sc">
    <div class="page-wrap dl-wrap">
        <div class="dl-head">
            <div class="page-header">
                <h1 class="page-title">Incidents</h1>
                <p class="page-subtitle">
                    @if (activeCount is null)
                    {
                        <span class="skeleton st-skel-line" style="display:inline-block;width:160px;vertical-align:middle"></span>
                    }
                    else if (activeCount == 0)
                    {
                        <span>No active incidents</span>
                    }
                    else
                    {
                        <span>@activeCount active</span>
                        @if (criticalCount > 0) { <span class="dl-sep">·</span><span>@criticalCount critical</span> }
                        @if (oldestActive is not null) { <span class="dl-sep">·</span><span>oldest open for @StatusUi.Duration(oldestActive.Duration)</span> }
                    }
                </p>
            </div>
            <AuthorizeView Roles="@writeRoles">
                <Authorized>
                    <div class="dl-head-actions">
                        <button class="btn btn-primary" type="button" @onclick="CreateIncident">@StatusUi.Icon("plus", 16) Report incident</button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="card dl-card">
            <div class="dl-toolbar">
                <div class="dl-search">
                    @StatusUi.Icon("search", 14)
                    <input class="input" type="search" placeholder="Search title, description, entity…" aria-label="Search incidents"
                           value="@searchText" @oninput="OnSearchInput" />
                </div>
                <div class="dl-seg" role="group" aria-label="Filter by state">
                    <button type="button" class="dl-seg-btn @(scope == "active" ? "is-active" : "")" @onclick='() => SetScope("active")'>
                        Active @if (activeCount is not null) { <span class="dl-seg-count">@activeCount</span> }
                    </button>
                    <button type="button" class="dl-seg-btn @(scope == "resolved" ? "is-active" : "")" @onclick='() => SetScope("resolved")'>Resolved</button>
                    <button type="button" class="dl-seg-btn @(scope == "all" ? "is-active" : "")" @onclick='() => SetScope("all")'>All</button>
                </div>
                <select class="select" aria-label="Severity" @bind="severityFilter" @bind:after="ApplyFilters">
                    <option value="">All severities</option>
                    @foreach (var s in Enum.GetValues<IncidentSeverity>().Reverse())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
                @if (scope != "resolved")
                {
                    <select class="select" aria-label="Status" @bind="statusFilter" @bind:after="ApplyFilters">
                        <option value="">All statuses</option>
                        @foreach (var s in Enum.GetValues<IncidentStatus>().Where(s => scope != "active" || s != IncidentStatus.Resolved))
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                }
                <select class="select" aria-label="Entity type" @bind="entityTypeFilter" @bind:after="ApplyFilters">
                    <option value="">All entity types</option>
                    @foreach (var t in Enum.GetValues<AssetType>())
                    {
                        <option value="@t">@StatusUi.TypeLabel(t)</option>
                    }
                </select>
                <div class="dl-toolbar-spacer"></div>
                @if (HasActiveFilters)
                {
                    <button type="button" class="dl-seg-btn" @onclick="ClearFilters">@StatusUi.Icon("x", 13) Clear</button>
                }
            </div>

            <div class="dl-table-wrap">
                <table class="dl-table" aria-busy="@(isLoading ? "true" : "false")">
                    <colgroup>
                        <col /><col style="width:112px" /><col style="width:140px" /><col style="width:200px" />
                        <col style="width:150px" /><col style="width:140px" /><col style="width:112px" /><col style="width:80px" />
                    </colgroup>
                    <thead>
                        <tr>
                            @SortHeader("Incident", "title")
                            @SortHeader("Severity", "severity")
                            @SortHeader("Status", "status")
                            @SortHeader("Entity", "entity")
                            <th class="dl-th">Assigned</th>
                            @SortHeader("Started", "started")
                            <th class="dl-th dl-th-num">Duration</th>
                            <th class="dl-th dl-th-actions"><span class="dl-sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading && !pageData.Items.Any())
                        {
                            @for (var i = 0; i < 6; i++)
                            {
                                <tr class="dl-row dl-row-skel">
                                    <td class="dl-td"><div class="skeleton dl-skel" style="width:60%"></div><div class="skeleton dl-skel" style="width:85%;margin-top:6px;height:10px"></div></td>
                                    @for (var c = 0; c < 6; c++) { <td class="dl-td"><div class="skeleton dl-skel" style="width:70%"></div></td> }
                                    <td class="dl-td"></td>
                                </tr>
                            }
                        }
                        else if (!pageData.Items.Any())
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="empty">
                                        <div class="dl-empty-icon" style="@(HasActiveFilters || scope != "active" ? "" : "color:var(--success)")">@StatusUi.Icon(HasActiveFilters || scope != "active" ? "inbox" : "check-circle", 20)</div>
                                        <div class="empty-title">@(HasActiveFilters ? "No incidents match these filters" : scope == "active" ? "All clear" : "No incidents yet")</div>
                                        <div class="empty-text">@(HasActiveFilters ? "Try a different search or clear the filters." : scope == "active" ? "Nothing is open right now." : "Incidents reported by people or opened by the ping job appear here.")</div>
                                        @if (HasActiveFilters)
                                        {
                                            <button class="btn btn-secondary btn-sm" type="button" @onclick="ClearFilters">Clear filters</button>
                                        }
                                        else if (scope == "active")
                                        {
                                            <button class="btn btn-secondary btn-sm" type="button" @onclick='() => SetScope("all")'>Show all incidents</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var incident in pageData.Items)
                            {
                                var i = incident;
                                <tr class="dl-row @StatusUi.RowCls(i)" tabindex="0" @onclick="() => ViewIncident(i.Id)" @onkeydown="@(k => OnRowKey(k, i.Id))">
                                    <td class="dl-td">
                                        <div class="dl-cell-main" style="font-weight:600">@i.Title</div>
                                        <div class="dl-cell-sub" title="@i.Description">@i.Description</div>
                                    </td>
                                    <td class="dl-td"><span class="badge @StatusUi.Cls(i.Severity)"><i></i>@i.Severity</span></td>
                                    <td class="dl-td"><span class="badge @StatusUi.Cls(i.Status)"><i></i>@i.Status</span></td>
                                    <td class="dl-td">
                                        @if (i.Entity is not null)
                                        {
                                            <div class="dl-ident" style="gap:8px">
                                                <span class="st-tile-sm">@StatusUi.TypeSvg(i.Entity.EntityType, 12)</span>
                                                <div class="dl-ident-text">
                                                    <div class="dl-cell-main">@i.Entity.Name</div>
                                                    <div class="dl-cell-sub">@StatusUi.TypeLabel(i.Entity.EntityType)@(string.IsNullOrWhiteSpace(i.Entity.Group) || i.Entity.Group == "Default" ? "" : $" · {i.Entity.Group}")</div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="dl-na">Unknown entity</span>
                                        }
                                    </td>
                                    <td class="dl-td">
                                        @if (string.IsNullOrWhiteSpace(i.AssignedTo))
                                        {
                                            <span class="dl-na">Unassigned</span>
                                        }
                                        else
                                        {
                                            <div class="dl-ident" style="gap:8px"><span class="st-av is-sm">@StatusUi.Initials(i.AssignedTo)</span><span class="dl-cell-main">@i.AssignedTo</span></div>
                                        }
                                    </td>
                                    <td class="dl-td dl-td-date">
                                        @StatusUi.When(i.StartedAt)
                                        @if (!string.IsNullOrWhiteSpace(i.ReportedBy)) { <div class="dl-cell-sub">by @i.ReportedBy</div> }
                                    </td>
                                    <td class="dl-td dl-td-num">
                                        <span class="st-mono">@StatusUi.Duration(i.Duration)</span>
                                        <div class="dl-cell-sub">@(i.IsResolved ? $"resolved {StatusUi.When(i.ResolvedAt)}" : "ongoing")</div>
                                    </td>
                                    <td class="dl-td dl-td-actions" @onclick:stopPropagation="true">
                                        <AuthorizeView Roles="@writeRoles" Context="writeCtx">
                                            <Authorized>
                                                <div class="dl-actions">
                                                    <button class="dl-act" type="button" title="Edit" aria-label="Edit @i.Title" @onclick="() => EditIncident(i.Id)">@StatusUi.Icon("edit", 14)</button>
                                                </div>
                                            </Authorized>
                                        </AuthorizeView>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="dl-footer">
                <div class="dl-footer-text">
                    @if (pageData.TotalCount == 0)
                    {
                        <span>No results</span>
                    }
                    else
                    {
                        <span>Showing <strong>@FromRow–@ToRow</strong> of <strong>@pageData.TotalCount</strong></span>
                    }
                    <span class="dl-sep">·</span>
                    <select class="select" aria-label="Rows per page" @bind="pageSize" @bind:after="OnPageSizeChanged">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span> per page</span>
                </div>
                @if (pageData.TotalPages > 1)
                {
                    <div class="dl-pager">
                        <button class="dl-page-btn" type="button" disabled="@(!pageData.HasPrevious)" @onclick="() => GoToPage(pageData.Page - 1)">Prev</button>
                        @if (PageNumbers().First() > 1)
                        {
                            <button class="dl-page-btn" type="button" @onclick="() => GoToPage(1)">1</button>
                            <span class="dl-page-gap">…</span>
                        }
                        @foreach (var n in PageNumbers())
                        {
                            var p = n;
                            <button class="dl-page-btn @(p == pageData.Page ? "is-active" : "")" type="button" @onclick="() => GoToPage(p)">@p</button>
                        }
                        @if (PageNumbers().Last() < pageData.TotalPages)
                        {
                            <span class="dl-page-gap">…</span>
                            <button class="dl-page-btn" type="button" @onclick="() => GoToPage(pageData.TotalPages)">@pageData.TotalPages</button>
                        }
                        <button class="dl-page-btn" type="button" disabled="@(!pageData.HasNext)" @onclick="() => GoToPage(pageData.Page + 1)">Next</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private PagedResult<Incident> pageData = new();
    private bool isLoading = true;
    private int? activeCount;
    private int criticalCount;
    private Incident? oldestActive;

    private readonly IncidentQueryParameters query = new() { Page = 1, PageSize = 10, SortBy = "started", SortDir = "desc" };

    private string searchText = "";
    private string scope = "active";
    private string severityFilter = "";
    private string statusFilter = "";
    private string entityTypeFilter = "";
    private int pageSize = 10;
    private CancellationTokenSource? searchCts;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchText) || !string.IsNullOrEmpty(severityFilter) ||
        !string.IsNullOrEmpty(statusFilter) || !string.IsNullOrEmpty(entityTypeFilter);

    private int FromRow => pageData.TotalCount == 0 ? 0 : (pageData.Page - 1) * pageData.PageSize + 1;
    private int ToRow => Math.Min(pageData.Page * pageData.PageSize, pageData.TotalCount);

    private string queryParam => StateContainer.Company is null ? "" : $"?c={StateContainer.Company.Id}";

    // Incident write actions require the company INCIDENTS role (ADMIN always allowed).
    private string writeRoles => $"{StateContainer.Company?.Id}_INCIDENTS,{StateContainer.Company?.Id}_ADMIN";

    protected override async Task OnInitializedAsync()
    {
        var companyId = StateContainer.Company?.Id;
        if (string.IsNullOrEmpty(companyId)) { isLoading = false; return; }

        var pageTask = LoadPage();
        var active = await IncidentService.GetActiveIncidentsAsync(companyId);
        activeCount = active.Count;
        criticalCount = active.Count(i => i.Severity == IncidentSeverity.Critical);
        oldestActive = active.OrderBy(i => i.StartedAt).FirstOrDefault();
        await pageTask;
    }

    private async Task LoadPage()
    {
        var companyId = StateContainer.Company?.Id;
        if (string.IsNullOrEmpty(companyId)) { isLoading = false; return; }

        isLoading = true;
        StateHasChanged();

        query.Search = string.IsNullOrWhiteSpace(searchText) ? null : searchText;
        query.Severity = Enum.TryParse<IncidentSeverity>(severityFilter, out var sev) ? sev : null;
        query.EntityType = Enum.TryParse<AssetType>(entityTypeFilter, out var et) ? et : null;
        query.ActiveOnly = scope == "active";
        query.Status = scope == "resolved"
            ? IncidentStatus.Resolved
            : Enum.TryParse<IncidentStatus>(statusFilter, out var st) ? st : null;

        pageData = await IncidentService.GetIncidentsPagedAsync(companyId, query);
        isLoading = false;
        StateHasChanged();
    }

    private async Task ApplyFilters()
    {
        query.Page = 1;
        await LoadPage();
    }

    private async Task SetScope(string s)
    {
        scope = s;
        if (s == "resolved" || (s == "active" && statusFilter == nameof(IncidentStatus.Resolved))) statusFilter = "";
        await ApplyFilters();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;
        try
        {
            await Task.Delay(350, token);
            if (!token.IsCancellationRequested) await ApplyFilters();
        }
        catch (TaskCanceledException) { /* superseded by a newer keystroke */ }
    }

    private async Task ClearFilters()
    {
        searchText = ""; severityFilter = ""; statusFilter = ""; entityTypeFilter = "";
        query.SortBy = "started"; query.SortDir = "desc";
        await ApplyFilters();
    }

    private async Task SortByColumn(string column)
    {
        if (query.SortBy == column) query.SortDir = query.SortDir == "asc" ? "desc" : "asc";
        else { query.SortBy = column; query.SortDir = column is "started" or "severity" ? "desc" : "asc"; }
        query.Page = 1;
        await LoadPage();
    }

    private async Task GoToPage(int p)
    {
        if (p < 1 || p > pageData.TotalPages || p == pageData.Page) return;
        query.Page = p;
        await LoadPage();
    }

    private async Task OnPageSizeChanged()
    {
        query.PageSize = pageSize;
        query.Page = 1;
        await LoadPage();
    }

    private IEnumerable<int> PageNumbers()
    {
        const int window = 2;
        var start = Math.Max(1, pageData.Page - window);
        var end = Math.Min(pageData.TotalPages, pageData.Page + window);
        for (var i = start; i <= end; i++) yield return i;
    }

    private RenderFragment SortHeader(string label, string column) => __builder =>
    {
        var active = query.SortBy == column;
        var dir = active ? (query.SortDir == "asc" ? "ascending" : "descending") : "none";
        <th class="dl-th dl-th-sort @(active ? "is-active" : "")" aria-sort="@dir" @onclick="() => SortByColumn(column)">
            <span class="dl-th-inner">@label <span class="dl-sort-ico">@StatusUi.Icon(active ? (query.SortDir == "asc" ? "sort-asc" : "sort-desc") : "sort", 12)</span></span>
        </th>
    };

    private void OnRowKey(KeyboardEventArgs k, string id)
    {
        if (k.Key == "Enter") ViewIncident(id);
    }

    private void CreateIncident() => Navigation.NavigateTo($"/status/incidents/create{queryParam}");
    private void ViewIncident(string id) => Navigation.NavigateTo($"/status/incidents/{id}{queryParam}");
    private void EditIncident(string id) => Navigation.NavigateTo($"/status/incidents/{id}/edit{queryParam}");
}
